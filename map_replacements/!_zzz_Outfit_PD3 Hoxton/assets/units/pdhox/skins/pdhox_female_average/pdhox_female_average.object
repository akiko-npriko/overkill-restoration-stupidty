<?xml version="1.0" ?>
<dynamic_object>
	<diesel materials="units/pdhox/skins/pdhox_male_average/pdhox_male_average" orientation_object="root_point"/>
	<bodies>
		<body name="Hips_Col" enabled="true" template="dynamic" collision_class="hair" collision_group="7" collides_with="5" collides_with_mover="false" friction="0.15" keyframed="true" collision_script_quiet_time="0.5" collision_script_tag="small" ray="ignore" lin_damping="0" ang_damping="1" restitution="0">
			<object name="Hips_Coat"/>
			<object name="Hips_Col" collision_type="box"  mass="22" padding="-1"/>
		</body>
		
		
		
		<body name="RightUpLeg_Col" enabled="true" template="dynamic" collision_class="hair" collision_group="7" collides_with="5" collides_with_mover="false" friction="0.15" keyframed="true" collision_script_quiet_time="0.5" collision_script_tag="small" ray="ignore" lin_damping="0" ang_damping="1" restitution="0">
			<object name="RightUpLeg"/>
			<object name="c_capsule_RightUpLeg" collision_type="capsule"  mass="22" padding="-2.5"/>
		</body>
		<body name="LeftUpLeg_Col" enabled="true" template="dynamic" collision_class="hair" collision_group="7" collides_with="5" collides_with_mover="false" friction="0.15" keyframed="true" collision_script_quiet_time="0.5" collision_script_tag="small" ray="ignore" lin_damping="0" ang_damping="1" restitution="0">
			<object name="LeftUpLeg"/>
			<object name="c_capsule_LeftUpLeg" collision_type="capsule"  mass="22" padding="-2.5"/>
		</body>
		
		
		<body name="RightLeg_Col" enabled="true" template="dynamic" collision_class="hair" collision_group="7" collides_with="5" collides_with_mover="false" friction="0.15" keyframed="true" collision_script_quiet_time="0.5" collision_script_tag="small" ray="ignore" lin_damping="0" ang_damping="1" restitution="0">
			<object name="RightLeg"/>
			<object name="c_capsule_RightLeg" collision_type="capsule"  mass="22" padding="4"/>
		</body>
		<body name="LeftLeg_Col" enabled="true" template="dynamic" collision_class="hair" collision_group="7" collides_with="5" collides_with_mover="false" friction="0.15" keyframed="true" collision_script_quiet_time="0.5" collision_script_tag="small" ray="ignore" lin_damping="0" ang_damping="1" restitution="0">
			<object name="LeftLeg"/>
			<object name="c_capsule_LeftLeg" collision_type="capsule" mass="22" padding="4"/>
		</body>
		
		
		
		
		
		
		
		
		<body name="Phys_R_01" enabled="true" template="dynamic" collision_class="hair" collision_group="5" collides_with="7" collides_with_mover="false" friction="0.15" keyframed="false" collision_script_quiet_time="0.5" collision_script_tag="small" ray="ignore" lin_damping="7" ang_damping="15" restitution="0">
			<object name="Right_Coat_Phys_01"/>
			<object name="Right_Coat_Phys_01_Col" collision_type="box" mass="1" padding="-3.5"/>
		</body>
		<body name="Phys_R_02" enabled="true" template="dynamic" collision_class="hair" collision_group="5" collides_with="7" collides_with_mover="false" friction="0.15" keyframed="false" collision_script_quiet_time="0.5" collision_script_tag="small" ray="ignore" lin_damping="0.6" ang_damping="20" restitution="0">
			<object name="Right_Coat_Phys_02"/>
			<object name="Right_Coat_Phys_02_Col" collision_type="box" mass="-30" padding="-2"/>
		</body>
		
		
		<body name="Phys_L_01" enabled="true" template="dynamic" collision_class="hair" collision_group="5" collides_with="7" collides_with_mover="false" friction="0.15" keyframed="false" collision_script_quiet_time="0.5" collision_script_tag="small" ray="ignore" lin_damping="0.6" ang_damping="20" restitution="0">
			<object name="Left_Coat_Phys_01"/>
			<object name="Left_Coat_Phys_01_Col" collision_type="box" mass="1" padding="-3.5"/>
		</body>
		
		<body name="Phys_L_02" enabled="true" template="dynamic" collision_class="hair" collision_group="5" collides_with="7" collides_with_mover="false" friction="0.15" keyframed="false" collision_script_quiet_time="0.5" collision_script_tag="small" ray="ignore" lin_damping="0.6" ang_damping="20" restitution="0">
			<object name="Left_Coat_Phys_02"/>
			<object name="Left_Coat_Phys_02_Col" collision_type="box" mass="-30" padding="-2"/>
		</body>
		
		
		<body name="Phys_B_01" enabled="true" template="dynamic" collision_class="hair" collision_group="5" collides_with="7" collides_with_mover="false" friction="0.15" keyframed="false" collision_script_quiet_time="0.5" collision_script_tag="small" ray="ignore" lin_damping="0.6" ang_damping="20" restitution="0">
			<object name="Back_Coat_Phys_01"/>
			<object name="Back_Coat_Phys_01_Col" collision_type="box" mass="1" padding="-2.5"/>
		</body>
		
		<body name="Phys_B_02" enabled="true" template="dynamic" collision_class="hair" collision_group="5" collides_with="7" collides_with_mover="false" friction="0.15" keyframed="false" collision_script_quiet_time="0.5" collision_script_tag="small" ray="ignore" lin_damping="0.6" ang_damping="20" restitution="0">
			<object name="Back_Coat_Phys_02"/>
			<object name="Back_Coat_Phys_02_Col" collision_type="box" mass="1" padding="-3.5"/>
		</body>
		
	</bodies>
	
	<constraints>
	
	
	<constraint type="ragdoll" name="cloth_constraint_1" enabled="true">
			<param body_a="Hips_Col" body_b="Phys_R_01"/>
			<param pivot="position:Right_Coat_Phys_01"/>
			<param twist_axis="xaxis:Right_Coat_Phys_01" twist_min="-0.1" twist_max="0.1" twist_freedom="0.1"/>
			<param cone_y="1" cone_z="1" cone_freedom="1"/>
			<param damping="2" spring_constant="2" min_restitution="0.2" max_restitution="0.2"/>
		</constraint>
		<constraint type="ragdoll" name="cloth_constraint_2" enabled="true">
			<param body_a="Phys_R_01" body_b="Phys_R_02"/>
			<param pivot="position:Right_Coat_Phys_02"/>
			<param twist_axis="xaxis:Right_Coat_Phys_02" twist_min="-0.1" twist_max="0.1" twist_freedom="0.1"/>
			<param cone_y="1" cone_z="1" cone_freedom="1"/>
			<param damping="2" spring_constant="2" min_restitution="0.2" max_restitution="0.2"/>
		</constraint>
		
		
		
		<constraint type="ragdoll" name="cloth_constraint_3" enabled="true">
			<param body_a="Hips_Col" body_b="Phys_L_01"/>
			<param pivot="position:Left_Coat_Phys_01"/>
			<param twist_axis="xaxis:Left_Coat_Phys_01" twist_min="-0.1" twist_max="0.1" twist_freedom="0.1"/>
			<param cone_y="1" cone_z="1" cone_freedom="1"/>
			<param damping="2" spring_constant="2" min_restitution="0.2" max_restitution="0.2"/>
		</constraint>
		
		<constraint type="ragdoll" name="cloth_constraint_4" enabled="true">
			<param body_a="Phys_L_01" body_b="Phys_L_02"/>
			<param pivot="position:Left_Coat_Phys_02"/>
			<param twist_axis="xaxis:Left_Coat_Phys_02" twist_min="-0.1" twist_max="0.1" twist_freedom="0.1"/>
			<param cone_y="1" cone_z="1" cone_freedom="1"/>
			<param damping="2" spring_constant="2" min_restitution="0.2" max_restitution="0.2"/>
		</constraint>

		
		
		<constraint type="ragdoll" name="cloth_constraint_5" enabled="true">
			<param body_a="Hips_Col" body_b="Phys_B_01"/>
			<param pivot="position:Back_Coat_Phys_01"/>
			<param twist_axis="xaxis:Back_Coat_Phys_01" twist_min="-0.1" twist_max="0.1" twist_freedom="0.1"/>
			<param cone_y="1" cone_z="1" cone_freedom="1"/>
			<param damping="2" spring_constant="2" min_restitution="0.2" max_restitution="0.2"/>
		</constraint>
		<constraint type="ragdoll" name="cloth_constraint_6" enabled="true">
			<param body_a="Phys_B_01" body_b="Phys_B_02"/>
			<param pivot="position:Back_Coat_Phys_02"/>
			<param twist_axis="xaxis:Back_Coat_Phys_02" twist_min="-0.1" twist_max="0.1" twist_freedom="0.1"/>
			<param cone_y="1" cone_z="1" cone_freedom="1"/>
			<param damping="2" spring_constant="2" min_restitution="0.2" max_restitution="0.2"/>
		</constraint>
	</constraints>	
	
	<graphics>
		<graphic_group culling_object="co_box" enabled="true" name="suit">
			<object enabled="true" name="g_body"/>
			<object enabled="true" name="g_coat"/>
		</graphic_group>
	</graphics>
</dynamic_object>
