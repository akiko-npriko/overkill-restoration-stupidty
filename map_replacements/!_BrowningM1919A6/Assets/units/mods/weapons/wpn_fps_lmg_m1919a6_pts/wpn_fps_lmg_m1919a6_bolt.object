<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_lmg_m1919a6_pts/wpn_fps_lmg_m1919a6_bolt" orientation_object="rp_wpn_fps_lmg_svinet_body_standard" />
	
	<animations>
		<animation_group name="reload">
		  <object name="a_reload" enabled="true" />
		</animation_group>
		
		<animation_group name="reload_not_empty">
		  <object name="a_reload_not_empty" enabled="true" />
		</animation_group>		
	</animations>
	
	<graphics>
		<object name="g_body" enabled="false" />
		<object name="g_bolt" enabled="true" />
		<graphic_group name="character" enabled="true" culling_object="g_bolt">
			<object enabled="true" name="g_bolt" inherit_bounding_volume="co_culling"/>
		</graphic_group>
	</graphics>
	
</dynamic_object>
