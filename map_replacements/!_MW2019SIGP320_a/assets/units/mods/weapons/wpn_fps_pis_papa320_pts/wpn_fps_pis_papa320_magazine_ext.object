<dynamic_object>
    <diesel materials="units/mods/weapons/wpn_fps_pis_papa320_pts/wpn_fps_pis_papa320_magazine_ext" orientation_object="rp_magazine" />
	<animations>
		<animation_group name="reload">
			<object name="anim_reload_e" enabled="true" />	
			<object name="anim_reload_e2" enabled="true" />	
		</animation_group>
		<animation_group name="reload_not_empty">
			<object name="anim_reload_ne" enabled="true" />	
			<object name="anim_reload_ne2" enabled="true" />	
		</animation_group>
	</animations>
    <graphics>
		<object name="g_papa320_mag_ext" enabled="true" />
		<object name="g_papa320_mag_ext_bullet_1" enabled="true" />
		<object name="g_papa320_mag_ext_bullet_2" enabled="true" />
		
        <object name="g_papa320_mag_ext_retention" enabled="true" />
		<object name="g_papa320_mag_ext_bullet_retention" enabled="true" />
    </graphics>
</dynamic_object>