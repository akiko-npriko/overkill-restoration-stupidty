<?xml version="1.0"?>



<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps"/>
		</search>
		<target mode="attach">
			<to name="reload_sickle" 						redirect="fps/reload/sickle"/>
			<to name="reload_not_empty_sickle" 			redirect="fps/reload_not_empty/sickle"/>
		</target>
	</tweak>
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">
			<state name="fps/reload/sickle" type="once" segment="base" speed="1.0">
				<anim name="sickle_reload"/>
				<keys>
					<key at="enter" callback="anim_clbk_stop_weapon_magazine_empty" class_name="base" param1="reload"/>		
					
			        <key at="trigger" trigger="ching_slide_hand" callback="play_sound" class_name="base" param1="sickle_mag_comp_open"/>
					<key at="trigger" trigger="wp_foley_generic_back_in_hand_soft" callback="play_sound" class_name="base" param1="sickle_battery_out"/>
					<key at="trigger" trigger="ching_clip_contact" callback="play_sound" class_name="base" param1="ching_clip_contact"/>
					<key at="trigger" trigger="ching_clip_in" callback="play_sound" class_name="base" param1="sickle_battery_in"/>
					<key at="trigger" trigger="ching_bolt_forward" callback="play_sound" class_name="base" param1="sickle_mag_comp_close"/>
					<key at="trigger" trigger="ching_end_foley" callback="play_sound" class_name="base" param1="ching_end_foley"/>
			
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle"/>
			</state>
			
			
			<state name="fps/reload_not_empty/sickle" type="once" segment="base" speed="1.0">
				<anim name="sickle_reload_not_empty"/>
				<keys>
					<key at="enter" callback="anim_clbk_stop_weapon_magazine_empty" class_name="base" param1="reload"/>	
					
			        <key at="trigger" trigger="ching_slide_hand" callback="play_sound" class_name="base" param1="sickle_mag_comp_open"/>
					<key at="trigger" trigger="wp_foley_generic_back_in_hand_soft" callback="play_sound" class_name="base" param1="sickle_battery_out"/>
					<key at="trigger" trigger="ching_clip_contact" callback="play_sound" class_name="base" param1="ching_clip_contact"/>
					<key at="trigger" trigger="ching_clip_in" callback="play_sound" class_name="base" param1="sickle_battery_in"/>
					<key at="trigger" trigger="ching_bolt_forward" callback="play_sound" class_name="base" param1="sickle_mag_comp_close"/>
					<key at="trigger" trigger="ching_end_foley" callback="play_sound" class_name="base" param1="ching_end_foley"/>
			
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>
	
