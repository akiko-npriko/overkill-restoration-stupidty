<dynamic_object>
    <diesel orientation_object="rp_wpn_fps_pis_beretta_sl_std" materials="units/mods/weapons/wpn_fps_pis_af2011_pts/wpn_fps_pis_af2011_b_silver" />
    <animations>
		<animation_group name="reload">
			<object name="anim_reload" enabled="true" />
		</animation_group>
		<animation_group name="reload_right">
			<object name="anim_bolt_reload_right" enabled="true" />
		</animation_group>
		<animation_group name="reload_left">
			<object name="anim_bolt_reload_left" enabled="true" />
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_recoil" enabled="true" />
		</animation_group>
		<animation_group name="last_recoil">
			<object name="anim_last_recoil" enabled="true" />
		</animation_group>
	</animations>
    <graphics>
        <object name="g_slide" enabled="true" />
    </graphics>
</dynamic_object>
