<dynamic_object>
    <diesel materials="units/mods/weapons/wpn_fps_pis_af2011_pts/wpn_fps_pis_af2011_parts" orientation_object="rp_wpn_fps_pis_beretta_body_beretta" />
    <animations>
		<animation_group name="reload">
			<object name="anim_cocking_lever_reload" enabled="true" />	
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_cocking_lever_shoot" enabled="true" />	
		</animation_group>
	</animations>
    <graphics>
        <object name="g_body" enabled="true" />
        <object name="g_hammer" enabled="true" />
    </graphics>
</dynamic_object>
