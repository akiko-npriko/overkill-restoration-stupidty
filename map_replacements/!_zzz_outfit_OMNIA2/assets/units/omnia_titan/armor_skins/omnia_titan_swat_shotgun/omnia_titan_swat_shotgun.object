<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/omnia_titan/armor_skins/omnia_titan_swat_shotgun/omnia_titan_swat_shotgun" orientation_object="root_point" />

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="co_culling">
			<object name="g_body" enabled="true"/>
			<object name="g_swat_sg" enabled="true"/>
			<object name="g_balaclava" enabled="true"/>
			<object name="g_helmet_sg_lod1" enabled="true"/>
			<object name="g_helmet_sg_lod3" enabled="true"/>

		<!--Faces; Only one should be used at a time-->
			<object name="g_face_a" enabled="false"/>
			<object name="g_face_b" enabled="true"/>
			<object name="g_face_c" enabled="false"/>

		<!--Gun Holsters-->
			<object name="g_holster_l" enabled="true"/> <!--Left thigh-->
			<object name="g_holster_r" enabled="false"/> <!--Right thigh-->
		</graphic_group>
	</graphics>

	<lights>
		<light multiplier="identity" far_range="0" name="ls_light" enabled="false" type="spot|specular" />
	</lights>

</dynamic_object>