<unit type="gen" slot="1" >
	<network sync="spawn" />
    <object file="units/pd2_mod_steve/equipment/steve_remote_hack_tool/steve_remote_hack_tool" />
    <extensions>
        <extension class="ScriptUnitData" name="unit_data" />
        <extension class="UnitDamage" name="damage" />
        <extension name="interaction" class="RemoteHackingInteractionExt">
			<var name="tweak_data" value="hack_remote_difficulty_1" />
		</extension>	
    </extensions>
    <sounds>
    	<default_soundsource source="rp_gen_panel_keycard_hack"/>
    	<soundsource name="snd" source="rp_gen_panel_keycard_hack" />
    </sounds>
</unit>
