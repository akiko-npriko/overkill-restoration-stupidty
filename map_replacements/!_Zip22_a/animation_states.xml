					<key at="trigger" trigger="wp_zip22_new_mag" callback="play_sound" class_name="base" 				param1="zip22_drum_contact"/>
					<key at="trigger" trigger="wp_zip22_mag_contact" callback="play_sound" class_name="base" 			param1="zip22_drum_in"/>
					<key at="trigger" trigger="wp_zip22_magin" callback="play_sound" class_name="base" 					param1="zip22_drum_gun_hit"/>
					<key at="trigger" trigger="wp_zip22_pull_first" callback="play_sound" class_name="base" 			param1="zip22_pull_charging_handle_start"/>
					<key at="trigger" trigger="wp_zip22_pull_last" callback="play_sound" class_name="base" 				param1="zip22_pull_charging_handle_finish"/>
					<key at="trigger" trigger="wp_zip22_hit_ground_lmao" callback="play_sound" class_name="base" 		param1="zip22_drum_gun_impact_ground"/>
