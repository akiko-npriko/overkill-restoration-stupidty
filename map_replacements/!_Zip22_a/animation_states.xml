<?xml version="1.0"?>

<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps"/>
		</search>
		<target mode="attach">
			<to name="reload_zip22" 						redirect="fps/reload/zip22"/>
			<to name="reload_not_empty_zip22" 				redirect="fps/reload_not_empty/zip22"/>
			<to name="reload_zip22_drum" 					redirect="fps/reload/zip22_drum"/>
			<to name="reload_not_empty_zip22_drum" 			redirect="fps/reload_not_empty/zip22_drum"/>
		</target>
	</tweak>
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">
			<state name="fps/reload/zip22" type="once" segment="base" speed="1.0">
				<anim name="zip22_reload"/>
				<keys>
					<key at="enter" callback="anim_clbk_stop_weapon_magazine_empty" class_name="base" param1="reload"/>	
					
					<key at="trigger" trigger="wp_zip22_mag_release" callback="play_sound" class_name="base" 			param1="zip22_mag_release"/>
					<key at="trigger" trigger="wp_zip22_magout" callback="play_sound" class_name="base" 				param1="zip22_mag_out"/>
					<key at="trigger" trigger="wp_zip22_new_mag" callback="play_sound" class_name="base" 				param1="zip22_mag_take_new"/>
					<key at="trigger" trigger="wp_zip22_mag_contact" callback="play_sound" class_name="base" 			param1="zip22_mag_contact"/>
					<key at="trigger" trigger="wp_zip22_magin" callback="play_sound" class_name="base" 					param1="zip22_mag_in"/>
					<key at="trigger" trigger="wp_zip22_pull_first" callback="play_sound" class_name="base" 			param1="zip22_pull_charging_handle_start"/>
					<key at="trigger" trigger="wp_zip22_pull_last" callback="play_sound" class_name="base" 				param1="zip22_pull_charging_handle_finish"/>
					<key at="trigger" trigger="wp_zip22_release" callback="play_sound" class_name="base" 				param1="zip22_bolt_forwards"/>
					<key at="trigger" trigger="wp_zip22_last_foley" callback="play_sound" class_name="base" 			param1="zip22_foley_end"/>
					
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle"/>
			</state>
			
			
			<state name="fps/reload_not_empty/zip22" type="once" segment="base" speed="1.0">
				<anim name="zip22_reload_not_empty"/>
				<keys>
					<key at="enter" callback="anim_clbk_stop_weapon_magazine_empty" class_name="base" param1="reload"/>	
					
					<key at="trigger" trigger="wp_zip22_mag_release" callback="play_sound" class_name="base" 			param1="zip22_mag_release"/>
					<key at="trigger" trigger="wp_zip22_magout" callback="play_sound" class_name="base" 				param1="zip22_mag_out"/>
					<key at="trigger" trigger="wp_zip22_new_mag" callback="play_sound" class_name="base" 				param1="zip22_mag_take_new"/>
					<key at="trigger" trigger="wp_zip22_mag_contact" callback="play_sound" class_name="base" 			param1="zip22_mag_contact"/>
					<key at="trigger" trigger="wp_zip22_magin" callback="play_sound" class_name="base" 					param1="zip22_mag_in"/>
					<key at="trigger" trigger="wp_zip22_pull_first" callback="play_sound" class_name="base" 			param1="zip22_pull_charging_handle_start"/>
					<key at="trigger" trigger="wp_zip22_pull_last" callback="play_sound" class_name="base" 				param1="zip22_pull_charging_handle_finish"/>
					<key at="trigger" trigger="wp_zip22_release" callback="play_sound" class_name="base" 				param1="zip22_bolt_forwards"/>
					<key at="trigger" trigger="wp_zip22_last_foley" callback="play_sound" class_name="base" 			param1="zip22_foley_end"/>
					
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />

				</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>
	
