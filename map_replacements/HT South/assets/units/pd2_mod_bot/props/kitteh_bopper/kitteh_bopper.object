<dynamic_object>
    <diesel orientation_object="rp_root" materials="units/pd2_mod_bot/props/kitteh_bopper/kitteh_bopper" />
	<sequence_manager file="units/pd2_mod_bot/props/kitteh_bopper/kitteh_bopper" />

	<animations>
		<animation_group name="boop" >
			<object name="anim_head" />
		</animation_group>
	</animations>
	
    <bodies>
        <body name="editor_button" enabled="true" template="editor">
            <object name="g_body" collision_type="box" />
        </body>
    </bodies>
	
    <graphics>
        <object enabled="true" name="g_head" />
        <object enabled="true" name="g_body" />
    </graphics>
</dynamic_object>