<?xml version="1.0"?>
<unit type="gen" slot="1">
  <network sync="spawn" />
  <object file="units/pd2_mod_owp/vehicles/veh_bags/veh_toolbag" />
  <extensions>
    <extension name="unit_data" class="ScriptUnitData" />
	<extension name="damage" class="UnitDamage" />
    <extension name="interaction" class="CarryInteractionExt">
      <var name="tweak_data" value="hold_pickup_lance" />
      <var name="_remove_on_interact" value="true" />
    </extension>
    <extension name="carry_data" class="CarryData">
		<var name="_carry_id" value="lance_bag" />
	</extension>
  </extensions>
</unit>