<?xml version="1.0"?>



<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps"/>
		</search>
		<target mode="attach">
			<to name="reload_sa1" 						redirect="fps/reload/sa1"/>
			<to name="reload_not_empty_sa1" 			redirect="fps/reload_not_empty/sa1"/>
		</target>
	</tweak>
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">
			<state name="fps/reload/sa1" type="once" segment="base" speed="1.0">
				<anim name="sa1_reload"/>
					<keys>					
						<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
						
						<key at="trigger" trigger="basset_hand_release" callback="play_sound" class_name="base" param1="sa1_raise"/>
						<key at="trigger" trigger="contraband_lift_up" callback="play_sound" class_name="base" param1="sa1_fast_raise"/>
						<key at="trigger" trigger="basset_grab_mag" callback="play_sound" class_name="base" param1="sa1_mag_grab"/>
						<key at="trigger" trigger="basset_mag_out" callback="play_sound" class_name="base" param1="sa1_maghit"/>
						<key at="trigger" trigger="wp_foley_generic_clip_throw" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_throw"/>
						<key at="trigger" trigger="basset_grab_new_mag" callback="play_sound" class_name="base" param1="sa1_mag_movement"/>
						<key at="trigger" trigger="wp_clip_generic_ass_center" callback="play_sound" class_name="base" param1="wp_clip_generic_ass_center"/>
						<key at="trigger" trigger="basset_foley_mag_in" callback="play_sound" class_name="base" param1="sa1_mag_grab"/>
						<key at="trigger" trigger="basset_mag_contact" callback="play_sound" class_name="base" param1="sa1_mag_connect"/>
						<key at="trigger" trigger="basset_mag_in" callback="play_sound" class_name="base" param1="sa1_mag_slide_in"/>
						<key at="trigger" trigger="wp_foley_generic_tilt_back" callback="play_sound" class_name="base" param1="sa1_rail_raise"/>
						<key at="trigger" trigger="wp_foley_generic_lever_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_grab"/>
						<key at="trigger" trigger="basset_lever_back" callback="play_sound" class_name="base" param1="sa1_lever_pull"/>
						<key at="trigger" trigger="wp_foley_generic_lever_release" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_release"/>
						<key at="trigger" trigger="basset_lever_release" callback="play_sound" class_name="base" param1="sa1_lever_release"/>
						<key at="trigger" trigger="wp_foley_generic_tilt" callback="play_sound" class_name="base" param1="sa1_reload_raise"/>
						<key at="trigger" trigger="basset_foley_end" callback="play_sound" class_name="base" param1="basset_foley_end"/>
						<key at="trigger" trigger="basset_grab_end" callback="play_sound" class_name="base" param1="sa1_reload_end_2"/>
					</keys>
				<exit name="fps/idle"/>
			</state>
			
			
			<state name="fps/reload_not_empty/sa1" type="once" segment="base" speed="1.0">
				<anim name="sa1_reload_not_empty"/>
					<keys>		
						<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
						
						<key at="trigger" trigger="basset_hand_release" callback="play_sound" class_name="base" param1="sa1_raise"/>
						<key at="trigger" trigger="contraband_lift_up" callback="play_sound" class_name="base" param1="sa1_fast_raise"/>
						<key at="trigger" trigger="basset_grab_mag" callback="play_sound" class_name="base" param1="sa1_mag_grab"/>
						<key at="trigger" trigger="basset_mag_out" callback="play_sound" class_name="base" param1="sa1_maghit"/>
						<key at="trigger" trigger="wp_foley_generic_clip_throw" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_throw"/>
						<key at="trigger" trigger="basset_grab_new_mag" callback="play_sound" class_name="base" param1="sa1_mag_movement"/>
						<key at="trigger" trigger="wp_clip_generic_ass_center" callback="play_sound" class_name="base" param1="wp_clip_generic_ass_center"/>
						<key at="trigger" trigger="basset_foley_mag_in" callback="play_sound" class_name="base" param1="sa1_mag_grab"/>
						<key at="trigger" trigger="basset_mag_contact" callback="play_sound" class_name="base" param1="sa1_mag_connect"/>
						<key at="trigger" trigger="basset_mag_in" callback="play_sound" class_name="base" param1="sa1_mag_slide_in"/>
						<key at="trigger" trigger="wp_foley_generic_tilt_back" callback="play_sound" class_name="base" param1="sa1_rail_raise"/>
						<key at="trigger" trigger="wp_foley_generic_lever_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_grab"/>
						<key at="trigger" trigger="basset_lever_back" callback="play_sound" class_name="base" param1="sa1_lever_pull"/>
						<key at="trigger" trigger="wp_foley_generic_lever_release" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_release"/>
						<key at="trigger" trigger="basset_lever_release" callback="play_sound" class_name="base" param1="sa1_lever_release"/>
						<key at="trigger" trigger="wp_foley_generic_tilt" callback="play_sound" class_name="base" param1="sa1_reload_raise"/>
						<key at="trigger" trigger="basset_foley_end" callback="play_sound" class_name="base" param1="basset_foley_end"/>
						<key at="trigger" trigger="basset_grab_end" callback="play_sound" class_name="base" param1="sa1_reload_end_2"/>
					</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>
	
