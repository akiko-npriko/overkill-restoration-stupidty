<dynamic_object>
	<diesel orientation_object="rp_wpn_fps_ass_groza" />
	<animations>  
		<animation_group name="reload" enabled="false" >
			<object name="anim_reload_mag" enabled="true" />
			<object name="anim_reload_bolt" enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty" enabled="false" >
			<object name="anim_reload_not_empty_mag" enabled="true" />
			<object name="anim_reload_not_empty_bolt" enabled="true" />
		</animation_group>
		<animation_group name="recoil" enabled="false" >
			<object name="anim_recoil_bolt" enabled="true" />
		</animation_group>
    </animations> 	
</dynamic_object>
