<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_pis_sg45_pts/wpn_fps_pis_sg45_bolt_standard" orientation_object="rp_wpn_fps_pis_packrat_bolt_standard" />
    <animations>
		<animation_group name="reload">
			<object name="anim_cocking_lever_reload" enabled="true" />	
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_cocking_lever_shoot" enabled="true" />	
		</animation_group>
	</animations>
	<graphics>
		<object name="g_bolt" enabled="true" />
	</graphics>
</dynamic_object>
