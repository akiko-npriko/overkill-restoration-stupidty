<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_sho_haymaker/wpn_fps_sho_haymaker" orientation_object="rp_haymaker" />
	<lights />
	<animations>  
		<animation_group name="reload" enabled="false" >
			<object name="anim_m_reload" enabled="true" />
			<object name="anim_m_drum_reload" enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty" enabled="false" >
			<object name="anim_reload_not_empty" enabled="true" />
			<object name="anim_drum_reload_not_empty" enabled="true" />
		</animation_group>
    </animations>
</dynamic_object>
