<dynamic_object>
    <diesel orientation_object="rp_wpn_fps_smg_mac10" />
	<animations>  
		<animation_group name="reload" enabled="false" >
			<object name="anim_magazine_reload" enabled="true" />
			<object name="anim_reload_charging_handle" enabled="true" />
			<object name="anim_magazine_reload_spare" enabled="true" />
			<object name="anim_bolt_reload" enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty" enabled="false" >
			<object name="anim_magazine_reload_tactical" enabled="true" />
			<object name="anim_magazine_reload_tactical_spare" enabled="true" />
		</animation_group>
		<animation_group name="recoil" enabled="false" >
			<object name="anim_bolt_recoil" enabled="true" />
		</animation_group>
    </animations>
</dynamic_object>
