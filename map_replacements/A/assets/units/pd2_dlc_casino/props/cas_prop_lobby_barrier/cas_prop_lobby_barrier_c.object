<dynamic_object>
	<diesel materials="units/pd2_dlc_casino/props/cas_prop_lobby_barrier/cas_prop_lobby_barrier" orientation_object="rp_cas_prop_lobby_barrier_c" />
	<bodies>
		<body name="body_static" enabled="true" template="static">
			<object name="rp_cas_prop_lobby_barrier_c" />
			<object name="c_box_02" collision_type="box" padding="-2.5" />
			<object name="c_box_03" collision_type="box" padding="-2.5" />
			<object name="c_box_04" collision_type="box" padding="-2.5" />
			<object name="c_box_01" collision_type="box" padding="-2.5" />
			<object name="c_capsule_01" collision_type="capsule" padding="-2.5" />
		</body>
	</bodies>
	<decal_surfaces default_material="metal">
		<decal_mesh name="dm_cloth" enabled="true" material="cloth" />
		<decal_mesh name="dm_metal" enabled="true" material="metal" />
	</decal_surfaces>
	<graphics>
		<lod_object name="lod_g_m">
			<object name="g_m_lod0" enabled="true" max_distance="1500" />
			<object name="g_m_lod1" enabled="true" />
		</lod_object>
	</graphics>
</dynamic_object>
