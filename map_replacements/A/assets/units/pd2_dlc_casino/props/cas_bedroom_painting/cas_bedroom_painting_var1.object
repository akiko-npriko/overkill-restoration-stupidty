<dynamic_object>
	<diesel materials="units/pd2_dlc_casino/props/cas_bedroom_painting/cas_bedroom_paintings" orientation_object="rp_cas_bedroom_painting_var1" />
	<sequence_manager file="units/pd2_dlc_casino/props/cas_bedroom_painting/cas_bedroom_paintings" />
	<bodies>
		<body name="body_static" enabled="true" template="static">
			<object name="rp_cas_bedroom_painting_var1" />
			<object name="c_box_01" collision_type="box" padding="-2.5" />
		</body>

		<body name="body_dynamic" enabled="false" template="dynamic">
			<object name="rp_cas_bedroom_painting_var1" />
			<object name="c_box_01" collision_type="box" padding="-2.5" />
		</body>
		
	</bodies>
	<decal_surfaces default_material="cloth">
		<decal_mesh name="dm_cloth" enabled="true" material="cloth" />
	</decal_surfaces>
	<graphics>
		<lod_object name="lod_g_g">
			<object name="g_g_lod0" enabled="true" max_distance="7000" />
			<object name="g_g_lod1" enabled="true" />
		</lod_object>
	</graphics>
</dynamic_object>
