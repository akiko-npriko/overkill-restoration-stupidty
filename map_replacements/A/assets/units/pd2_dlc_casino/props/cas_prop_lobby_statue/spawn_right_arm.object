<dynamic_object>
	<diesel materials="units/pd2_dlc_casino/props/cas_prop_lobby_statue/cas_prop_lobby_statue" orientation_object="rp_spawn_right_arm" />
	<bodies>
		<body name="body_static" enabled="true" template="dynamic" collides_with_mover="false">
			<object name="rp_spawn_right_arm" />
			<object name="c_convex_right_hand" collision_type="convex" padding="-2.5" material="stone" />
			<object name="c_capsule_right_arm" collision_type="capsule" padding="-2.5" material="stone" />
		</body>
	</bodies>
	<graphics>
		<lod_object name="lod_g_right_arm">
			<object name="g_right_arm_lod0" enabled="true" max_distance="5000" />
			<object name="g_right_arm_lod1" enabled="true" />
		</lod_object>
	</graphics>
</dynamic_object>
