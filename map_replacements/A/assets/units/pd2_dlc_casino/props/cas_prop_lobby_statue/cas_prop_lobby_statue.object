				<object name="g_body_04_lod1" enabled="true" />
			</lod_object>
		</graphic_group>

		<graphic_group name="grp_head" enabled="true" >
			<lod_object name="lod_g_head">
				<object name="g_head_lod0" enabled="true" max_distance="5000" />
				<object name="g_head_lod1" enabled="true" />
			</lod_object>
		</graphic_group>

		<graphic_group name="grp_left_arm" enabled="true" >
			<lod_object name="lod_g_left_arm">
