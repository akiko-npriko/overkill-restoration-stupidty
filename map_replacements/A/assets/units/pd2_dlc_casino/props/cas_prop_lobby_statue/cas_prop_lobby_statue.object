		<graphic_group name="grp_podium" enabled="true" >
			<lod_object name="lod_g_podium">
				<object name="g_podium_lod0" enabled="true" max_distance="5000" />
				<object name="g_podium_lod1" enabled="true" />
			</lod_object>
		</graphic_group>

		<graphic_group name="grp_right_arm" enabled="true" >
			<lod_object name="lod_g_right_arm">
				<object name="g_right_arm_lod0" enabled="true" max_distance="5000" />
				<object name="g_right_arm_lod1" enabled="true" />
