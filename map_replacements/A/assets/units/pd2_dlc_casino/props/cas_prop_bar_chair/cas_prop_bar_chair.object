<dynamic_object>
	<diesel materials="units/pd2_dlc_casino/props/cas_prop_bar_chair/cas_prop_bar_chair" orientation_object="rp_cas_prop_bar_chair" />
	<bodies>
		<body name="body_static" enabled="true" template="static">
			<object name="rp_cas_prop_bar_chair" />
			<object name="c_convex_03" collision_type="convex" padding="-2.5" />
			<object name="c_capsule_02" collision_type="capsule" padding="-2.5" />
			<object name="c_box_01" collision_type="box" padding="-2.5" />
			<object name="c_box_02" collision_type="box" padding="-2.5" />
			<object name="c_convex_01" collision_type="convex" padding="-2.5" />
			<object name="c_convex_02" collision_type="convex" padding="-2.5" />
		</body>
	</bodies>
	<decal_surfaces default_material="cloth_stuffed">
		<decal_mesh name="dm_cloth_stuffed" enabled="true" material="cloth_stuffed" />
		<decal_mesh name="dm_metal" enabled="true" material="metal" />
		<decal_mesh name="dm_plastic" enabled="true" material="plastic" />
	</decal_surfaces>
	<graphics>
		<lod_object name="grp_lod_g_m">
			<object name="g_m_lod0" enabled="true" max_distance="1500" />
			<object name="g_m_lod1" enabled="true" />
		</lod_object>
	</graphics>
</dynamic_object>
