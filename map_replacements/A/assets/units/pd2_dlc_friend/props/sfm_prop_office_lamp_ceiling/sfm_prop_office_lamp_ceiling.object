<dynamic_object>
	<diesel materials="units/pd2_dlc_friend/props/sfm_prop_office_lamp_ceiling/sfm_prop_office_lamp_ceiling" orientation_object="rp_sfm_prop_office_lamp_ceiling" />
	<sequence_manager file="units/pd2_dlc_friend/props/sfm_prop_office_lamp_ceiling/sfm_prop_office_lamp_ceiling" />
	<bodies>
		<body name="static_body" enabled="true" template="static">
			<object name="rp_sfm_prop_office_lamp_ceiling" />
			<object name="c_box_01" collision_type="box" padding="-2.5" />			
			<object name="c_box_06" collision_type="box" padding="-2.5" />
			<object name="c_convex_01" collision_type="convex" padding="-2.5" />
		</body>
		<body name="glass_body" enabled="true" template="static">			
			<object name="c_box_02" collision_type="box" padding="-2.5" />
			<object name="c_box_03" collision_type="box" padding="-2.5" />
			<object name="c_box_04" collision_type="box" padding="-2.5" />
			<object name="c_box_05" collision_type="box" padding="-2.5" />
		</body>
	</bodies>

	<decal_surfaces >
		<decal_mesh name="dm_glass_breakable" enabled="true" material="glass_breakable" />
		<decal_mesh name="dm_metal" enabled="true" material="metal" />
	</decal_surfaces>

	<graphics>
		<lod_object name="g_glass" enabled="true" >
			<object name="g_lod0" enabled="true" max_distance="5000" />
			<object name="g_lod1" enabled="true" />
		</lod_object>
		<lod_object name="g_glass_broken" enabled="false" >
			<object name="g_dmg_lod0" enabled="true" max_distance="5000" />
			<object name="g_dmg_lod1" enabled="true" />
		</lod_object>
		<lod_object name="lod_g_glass" enabled="true">
			<object name="g_glass_lod0" enabled="true" max_distance="5000" />
			<object name="g_glass_lod1" enabled="true" />
		</lod_object>
		<object name="s_s" enabled="true" shadow_caster="true" />
	</graphics>
</dynamic_object>
