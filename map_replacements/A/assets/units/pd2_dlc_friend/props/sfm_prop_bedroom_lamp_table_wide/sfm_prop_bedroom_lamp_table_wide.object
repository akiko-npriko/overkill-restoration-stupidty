<dynamic_object>
	<diesel materials="units/pd2_dlc_friend/props/sfm_prop_bedroom_lamp_table_wide/sfm_prop_bedroom_lamp_table_wide" orientation_object="rp_sfm_prop_bedroom_lamp_table_wide" />
	<sequence_manager file="units/pd2_dlc_friend/props/sfm_prop_bedroom_lamp_table_wide/sfm_prop_bedroom_lamp_table_wide" />
	<bodies>

	    <body remove_ray_type="walk vis_graph" name="static_body" enabled="true" template="raycoll_static">
	       	<object name="rp_sfm_prop_bedroom_lamp_table_wide" />
			<object name="c_capsule_01" collision_type="capsule" padding="-2.5" />
			<object name="c_convex_05" collision_type="convex" padding="-2.5" />
	    </body>

		<body name="part1_body_dyn" template="debris" enabled="false" pushed_by_mover="false">
		      <object name="c_convex_01" collision_type="convex" padding="-2.5" />
		</body>
		<body name="part2_body_dyn" template="debris" enabled="false" pushed_by_mover="false">
		      <object name="c_convex_02" collision_type="convex" padding="-2.5" />
		</body>
		    <body name="part3_body_dyn" template="debris" enabled="false" pushed_by_mover="false">
		      <object name="c_convex_03" collision_type="convex" padding="-2.5" />
		</body>
		<body name="part4_body_dyn" template="debris" enabled="false" pushed_by_mover="false">
		      <object name="c_convex_04" collision_type="convex" padding="-2.5" />
		</body>	
	</bodies>

	<decal_surfaces default_material="metal">
		<decal_mesh name="dm_cloth" enabled="true" material="cloth" />
		<decal_mesh name="dm_glass_breakable" enabled="true" material="glass_breakable" />
		<decal_mesh name="dm_metal" enabled="true" material="metal" />
	</decal_surfaces>

	

	<graphics>
		<lod_object name="lod_g">
			<object name="g_lod0" enabled="true" max_distance="1500" />
			<object name="g_lod1" enabled="true" max_distance="3000" />
			<object name="g_lod2" enabled="true" />
		</lod_object>
		<lod_object name="lod_g_dmg_01">
			<object name="g_dmg_01_lod0" enabled="false" max_distance="1500" />
			<object name="g_dmg_01_lod1" enabled="false" max_distance="3000" />
			<object name="g_dmg_01_lod2" enabled="false" />
		</lod_object>
		<lod_object name="lod_g_dmg_02">
			<object name="g_dmg_02_lod0" enabled="false" max_distance="1500" />
			<object name="g_dmg_02_lod1" enabled="false" max_distance="3000" />
			<object name="g_dmg_02_lod2" enabled="false" />
		</lod_object>
		<lod_object name="lod_g_dmg_03">
			<object name="g_dmg_03_lod0" enabled="false" max_distance="1500" />
			<object name="g_dmg_03_lod1" enabled="false" max_distance="3000" />
			<object name="g_dmg_03_lod2" enabled="false" />
		</lod_object>
		<lod_object name="lod_g_dmg_04">
			<object name="g_dmg_04_lod0" enabled="false" max_distance="1500" />
			<object name="g_dmg_04_lod1" enabled="false" max_distance="3000" />
			<object name="g_dmg_04_lod2" enabled="false" />
		</lod_object>
		<object name="s_s" enabled="true" shadow_caster="true" />
	</graphics>
</dynamic_object>
