<dynamic_object>
	<diesel materials="units/pd2_dlc_friend/props/sfm_prop_office_cigarbox/sfm_prop_office_cigarbox" orientation_object="rp_sfm_prop_office_cigarbox" />
	<sequence_manager file="units/pd2_dlc_friend/props/sfm_prop_office_cigarbox/sfm_prop_office_cigarbox" />
	<animations>
		<animation_group name="anim_lid_open" enabled="false">
			<object name="anim_lid" />
		</animation_group>
		<animation_group name="anim_button_press" enabled="false">
			<object name="anim_button" />
		</animation_group>
	</animations>
	<bodies>
		<body name="body_static" enabled="true" template="static">
			<object name="rp_sfm_prop_office_cigarbox" />
			<object name="c_box_01" collision_type="box" padding="-2.5" />
		</body>
		<body name="body_collision_01" enabled="true" template="animated">
			<object name="anim_lid" />
			<object name="c_box_01_top" collision_type="box" padding="-2.5" />
		</body>
	</bodies>
	<decal_surfaces default_material="metal">
		<decal_mesh name="dm_metal" enabled="true" material="metal" />
		<decal_mesh name="dm_metal_top" enabled="true" material="thin_layer" />
	</decal_surfaces>
	<graphics>
		<lod_object name="lod_g">
			<object name="g_lod0" enabled="true" max_distance="8500" />
			<object name="g_lod1" enabled="true" />
		</lod_object>
		<lod_object name="lod_g_g">
			<object name="g_lod0_top" enabled="true" max_distance="8500" />			
			<object name="g_lod1_top" enabled="true" />
		</lod_object>
		<object name="g_button" enabled="false" />		
		<object name="s_s" enabled="true" shadow_caster="true" />
		<object name="s_s_top" enabled="true" shadow_caster="true" />
	</graphics>
</dynamic_object>
