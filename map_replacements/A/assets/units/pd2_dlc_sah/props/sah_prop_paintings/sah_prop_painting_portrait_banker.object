<dynamic_object>
	<diesel materials="units/pd2_dlc_sah/props/sah_prop_paintings/sah_prop_painting_portrait_banker" orientation_object="rp_sah_prop_painting_portrait_banker" />
	<sequence_manager file="units/pd2_dlc_sah/props/sah_prop_paintings/sah_prop_paintings" />
	<bodies>
        <body enabled="true" template="static" name="static_body" >
			<object name="rp_sah_prop_painting_portrait_banker" />	
            <object collision_type="convex" name="c_convex_01" padding="-2.5"/>
        </body>
        <body enabled="false" template="small_prop" name="dynamic_body" >
			<object name="rp_sah_prop_painting_portrait_banker" />		
            <object collision_type="convex" name="c_convex_01" padding="-2.5"/>
        </body>		
    </bodies>
	<decal_surfaces default_material="wood">
		<decal_mesh name="dm_cloth" enabled="true" material="cloth" />
		<decal_mesh name="dm_wood" enabled="true" material="wood" />
	</decal_surfaces>
	<graphics>
		<object name="g_painting_portrait_banker" enabled="true" />
	</graphics>
</dynamic_object>
