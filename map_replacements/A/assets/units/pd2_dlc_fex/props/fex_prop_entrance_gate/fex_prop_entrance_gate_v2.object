<dynamic_object>
	<diesel materials="units/pd2_dlc_fex/props/fex_prop_entrance_gate/fex_prop_entrance_gate_v2" orientation_object="rp_fex_prop_entrance_gate_v2" />
	<sequence_manager file="units/pd2_dlc_fex/props/fex_prop_entrance_gate/fex_prop_entrance_gate_v2" />
	<animations>
		<animation_group name="anim_gate" enabled="false">
			<object name="anim_door_left_broken" />
			<object name="anim_door_right_broken" />
		</animation_group>
		
	</animations> 
	<bodies>
		<body name="body_static" enabled="true" template="static">
			<object name="rp_fex_prop_entrance_gate_v2" />			
			<object name="c_box_02" collision_type="box" padding="-2.5" />
			<object name="c_box_03" collision_type="box" padding="-2.5" />
		</body>
		
		<body name="body_animated_03" enabled="true"  template="static" keyframed="true">
			<object name="anim_door_left_broken" />
			<object name="c_convex_02" collision_type="convex" padding="-2.5" />
		</body>
		<body name="body_animated_04" enabled="true"  template="static" keyframed="true">
			<object name="anim_door_right_broken" />
			<object name="c_convex_01" collision_type="convex" padding="-2.5" />
		</body>


		<body name="body_animated_01" enabled="true"  template="fence" keyframed="true">
			<object name="anim_door_left_broken" />
			<object name="c_convex_03" collision_type="convex" padding="-2.5" />
		</body>
		<body name="body_animated_02" enabled="true"  template="fence" keyframed="true">
			<object name="anim_door_right_broken" />
			<object name="c_convex_04" collision_type="convex" padding="-2.5" />
		</body>
	</bodies>
	<decal_surfaces default_material="metal">
		<decal_mesh name="dm_metal_01" enabled="true" material="metal" />
		<decal_mesh name="dm_metal_02" enabled="true" material="metal" />
		<decal_mesh name="dm_metal_03" enabled="true" material="metal" />
		<decal_mesh name="dm_metal_04" enabled="true" material="metal" />
		<decal_mesh name="dm_metal_05" enabled="true" material="metal" />
	</decal_surfaces>


	<effects>
		
		<effect_spawner name="effect_lock_01" 		enabled="false" 		object="e_effect_lock_01" 		effect="effects/payday2/particles/fire/thermite_infinite" />
		
	</effects>

	<graphics>


		<graphic_group name="grp_door_orig" 				enabled="true">
			<object name="g_door_orig" enabled="true" />
		</graphic_group>
		<graphic_group name="grp_lock_02_broken" 				enabled="true">
			<object name="g_right_door_broken" enabled="false" />
		</graphic_group>
		<graphic_group name="grp_lock_01_broken" 				enabled="true">
			<object name="g_left_door_broken" enabled="false" />
		</graphic_group>


		<object name="g_left_door_broken" enabled="false" />
		<object name="g_right_door_broken" enabled="false" />
		<object name="g_thermite_01" enabled="false" />
		
		<object name="g_g" enabled="true" />
		<object name="s_s_01" enabled="true" shadow_caster="true" />
		<object name="s_s_02" enabled="true" shadow_caster="true" />
		<object name="s_s_03" enabled="true" shadow_caster="true" />
		<object name="s_s_05" enabled="true" shadow_caster="true" />
		<object name="s_s_04" enabled="true" shadow_caster="true" />

	</graphics>
</dynamic_object>
