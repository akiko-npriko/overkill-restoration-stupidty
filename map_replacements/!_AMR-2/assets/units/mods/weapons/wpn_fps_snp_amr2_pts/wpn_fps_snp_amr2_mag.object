<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_snp_amr2_pts/wpn_fps_snp_amr2_mag" orientation_object="rp_wpn_fps_snp_msr_m_standard"/>
	<animations>
		<animation_group name="reload">
			<object name="anim_reload" enabled="true" />
			<object name="anim_shell_reload" enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty">
			<object name="anim_reload_not_empty" enabled="true" />
			<object name="anim_shell_reload_not_empty" enabled="true" />
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_shell_recoil" enabled="true" />
		</animation_group>
	</animations>
	<graphics>
		<object name="g_bullet_amr2" enabled="true"/>
		<object name="g_mag" enabled="true"/>

		<object enabled="false" name="g_mag_lod0" />
		<object enabled="false" name="g_shell_lod0" />
		<object enabled="false" name="g_bullet_lod0" />
	</graphics>
</dynamic_object>