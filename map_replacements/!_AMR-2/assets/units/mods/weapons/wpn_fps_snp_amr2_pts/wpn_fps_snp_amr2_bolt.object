<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_snp_amr2_pts/wpn_fps_snp_amr2_bolt" orientation_object="rp_wpn_fps_snp_msr_body_msr"/>
	<animations>
		<animation_group name="reload">
			<object name="anim_bolt_reload" enabled="true" />
			<object name="anim_bolt_reload_rotate" enabled="true" />
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_bolt_recoil" enabled="true" />
			<object name="anim_bolt_recoil_rotate" enabled="true" />
		</animation_group>
	</animations>
	<graphics>
		<object name="g_bolt" enabled="true"/>

		<object enabled="false" name="g_bolt_lod0" />
		<object enabled="false" name="g_firingpin_lod0" />
		<object enabled="false" name="g_receiver_lod0" />
		<object enabled="false" inherit_bounding_volume="co_culling" name="g_body_lod0" />
	</graphics>
</dynamic_object>