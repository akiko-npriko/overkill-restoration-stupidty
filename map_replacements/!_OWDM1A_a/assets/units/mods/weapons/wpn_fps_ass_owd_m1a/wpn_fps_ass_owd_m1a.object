<dynamic_object>
	<diesel  orientation_object="rp_wpn_fps_ass_ching" />
	<animations>
		<animation_group name="reload">
			<object name="anim_mag_reload" enabled="true" />
			<object name="anim_dh_reload" enabled="true" />
			<object name="anim_bolt_reload" enabled="true" />
			<object name="anim_extra1_reload" enabled="true" />
			<object name="anim_extra_reload" enabled="true" />
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_dh_recoil" enabled="true" />
			<object name="anim_bolt_recoil" enabled="true" />
			<object name="anim_extra1_recoil" enabled="true" />
			<object name="anim_extra_recoil" enabled="true" />
		</animation_group>
		<animation_group name="last_recoil">
			<object name="anim_dh_last_recoil" enabled="true" />
			<object name="anim_bolt_last_recoil" enabled="true" />
			<object name="anim_extra1_last_recoil" enabled="true" />
			<object name="anim_extra_last_recoil" enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty">
			<object name="anim_mag_reload_tactical" enabled="true" />
			<object name="anim_dh_reload_tactical" enabled="true" />
			<object name="anim_bolt_reload_tactical" enabled="true" />
			<object name="anim_extra1_reload_tactical" enabled="true" />
			<object name="anim_extra_reload_tactical" enabled="true" />
		</animation_group>
	</animations>	
</dynamic_object>
