<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_lmg_fg42_pts/fg42_std" orientation_object="rp_wpn_fps_lmg_fg42" />
    <animations>
		<animation_group name="deploy">
			<object name="a_bp_late_r_deploy" enabled="true"/>
			<object name="a_bp_late_l_deploy" enabled="true"/>
		</animation_group>
		<animation_group name="undeploy">
			<object name="a_bp_late_r_undeploy" enabled="true"/>
			<object name="a_bp_late_l_undeploy" enabled="true"/>
		</animation_group>
	</animations>
	<graphics>
		<object name="g_base" enabled="true" />
		<object name="g_leg_left" enabled="true" />
		<object name="g_leg_right" enabled="true" />
	</graphics>
</dynamic_object>
