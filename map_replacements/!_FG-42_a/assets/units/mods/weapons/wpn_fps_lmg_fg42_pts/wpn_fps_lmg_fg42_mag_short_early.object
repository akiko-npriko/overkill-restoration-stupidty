<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_lmg_fg42_pts/fg42_early" orientation_object="rp_wpn_fps_lmg_fg42" />
    <animations>
		<animation_group name="recoil" >
			<object name="a_bullet_1_recoil" enabled="true" />
			<object name="a_bullet_1_p_recoil" enabled="true" />
			<object name="a_mag_recoil" enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty" >
			<object name="a_mag_reload" enabled="true" />
		</animation_group>
		<animation_group name="reload" >
			<object name="a_mag_reload" enabled="true" />
		</animation_group>
	</animations>
	<graphics>
		<object name="g_bullet_pr_1" enabled="true" />
		<object name="g_bullet_1" enabled="true" />
		<object name="g_bullet_2" enabled="true" />
		<object name="g_bullet_3" enabled="true" />
		<object name="g_bullet_4" enabled="true" />
		<object name="g_bullet_5" enabled="true" />
		<object name="g_mag" enabled="true" />
	</graphics>
</dynamic_object>
