<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_bow_stampede_ecs_pts/wpn_fps_bow_stampede_ecs_ammo" orientation_object="rp_ammo" />
	<bodies>
	  	<!-- collision_script_tag="bounce" -->
		<body name="dynamic_body" collision_class="projectile" collision_script_filter="0" collision_script_quiet_time="0.0" collision_script_tag="impact" enabled="true" template="small_prop" friction="0.7" sweep="true" restitution="0.4" lin_damping="0" ang_damping="0" pushed_by_mover="false"> 
			<object name="g_dart" enabled="true" collision_type="capsule" mass="0.4"  padding="1.1"/>
			<!--
			<object name="c_box" enabled="true" collision_type="capsule" mass="0.01"  padding="0" />
			<object name="c_sphere" enabled="true" collision_type="sphere" mass="0.39" padding="-2.5" />
			-->
			<!--
			<object name="c_boundingbox" enabled="true" collision_type="convex" mass="0.39" padding="-2.5" />
			-->
		</body>
	</bodies>
  <graphics>
		<object  name="g_dart" enabled="true" />
  </graphics>
</dynamic_object>
