<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/dcpd_resmod/armor_skins/swat_sniper_resmod/swat_sniper_resmod" orientation_object="root_point" />

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="bounding_box_char">
			<object name="g_body" enabled="true"/>
			<object name="g_sniper" enabled="true"/>
			<object name="g_hat_lod1" enabled="true"/>
			<object name="g_hat_lod3" enabled="true"/>

		<!--Balaclava-->
			<object name="g_balaclava" enabled="false"/>

		<!--Heads; Only one should be used at a time and they should only be used alongside g_balaclava_c-->
			<object name="g_head_a" enabled="false"/>
			<object name="g_head_b" enabled="true"/>
			<object name="g_head_c" enabled="false"/>

		<!--Faces; Only one should be used at a time and they should only be used alongside g_balaclava_a or g_balaclava_b-->
			<object name="g_face_a" enabled="false"/>
			<object name="g_face_b" enabled="false"/>
			<object name="g_face_c" enabled="false"/>
			<object name="g_face_d" enabled="false"/>
			<object name="g_face_e" enabled="false"/>

		<!--Gun Holsters-->
			<object name="g_holster_l" enabled="false"/> <!--Left thigh-->
			<object name="g_holster_r" enabled="false"/> <!--Right thigh-->
		</graphic_group>
	</graphics>
</dynamic_object>