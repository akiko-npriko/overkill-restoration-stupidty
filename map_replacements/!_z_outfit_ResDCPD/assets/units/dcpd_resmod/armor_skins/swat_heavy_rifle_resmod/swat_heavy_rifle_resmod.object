<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/dcpd_resmod/armor_skins/swat_heavy_rifle_resmod/swat_heavy_rifle_resmod" orientation_object="root_point" />

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="co_culling">
			<object name="g_body" enabled="true"/>
			<object name="g_swat_heavy_ar" enabled="true"/>
			<object name="g_balaclava" enabled="true"/>
			<object name="g_helmet_lod1" enabled="true"/>
			<object name="g_helmet_lod3" enabled="true"/>

		<!--Faces; Only one should be used at a time-->
			<object name="g_face_a" enabled="true"/>
			<object name="g_face_b" enabled="false"/>
			<object name="g_face_c" enabled="false"/>
			<object name="g_face_d" enabled="false"/>
			<object name="g_face_e" enabled="false"/>

		<!--Crotchpad-->
			<object name="g_crotchpad" enabled="true"/>

		<!--Gun Holsters-->
			<object name="g_holster_l" enabled="false"/> <!--Left thigh-->
			<object name="g_holster_r" enabled="false"/> <!--Right thigh-->
		</graphic_group>
	</graphics>
</dynamic_object>