<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/dcpd_resmod/armor_skins/dcpd_dozer_saiga_resmod/dcpd_dozer_saiga_resmod" orientation_object="root_point" />

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="g_body">
			<object name="g_body_black" enabled="true"/>
			<object name="g_dozer_black" enabled="true"/>
			<object name="g_armor_back" enabled="true"/>
			<object name="g_armor_chest_black" enabled="true"/>
			<object name="g_armor_stomache_black" enabled="true"/>
			<object name="g_neck_black" enabled="true"/>
			<object name="g_throat_b" enabled="true"/>
			<object name="g_helmet_lod2" enabled="true"/>
			<object name="g_helmet_lod4" enabled="true"/>
			<object name="g_helmet_plate_lod2" enabled="true"/>

		<!--Balaclavas; Only one should be used at a time-->
			<object name="g_balaclava_a" enabled="true"/> <!--Exposed mouth-->
			<object name="g_balaclava_b" enabled="false"/> <!--Covered mouth-->

		<!--Faces; Only one should be used at a time-->
			<object name="g_face_a" enabled="false"/>
			<object name="g_face_b" enabled="true"/>
			<object name="g_face_c" enabled="false"/>
			<object name="g_face_d" enabled="false"/>
			<object name="g_face_e" enabled="false"/>
			<object name="g_face_f" enabled="false"/>
			<object name="g_face_g" enabled="false"/>
			<object name="g_face_h" enabled="false"/>
		</graphic_group>
	</graphics>
</dynamic_object>