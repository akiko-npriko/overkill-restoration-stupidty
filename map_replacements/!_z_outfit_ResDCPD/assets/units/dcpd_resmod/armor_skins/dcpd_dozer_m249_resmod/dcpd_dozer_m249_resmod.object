<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/dcpd_resmod/armor_skins/dcpd_dozer_m249_resmod/dcpd_dozer_m249_resmod" orientation_object="root_point" />

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="g_body">
			<object name="g_body" enabled="true"/>
			<object name="g_dozer_skull" enabled="true"/>
			<object name="g_armor_back" enabled="true"/>
			<object name="g_armor_chest_skull" enabled="true"/>
			<object name="g_armor_stomache_skull" enabled="true"/>
			<object name="g_neck_skull" enabled="true"/>
			<object name="g_throat_skull" enabled="true"/>
			<object name="g_helmet" enabled="true"/>
			<object name="g_helmet_glass" enabled="true"/>
			<object name="g_helmet_plate" enabled="true"/>

		<!--Balaclavas; Only one should be used at a time-->
			<object name="g_balaclava_a" enabled="false"/> <!--Exposed mouth-->
			<object name="g_balaclava_b" enabled="true"/> <!--Covered mouth-->

		<!--Faces; Only one should be used at a time-->
			<object name="g_face_a" enabled="false"/>
			<object name="g_face_b" enabled="false"/>
			<object name="g_face_c" enabled="true"/>
			<object name="g_face_d" enabled="false"/>
			<object name="g_face_e" enabled="false"/>
			<object name="g_face_f" enabled="false"/>
			<object name="g_face_g" enabled="false"/>
			<object name="g_face_h" enabled="false"/>
		</graphic_group>
	</graphics>
</dynamic_object>