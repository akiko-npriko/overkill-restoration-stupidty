<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/dcpd_resmod/armor_skins/fbi_light_smg_resmod/fbi_light_smg_resmod" orientation_object="root_point" />

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="co_culling">
			<object name="g_body_shitbag" enabled="true"/>
			<object name="g_swat_smg" enabled="true"/>

		<!--Balaclava-->
			<object name="g_balaclava" enabled="true"/>

		<!--Heads; Only one should be used at a time and they should not be used alongside balaclava-->
			<object name="g_head_a" enabled="false"/>
			<object name="g_head_b" enabled="false"/>
			<object name="g_head_c" enabled="false"/>

		<!--Faces; Only one should be used at a time and they should only be used alongside balaclava-->
			<object name="g_face_a" enabled="false"/>
			<object name="g_face_b" enabled="false"/>
			<object name="g_face_c" enabled="false"/>
			<object name="g_face_d" enabled="true"/>
			<object name="g_face_e" enabled="false"/>

		<!--Goggles; Only one should be used at a time and they should each be used with their corresponding glass-->
			<object name="g_goggles_a" enabled="false"/> <!--Put-down goggles; Use alongside g_glass-->
			<object name="g_glass" enabled="false"/>

			<object name="g_goggles_c" enabled="true"/> <!--Lifted-up goggles; Use alongside g_goggles_c_glass-->
			<object name="g_goggles_c_glass" enabled="true"/>

		<!--Gun Holsters-->
			<object name="g_holster_l" enabled="true"/> <!--Left thigh-->
			<object name="g_holster_r" enabled="false"/> <!--Right thigh-->
		</graphic_group>
	</graphics>

	<effects>
		<effect_spawner name="es_flashlight" enabled="false" object="a_night_helmetlight" effect="effects/particles/weapons/flashlight/flashlight" />
	</effects>

</dynamic_object>