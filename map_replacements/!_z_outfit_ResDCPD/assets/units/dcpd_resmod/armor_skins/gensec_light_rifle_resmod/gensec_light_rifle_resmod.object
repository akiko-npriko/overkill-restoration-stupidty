<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/dcpd_resmod/armor_skins/gensec_light_rifle_resmod/gensec_light_rifle_resmod" orientation_object="root_point" />

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="co_culling">
			<object name="g_body" enabled="true"/>
			<object name="g_swat_ar" enabled="true"/>
			<object name="g_helmet_lod1" enabled="true"/>

		<!--Balaclava-->
			<object name="g_balaclava" enabled="true"/>

		<!--Heads; Only one should be used at a time and they should not be used alongside balaclava-->
			<object name="g_head_a" enabled="false"/>
			<object name="g_head_b" enabled="false"/>
			<object name="g_head_c" enabled="false"/>

		<!--Faces; Only one should be used at a time and they should only be used alongside balaclava-->
			<object name="g_face_a" enabled="true"/>
			<object name="g_face_b" enabled="false"/>
			<object name="g_face_c" enabled="false"/>
			<object name="g_face_d" enabled="false"/>
			<object name="g_face_e" enabled="false"/>

		<!--Goggles; Only one should be used at a time-->
			<object name="g_goggles_a" enabled="false"/> <!--Strap goes inside helmet-->
			<object name="g_helmet_lod3" enabled="true"/> <!--Strap goes around helmet-->

		<!--Goggles Glass; Should be removed if the goggles are removed-->
			<object name="g_glass" enabled="true"/>

		<!--Headset and Chops; Only one should be used at a time-->
			<object name="g_headset" enabled="false"/> <!--Headset-->
			<object name="g_helmet_lod11" enabled="true"/> <!--Chops (mouth guards)-->

		<!--Helmet Flashlight-->
			<object name="g_helmet_lod7" enabled="true"/>

		<!--Gun Holsters-->
			<object name="g_holster_l" enabled="false"/> <!--Left thigh-->
			<object name="g_holster_r" enabled="true"/> <!--Right thigh-->
		</graphic_group>
	</graphics>

	<effects>
		<effect_spawner name="es_flashlight" enabled="false" object="a_night_helmetlight" effect="effects/particles/weapons/flashlight/flashlight" />
	</effects>

</dynamic_object>