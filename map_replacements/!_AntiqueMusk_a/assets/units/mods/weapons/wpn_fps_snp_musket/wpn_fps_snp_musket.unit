<unit type="wpn" slot="1">
	<object file="units/mods/weapons/wpn_fps_snp_musket/wpn_fps_snp_musket"/>
	<dependencies>
		<depends_on bnk="soundbanks/weapon_musket"/>
		<depends_on bnk="soundbanks/weapon_model70"/>
		<depends_on bnk="soundbanks/weapon_sbl"/>
		<depends_on bnk="soundbanks/weapon_coach"/>
		<depends_on effect="effects/mods/weapons/musket/musket_muzzle"/>
	</dependencies>
	<extensions>
		<extension class="ScriptUnitData" name="unit_data"/>
		<extension name="base" class="NewRaycastWeaponBase">
			<var name="name_id" value="musket"/>
		</extension>
	</extensions>
</unit>