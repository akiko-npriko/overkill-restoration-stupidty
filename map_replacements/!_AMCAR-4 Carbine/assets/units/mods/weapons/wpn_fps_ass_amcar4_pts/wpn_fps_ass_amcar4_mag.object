<dynamic_object>
    <diesel orientation_object="rp_amcar4_mag" materials="units/mods/weapons/wpn_fps_ass_amcar4_pts/wpn_fps_ass_amcar4_mag" />
   <animations>
    <animation_group name="reload">
      <object name="mag_align" enabled="true"/>
    </animation_group>    
	<animation_group name="reload_not_empty">
      <object name="mag_align_2" enabled="true"/>
    </animation_group>
  </animations>
  <graphics>
        <object  name="g_mag" enabled="true" />
        <object  name="g_standard_mag" enabled="false" />
        <object  name="g_bullet_1" enabled="true" />
        <object  name="g_bullet_2" enabled="true" />
  </graphics>
</dynamic_object>
