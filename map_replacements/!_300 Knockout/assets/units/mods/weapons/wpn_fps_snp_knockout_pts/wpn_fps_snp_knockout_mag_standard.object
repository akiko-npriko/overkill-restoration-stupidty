<dynamic_object>
    <diesel orientation_object="rp_wpn_fps_snp_msr_m_standard" materials="units/mods/weapons/wpn_fps_snp_knockout_pts/wpn_fps_snp_knockout_mag_standard" />
   <animations>
		<animation_group name="reload">
		  <object name="anim_reload" enabled="true" />
		  <object name="anim_shell_reload" enabled="true" />
		</animation_group>		
		<animation_group name="reload_not_empty">
		  <object name="anim_reload_not_empty" enabled="true" />
		  <object name="anim_shell_reload_not_empty" enabled="true" />
		</animation_group>
		<animation_group name="recoil">
		  <object name="anim_shell_recoil" enabled="true" />
		</animation_group>
	</animations>
    <graphics>
        <object enabled="true" name="g_mag_lod0" />
        <object enabled="true" name="g_shell_lod0" />
        <object enabled="true" name="g_bullet_lod0" />
    </graphics>
</dynamic_object>
