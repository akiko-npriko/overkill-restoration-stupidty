<?xml version="1.0"?>
<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>

		<target mode="append">
			<state name="fps/reload/ks23/enter" type="once" segment="base" speed="1">
				<to name="reload_exit" redirect="fps/reload/ks23/exit"/>
				<to name="reload_not_empty_exit" redirect="fps/reload/ks23/not_empty_exit"/>
				<anim name="ks23_reload_enter"/>
				<keys>
					<key at="trigger" trigger="wp_china_lift_up_gun" callback="play_sound" class_name="base" param1="wp_china_lift_up_gun"/>
					<key at="trigger" trigger="wp_foley_generic_tilt_back" callback="play_sound" class_name="base" param1="wp_foley_generic_tilt_back"/>
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/reload/ks23/loop"/>
			</state>

			<state name="fps/reload/ks23/loop" type="loop" segment="base" speed="1">
				<to name="reload_exit" redirect="fps/reload/ks23/exit"/>
				<to name="reload_not_empty_exit" redirect="fps/reload/ks23/not_empty_exit"/>
				<anim name="ks23_reload_loop"/>
				<keys>
					<key at="enter" callback="anim_clbk_spawn_shotgun_shell" class_name="base"/>
					<key at="loop" callback="anim_clbk_spawn_shotgun_shell" class_name="base"/>
					<key at="enter" callback="enter_shotgun_reload_loop" class_name="base" param1="fps/reload/ks23/loop"/>
					<key at="trigger" trigger="wp_china_push_in_shell" callback="play_sound" class_name="base" param1="wp_china_push_in_shell"/>
					<key at="trigger" trigger="wp_foley_generic_lever_release" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_release"/>
					<key at="trigger" trigger="wp_foley_generic_lever_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_grab"/>
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
					<key at="trigger" trigger="anim_act_01" callback="anim_clbk_unspawn_shotgun_shell" class_name="base"/>
					<key at="exit" callback="anim_clbk_unspawn_shotgun_shell" class_name="base"/>
					<key at="exit" callback="anim_clbk_stop_weapon_reload_all" class_name="base"/>
				</keys>
			</state>

			<state name="fps/reload/ks23/exit" type="once" segment="base" speed="1.0">
				<anim name="ks23_reload_exit"/>
				<keys>
					<key at="trigger" trigger="wp_china_pull_handle" callback="play_sound" class_name="base" param1="wp_china_pull_handle"/>
					<key at="trigger" trigger="wp_china_push_handle" callback="play_sound" class_name="base" param1="wp_china_push_handle"/>
					<key at="trigger" trigger="wp_foley_generic_lever_release" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_release"/>
					<key at="trigger" trigger="wp_foley_generic_lever_pull"  callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
					<key at="trigger" trigger="wp_foley_generic_back_in_hand" callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
					<key at="exit" callback="anim_clbk_stop_weapon_reload_all" class_name="base"/>
				</keys>
				<exit name="fps/idle"/>
			</state>

			<state name="fps/reload/ks23/not_empty_exit" type="once" segment="base" speed="1.0">
				<anim name="ks23_reload_not_empty_exit"/>
				<keys>
					<key at="trigger" trigger="wp_foley_generic_clip_in_connect" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_in_connect"/>
					<key at="trigger" trigger="wp_foley_generic_lever_pull"  callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
					<key at="trigger" trigger="wp_foley_generic_back_in_hand" callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
					<key at="exit" callback="anim_clbk_stop_weapon_reload_all" class_name="base"/>
				</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>

