			<object name="anim_bolt_recoil" enabled="true"/>
			<object name="anim_pump_recoil" enabled="true"/>
			<object name="anim_shell_recoil" enabled="true"/>
			<object name="anim_shell_empty_recoil" enabled="true"/>
		</animation_group>
		<animation_group name="reload_enter">
			<object name="anim_feed_ramp_reload_enter" enabled="true"/>
			<object name="anim_shell_reload_enter" enabled="true"/>
		</animation_group>
		<animation_group name="reload_exit">
			<object name="anim_bolt_reload_exit" enabled="true"/>
			<object name="anim_pump_reload_exit" enabled="true"/>
			<object name="anim_shell_reload_exit" enabled="true"/>
			<object name="anim_shell_empty_reload_exit" enabled="true"/>
		</animation_group>
	</animations>
</dynamic_object>