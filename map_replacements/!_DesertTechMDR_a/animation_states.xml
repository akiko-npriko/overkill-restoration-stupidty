<?xml version="1.0"?>
<tweaks>	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps"/>
		</search>
		<target mode="attach">
			<to name="reload_mdr_308" 				 	redirect="fps/reload/mdr_308"/>
			<to name="reload_not_empty_mdr_308" 		redirect="fps/reload_not_empty/mdr_308"/>
			<to name="underbarrel_reload_mdr_308"		redirect="fps/reload/underbarrel/mdr_308"/>
			<to name="underbarrel_enter_mdr_308"		redirect="fps/enter/underbarrel/mdr_308"/>
			<to name="underbarrel_exit_mdr_308"			redirect="fps/exit/underbarrel/mdr_308"/>
		</target>
	</tweak>

	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/idle"/>
			<anim name="m4_idle" weight="m4"/>
		</search>
		<target mode="append">
			<anim name="mdr_308_idle" weight="mdr_308 * (1-steelsight_weight)"/>
			<anim name="mdr_308_underbarrel_idle" weight="mdr_308_underbarrel * (1-steelsight_weight)"/>
		</target>
	</tweak>

	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">
			<state name="fps/reload/mdr_308" type="once" segment="base" speed="1.0">
				<anim name="mdr_308_reload"/>
				<keys>
					<key at="enter" callback="anim_clbk_stop_weapon_magazine_empty" class_name="base" param1="reload"/>	
					<key at="trigger" trigger="wp_mdr_start" callback="play_sound" class_name="base" param1="wp_mdr_start"/>
					<key at="trigger" trigger="wp_mdr_boltgrab" callback="play_sound" class_name="base" param1="wp_mdr_boltgrab"/>
					<key at="trigger" trigger="wp_mdr_boltback" callback="play_sound" class_name="base" param1="wp_mdr_boltback"/>
					<key at="trigger" trigger="wp_mdr_foley1" callback="play_sound" class_name="base" param1="wp_mdr_foley1"/>
					<key at="trigger" trigger="wp_mdr_magrelease" callback="play_sound" class_name="base" param1="wp_mdr_magrelease"/>
					<key at="trigger" trigger="wp_mdr_magout" callback="play_sound" class_name="base" param1="wp_mdr_magout"/>
					<key at="trigger" trigger="wp_mdr_maggrab" callback="play_sound" class_name="base" param1="wp_mdr_maggrab"/>
					<key at="trigger" trigger="wp_mdr_magraise" callback="play_sound" class_name="base" param1="wp_mdr_magraise"/>
					<key at="trigger" trigger="wp_mdr_magtapin" callback="play_sound" class_name="base" param1="wp_mdr_magtapin"/>
					<key at="trigger" trigger="wp_mdr_magin" callback="play_sound" class_name="base" param1="wp_mdr_magin"/>
					<key at="trigger" trigger="wp_mdr_magfoley" callback="play_sound" class_name="base" param1="wp_mdr_magfoley"/>
					<key at="trigger" trigger="wp_mdr_maghit" callback="play_sound" class_name="base" param1="wp_mdr_maghit"/>
					<key at="trigger" trigger="wp_mdr_boltforward" callback="play_sound" class_name="base" param1="wp_mdr_boltforward"/>
					<key at="trigger" trigger="wp_mdr_handtransition" callback="play_sound" class_name="base" param1="wp_mdr_handtransition"/>
					<key at="trigger" trigger="wp_mdr_grab" callback="play_sound" class_name="base" param1="wp_mdr_grab"/>
					<key at="trigger" trigger="show_bullets" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle"/>
			</state>

			<state name="fps/reload_not_empty/mdr_308" type="once" segment="base" speed="1.0">
				<anim name="mdr_308_reload_not_empty"/>
				<keys>
					<key at="enter" callback="anim_clbk_stop_weapon_magazine_empty" class_name="base" param1="reload"/>	
					<key at="trigger" trigger="wp_mdr_start" callback="play_sound" class_name="base" param1="wp_mdr_start"/>
					<key at="trigger" trigger="wp_mdr_foley1" callback="play_sound" class_name="base" param1="wp_mdr_foley1"/>
					<key at="trigger" trigger="wp_mdr_magrelease" callback="play_sound" class_name="base" param1="wp_mdr_magrelease"/>
					<key at="trigger" trigger="wp_mdr_magout" callback="play_sound" class_name="base" param1="wp_mdr_magout"/>
					<key at="trigger" trigger="wp_mdr_maggrab" callback="play_sound" class_name="base" param1="wp_mdr_maggrab"/>
					<key at="trigger" trigger="wp_mdr_magraise" callback="play_sound" class_name="base" param1="wp_mdr_magraise"/>
					<key at="trigger" trigger="wp_mdr_magtapin" callback="play_sound" class_name="base" param1="wp_mdr_magtapin"/>
					<key at="trigger" trigger="wp_mdr_magin" callback="play_sound" class_name="base" param1="wp_mdr_magin"/>
					<key at="trigger" trigger="wp_mdr_magfoley" callback="play_sound" class_name="base" param1="wp_mdr_magfoley"/>
					<key at="trigger" trigger="wp_mdr_maghit" callback="play_sound" class_name="base" param1="wp_mdr_maghit"/>
					<key at="trigger" trigger="wp_mdr_handtransition" callback="play_sound" class_name="base" param1="wp_mdr_handtransition"/>
					<key at="trigger" trigger="wp_mdr_grab" callback="play_sound" class_name="base" param1="wp_mdr_grab"/>
					<key at="trigger" trigger="gl_casing_land_hard" callback="play_sound" class_name="base" param1="gl_casing_land_hard"/>
					<key at="trigger" trigger="show_bullets" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle"/>
			</state>















			<state name="fps/enter/underbarrel/mdr_308" type="once" segment="base" speed="1.0">
				<anim name="mdr_308_underbarrel_enter"/>
				<keys>
					<key at="trigger" trigger="wp_foley_generic_tilt" callback="play_sound" class_name="base" param1="wp_foley_generic_tilt"/>
					<key at="trigger" trigger="selector_switch" callback="play_sound" class_name="base" param1="arbiter_push_button"/>
					<key at="trigger" trigger="wp_foley_generic_tilt_back" callback="play_sound" class_name="base" param1="wp_foley_generic_tilt_back"/>
				</keys>
				<exit name="fps/idle/underbarrel/mdr_308"/>
			</state>

			<state name="fps/exit/underbarrel/mdr_308" type="once" segment="base" speed="1.0">
				<anim name="mdr_308_underbarrel_exit"/>
				<keys>
					<key at="trigger" trigger="wp_foley_generic_tilt" callback="play_sound" class_name="base" param1="wp_foley_generic_tilt"/>
					<key at="trigger" trigger="selector_switch" callback="play_sound" class_name="base" param1="arbiter_push_button"/>
					<key at="trigger" trigger="wp_foley_generic_tilt_back" callback="play_sound" class_name="base" param1="wp_foley_generic_tilt_back"/>
				</keys>
				<exit name="fps/idle"/>
			</state>

			<state name="fps/equip/underbarrel/mdr_308" type="mix" segment="base" speed="1.0">
				<anim name="mdr_308_underbarrel_equip"/>
			</state>

			<state name="fps/unequip/underbarrel/mdr_308" type="mix" segment="base" speed="1.0">
				<anim name="mdr_308_underbarrel_unequip"/>
			</state>

			<state name="fps/start_running/underbarrel/mdr_308" type="mix" segment="base" speed="1.0">
				<anim name="mdr_308_underbarrel_sprint_enter"/>
				<exit name="fps/running/underbarrel/mdr_308"/>
			</state>

			<state name="fps/running/underbarrel/mdr_308" type="mixloop" segment="base" speed="1.0">
				<anim name="mdr_308_underbarrel_sprint"/>
			</state>

			<state name="fps/stop_running/underbarrel/mdr_308" type="mix" segment="base" speed="2.0">
				<anim name="mdr_308_underbarrel_sprint_exit"/>
				<exit name="fps/idle/underbarrel/mdr_308"/>
			</state>

			<state name="fps/melee/underbarrel/mdr_308" type="mix" segment="base" speed="1.0">
				<anim name="mdr_308_underbarrel_melee"/>
				<keys>
					<key at="enter" callback="anim_clbk_stop_weapon_anim" class_name="base" param1="reload"/>
					<key at="enter" callback="play_sound" class_name="base" param1="m4_melee_attack"/>
				</keys>
				<exit name="fps/idle/underbarrel/mdr_308"/>
			</state>

			<state name="fps/melee_miss/underbarrel/mdr_308" type="mix" segment="base" speed="1.0">
				<anim name="mdr_308_underbarrel_melee_miss"/>
				<keys>
					<key at="enter" callback="anim_clbk_stop_weapon_anim" class_name="base" param1="reload"/>
					<key at="enter" callback="play_sound" class_name="base" param1="m4_melee_attack"/>
				</keys>
				<exit name="fps/idle/underbarrel/mdr_308"/>
			</state>

			<state name="fps/idle/underbarrel/mdr_308" type="mixloop" segment="base" speed="1.0">
				<anim name="mdr_308_underbarrel_idle"/>
			</state>

			<state name="fps/recoil/underbarrel/mdr_308" type="mixloop" segment="base" speed="1.0">
				<anim name="mdr_308_underbarrel_recoil"/>
			</state>

			<state name="fps/recoil_enter/underbarrel/mdr_308" type="once" segment="base" speed="1.0">
				<anim name="mdr_308_underbarrel_recoil_enter"/>
				<exit name="fps/idle/underbarrel/mdr_308"/>
			</state>

			<state name="fps/recoil_exit/underbarrel/mdr_308" type="once" segment="base" speed="1.0">
				<anim name="mdr_308_underbarrel_recoil_exit"/>
				<exit name="fps/idle/underbarrel/mdr_308"/>
			</state>

			<state name="fps/recoil_loop/underbarrel/mdr_308" type="mixloop" segment="base" speed="1.0">
				<anim name="mdr_308_underbarrel_recoil_loop"/>
			</state>

			<state name="fps/reload/underbarrel/mdr_308" type="once" segment="base" speed="1.0">
				<anim name="mdr_308_underbarrel_reload"/>
				<keys>
					<key at="trigger" trigger="wp_eglm_start" callback="play_sound" class_name="base" param1="wp_eglm_start"/>
					<key at="trigger" trigger="wp_mdr_magrelease" callback="play_sound" class_name="base" param1="wp_mdr_magrelease"/>
					<key at="trigger" trigger="wp_eglm_tubeopen" callback="play_sound" class_name="base" param1="eglm_tube_open"/>
					<key at="trigger" trigger="wp_eglm_openfoley" callback="play_sound" class_name="base" param1="wp_eglm_openfoley"/>
					<key at="trigger" trigger="wp_eglm_tubespin" callback="play_sound" class_name="base" param1="wp_eglm_tubespin"/>
					<key at="trigger" trigger="wp_eglm_insert" callback="play_sound" class_name="base" param1="wp_eglm_insert"/>
					<key at="trigger" trigger="wp_eglm_shellfoley" callback="play_sound" class_name="base" param1="wp_eglm_shellfoley"/>
					<key at="trigger" trigger="wp_eglm_tubeclose" callback="play_sound" class_name="base" param1="eglm_tube_close"/>
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle/underbarrel/mdr_308"/>
			</state>
		</target>
	</tweak>

