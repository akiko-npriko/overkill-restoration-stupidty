<mod name="Helldivers 2 - R-2 Amendment">

	<Localization directory="loc" default="english.txt"/>

	<AssetIGNOREMEUpdates id="52300" version="1.1" provider="modworkshop"/>

	<GlobalValue id="ceremony_mod" color="Color(0.0, 0.5, 1.0)"/>

	<AddFiles directory="assets" auto_generate="true"/>

	<Hooks directory="hooks">
		<hook file="weaponfactorytweakdata.lua" source_file="lib/tweak_data/weaponfactorytweakdata"/>
		<hook file="weapontweakdata.lua" source_file="lib/tweak_data/weapontweakdata"/>
		<hook file="HD2DiscardMagOnReload.lua" source_file="lib/units/weapons/raycastweaponbase"/>
	</Hooks>

	<Sounds directory="assets/sounds">
		<sound id="r2_fire_single" path="r2_fire_single.ogg" prefix="regular"/>

		<sound id="r2_handle_pull" path="r2_handle_pull.ogg" prefix="first"/>
		<sound id="r2_handle_pull" path="r2_handle_pull.ogg" prefix="third"/>
		<sound id="r2_handle_release" path="r2_handle_release.ogg" prefix="first"/>
		<sound id="r2_handle_release" path="r2_handle_release.ogg" prefix="third"/>
		<sound id="r2_mag_contact" path="r2_mag_contact.ogg" prefix="first"/>
		<sound id="r2_mag_contact" path="r2_mag_contact.ogg" prefix="third"/>
		<sound id="r2_mag_in" path="r2_mag_in.ogg" prefix="first"/>
		<sound id="r2_mag_in" path="r2_mag_in.ogg" prefix="third"/>
		<sound id="r2_mag_in_empty" path="r2_mag_in_empty.ogg" prefix="first"/>
		<sound id="r2_mag_in_empty" path="r2_mag_in_empty.ogg" prefix="third"/>
		<sound id="r2_mag_out" path="r2_mag_out.ogg" prefix="first"/>
		<sound id="r2_mag_out" path="r2_mag_out.ogg" prefix="third"/>
		<sound id="r2_mag_out_empty" path="r2_mag_out_empty.ogg" prefix="first"/>
		<sound id="r2_mag_out_empty" path="r2_mag_out_empty.ogg" prefix="third"/>
	</Sounds>

  <!-- R-2 Amendment - Parts -->

	<WeaponMod id="wpn_fps_ass_r2_barrel" type="barrel" based_on="wpn_fps_ass_flint_b_standard" unit="units/mods/weapons/wpn_fps_ass_r2_pts/wpn_fps_ass_r2_barrel" hidden="true" ver="2"/>

	<WeaponMod id="wpn_fps_ass_r2_bayonet" type="bayonet" based_on="wpn_fps_snp_mosin_ns_bayonet" unit="units/mods/weapons/wpn_fps_ass_r2_pts/wpn_fps_ass_r2_bayonet" hidden="true" ver="2">
	   <stats concealment="0"/>
	</WeaponMod>

	<WeaponMod id="wpn_fps_ass_r2_muzzle" type="barrel_ext" based_on="wpn_fps_ass_flint_ns_standard" unit="units/mods/weapons/wpn_fps_ass_r2_pts/wpn_fps_ass_r2_muzzle" hidden="true" ver="2"/>

	<WeaponMod id="wpn_fps_ass_r2_mag" type="magazine" based_on="wpn_fps_ass_flint_m_standard" unit="units/mods/weapons/wpn_fps_ass_r2_pts/wpn_fps_ass_r2_mag" hidden="true" ver="2">
	   <bullet_objects prefix="g_bullet_" amount="3"/>
	</WeaponMod>

	<WeaponMod id="wpn_fps_ass_r2_receiver" type="upper_reciever" based_on="wpn_fps_ass_flint_body_upperreceiver" unit="units/mods/weapons/wpn_fps_ass_r2_pts/wpn_fps_ass_r2_receiver" hidden="true" ver="2"/>
	
	<WeaponMod id="wpn_fps_ass_r2_scope_default" based_on="wpn_fps_upg_o_aimpoint" type="sight" a_obj="a_o" steelsight_visible="false" unit="units/mods/weapons/wpn_fps_ass_r2_scope_default/wpn_fps_ass_ar23_optic" hidden="true" ver="2">
		<stats damage="0" spread="0"  recoil="0" concealment="0"/>
		<adds>
			<value_node value="wpn_fps_ass_r2_scope_default_steelsight"/>
		</adds>
	</WeaponMod>

    <WeaponMod id="wpn_fps_ass_r2_scope_default_steelsight" based_on="wpn_fps_upg_o_specter_steelsight" unit="units/mods/weapons/wpn_fps_ass_r2_scope_default/wpn_fps_ass_ar23_optic_steelsight" hidden="true" ver="2"/>

  <!-- R-2 Amendment - Factory -->

	<Weapon unlock_level="35">

		<weapon id="r2" based_on="new_m14" weapon_hold="r2" FIRE_MODE="single" CAN_TOGGLE_FIREMODE="true" has_description="true" desc_id="bm_w_r2_desc" texture_bundle_folder="mods" NR_CLIPS_MAX="8" CLIP_AMMO_MAX="20" global_value="ceremony_mod">

			<stats damage="200" spread="21" spread_moving="18" recoil="11" concealment="12"/>

			<fire_mode_data fire_rate="0.125">
			    <toggable>
				   <value_node value="single"/>
				   <value_node value="burst"/>
				</toggable>
			</fire_mode_data>

			<AMMO_PICKUP>
                <value_node value="1.45"/>
                <value_node value="3.00"/>
            </AMMO_PICKUP>
			<kick> 
				<standing> 
					<value_node value="1.8"/>  
					<value_node value="2.0"/>  
					<value_node value="-1.0"/>  
					<value_node value="1.0"/> 
				</standing>
				<crouching>
					<value_node value="1.6"/>  
					<value_node value="1.7"/>  
					<value_node value="-0.7"/> 
					<value_node value="0.7"/>  
				</crouching>
				<steelsight>
					<value_node value="1.1"/> 		 
					<value_node value="1.2"/>  
					<value_node value="-0.6"/>  
					<value_node value="0.6"/>  
				</steelsight>
			</kick>

			<timers reload_empty="2.9" reload_not_empty="1.8" equip="0.6" unequip="0.6"/>

			<sounds fire="r2_fire_single" fire_auto="r2_fire_single" fire_single="r2_fire_single" use_fix="true"/>

			<animations reload_name_id="r2"/>

		</weapon>

		<factory id="wpn_fps_ass_r2" unit="units/mods/weapons/wpn_fps_ass_r2/wpn_fps_ass_r2">

			<animations/>

			<adds/>

		    <override>
			   <wpn_fps_ass_r2_muzzle parent="barrel" a_obj="a_ns"/>
			</override>

			<default_blueprint>
				<value_node value="wpn_fps_ass_r2_barrel"/>
				<value_node value="wpn_fps_ass_r2_bayonet"/>
				<value_node value="wpn_fps_ass_r2_muzzle"/>
				<value_node value="wpn_fps_ass_r2_mag"/>
				<value_node value="wpn_fps_ass_r2_receiver"/>
				<value_node value="wpn_fps_ass_r2_scope_default"/>
			</default_blueprint>

			<uses_parts>
				<value_node value="wpn_fps_ass_r2_barrel"/>
				<value_node value="wpn_fps_ass_r2_bayonet"/>
				<value_node value="wpn_fps_ass_r2_muzzle"/>
				<value_node value="wpn_fps_ass_r2_mag"/>
				<value_node value="wpn_fps_ass_r2_receiver"/>
				<value_node value="wpn_fps_ass_r2_scope_default"/>
			</uses_parts>

		</factory>

		<stance>
			<standard>
				<shoulders rotation="8.72665e-006 -0 0 -1" translation="-1.032 -5.999 -0.434"/>
			</standard>
			<crouched>
				<shoulders rotation="8.72366e-006 0.0261769 2.28437e-007 -0.999657" translation="-1.032 -5.999 -1.934"/>
			</crouched>
			<steelsight>
				<shoulders rotation="8.72665e-006 -0 0 -1" translation="-8.608 -7.999 5.166"/>
			</steelsight>
		</stance>

	</Weapon>
</mod>