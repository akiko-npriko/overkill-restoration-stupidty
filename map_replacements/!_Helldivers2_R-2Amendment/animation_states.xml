<?xml version="1.0"?>

<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps"/>
		</search>
		<target mode="attach">
			<to name="reload_r2" 						redirect="fps/reload/r2"/>
			<to name="reload_not_empty_r2" 			redirect="fps/reload_not_empty/r2"/>
		</target>
	</tweak>
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">
			<state name="fps/reload/r2" type="once" segment="base" speed="1.0">
				<anim name="r2_reload"/>
					<keys>
						
						<key at="enter" callback="anim_clbk_stop_weapon_magazine_empty" 		class_name="base" param1="reload"/>	
						<key at="trigger" trigger="wp_foley_generic_back_in_hand" 			    callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
						<key at="trigger" trigger="bullet_show" 								callback="anim_clbk_check_bullet_object" class_name="base" />

						<!--<key at="trigger" trigger="r2_start_foley"                          callback="play_sound" class_name="base" param1="wp_flint_release_hand"/>-->
						<key at="trigger" trigger="r2_mag_grab"                                 callback="play_sound" class_name="base" param1="r2_mag_grab"/>
						<key at="trigger" trigger="r2_magout"                                   callback="play_sound" class_name="base" param1="r2_mag_out_empty"/>
						<key at="trigger" trigger="r2_mag_hit_ground"                           callback="play_sound" class_name="base" param1="wp_foley_generic_clip_throw"/>
						<key at="trigger" trigger="r2_grab_new_mag"                             callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
						<key at="trigger" trigger="r2_mag_contact"                              callback="play_sound" class_name="base" param1="r2_mag_contact"/>
						<key at="trigger" trigger="r2_magin"                                    callback="play_sound" class_name="base" param1="r2_mag_in_empty"/>
						<key at="trigger" trigger="r2_mag_slap"                                 callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand_soft"/>
						<key at="trigger" trigger="r2_tilt_foley"                               callback="play_sound" class_name="base" param1="wp_ak47_tilt"/>
						<key at="trigger" trigger="r2_back_in_hand"                             callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
						<key at="trigger" trigger="r2_bolt_pull"                                callback="play_sound" class_name="base" param1="r2_handle_pull"/>
						<key at="trigger" trigger="r2_bolt_release"                             callback="play_sound" class_name="base" param1="r2_handle_release"/>
						<key at="trigger" trigger="r2_tilt_last_foley"                          callback="play_sound" class_name="base" param1="wp_ak47_tilt_back"/>
						<!--<key at="trigger" trigger="r2_end_foley"                            callback="play_sound" class_name="base" param1="wp_flint_release_hand"/>-->

					</keys>
					<exit name="fps/idle"/>
				</state>
			
			
			<state name="fps/reload_not_empty/r2" type="once" segment="base" speed="1.0">
				<anim name="r2_reload_not_empty"/>
				<keys>		

						<key at="trigger" trigger="wp_foley_generic_back_in_hand" 			    callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
						<key at="trigger" trigger="bullet_show" 								callback="anim_clbk_check_bullet_object" class_name="base" />

						<!--<key at="trigger" trigger="r2_start_foley"                          callback="play_sound" class_name="base" param1="wp_flint_release_hand"/>-->
						<key at="trigger" trigger="r2_mag_grab"                                 callback="play_sound" class_name="base" param1="r2_mag_grab"/>
						<key at="trigger" trigger="r2_magout"                                   callback="play_sound" class_name="base" param1="r2_mag_out"/>
						<key at="trigger" trigger="r2_mag_hit_ground"                           callback="play_sound" class_name="base" param1="wp_foley_generic_clip_throw"/>
						<key at="trigger" trigger="r2_grab_new_mag"                             callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
						<key at="trigger" trigger="r2_mag_contact"                              callback="play_sound" class_name="base" param1="r2_mag_contact"/>
						<key at="trigger" trigger="r2_magin"                                    callback="play_sound" class_name="base" param1="r2_mag_in"/>
						<key at="trigger" trigger="r2_mag_slap"                                 callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand_soft"/>
						<key at="trigger" trigger="r2_tilt_foley"                               callback="play_sound" class_name="base" param1="wp_ak47_tilt"/>
						<key at="trigger" trigger="r2_back_in_hand"                             callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
						<key at="trigger" trigger="r2_bolt_pull"                                callback="play_sound" class_name="base" param1="r2_handle_pull"/>
						<key at="trigger" trigger="r2_bolt_release"                             callback="play_sound" class_name="base" param1="r2_handle_release"/>
						<key at="trigger" trigger="r2_tilt_last_foley"                          callback="play_sound" class_name="base" param1="wp_ak47_tilt_back"/>
						<!--<key at="trigger" trigger="r2_end_foley"                            callback="play_sound" class_name="base" param1="wp_flint_release_hand"/>-->
						
				</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>

