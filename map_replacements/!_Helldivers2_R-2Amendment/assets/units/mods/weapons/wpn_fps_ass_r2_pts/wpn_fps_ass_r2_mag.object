<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_ass_r2_pts/wpn_fps_ass_r2_mag" orientation_object="rp_magazine" />
		<animations>
		<animation_group name="reload">
			<object name="a_reload_mag" enabled="true"/>
		</animation_group>
		<animation_group name="reload_not_empty">
			<object name="a_reload_ne_mag" enabled="true"/>
		</animation_group>
	</animations>
	<graphics>
		<object name="g_mag" enabled="true" />
		<object name="g_bullet_1" enabled="true" />
		<object name="g_bullet_2" enabled="true" />
		<object name="g_bullet_3" enabled="true" />
	</graphics>
</dynamic_object>
