<dynamic_object>
    <diesel orientation_object="rp_secret_stash_stove" materials="units/world/architecture/secret_stash/props/secret_stash_counters_cupboards" />
	
	<bodies>		
		<body name="static_body" remove_ray_type="walk" enabled="true" template="static">
			<object name="rp_secret_stash_stove"/>
			<object name="c_box_01" collision_type="box" padding="-2.5"/>
			<object name="c_box_02" collision_type="box" padding="-2.5"/>
		</body>
	</bodies>

	<decal_surfaces default_material="thin_layer" enabled="true">
		<decal_mesh name="dm_metal" enabled="true" material="sheet_metal" />
		<decal_mesh name="dm_glass" enabled="true" material="glass_breakable" />
	</decal_surfaces>
	
    <graphics>
        <object enabled="true" name="g_secret_stash_stove" />
        <object enabled="true" name="s_secret_stash_stove" shadow_caster="true"/>
    </graphics>
	
</dynamic_object>
