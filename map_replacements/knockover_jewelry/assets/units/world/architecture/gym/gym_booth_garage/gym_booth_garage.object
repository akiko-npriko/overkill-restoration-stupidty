<?xml version="1.0"?>
<dynamic_object>
  <diesel materials="units/world/architecture/gym/gym_booth_garage/gym_booth_garage" orientation_object="rp_gym_booth_garage" />
  <sequence_manager file="units/world/architecture/gym/gym_booth_garage/gym_booth_garage" />
  <bodies>
    <body name="base" enabled="true" template="static">
      <object name="rp_gym_booth_garage" />
      <object name="c_base" collision_type="mesh_mopp" />
    </body>
    <body name="boom_broken" enabled="false" template="static">
      <object name="dm_boom_broken" collision_type="mesh_mopp" />
    </body>
    <body name="boom_up" enabled="true" template="raycoll_static">
      <object name="dm_boom_up" collision_type="mesh_mopp" />
    </body>
  </bodies>
  
  <decal_surfaces default_material="metal">
    <decal_mesh name="dm_metal"   enabled="true" material="metal" />
    <decal_mesh name="dm_boom_up" enabled="true" material="wood" />
    <decal_mesh name="dm_boom_broken" enabled="false" material="wood" />
	<decal_mesh name="g_glass" enabled="true" material="glass_unbreakable" />
  </decal_surfaces>
  
  <graphics>
    <object name="s_base" enabled="true" shadow_caster="true"/>
    <object name="s_boom_up" enabled="true" shadow_caster="true"/>
    <object name="g_base" enabled="true"/>
    <object name="g_glass" enabled="true"/>
    <object name="g_boom_up" enabled="true"/>
    <object name="g_boom_broken" enabled="false"/>
  </graphics>
</dynamic_object> 