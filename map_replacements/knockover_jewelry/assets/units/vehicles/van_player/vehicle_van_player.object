<?xml version="1.0"?>
<dynamic_object>
  <diesel materials="units/vehicles/van_player/vehicle_van_player" orientation_object="rp_van_player" />
  <sequence_manager file="units/pd2_dlc_run/props/run_vehicle_van_street_burning_man_event/run_vehicle_van_player" />
  <animations>
	<animation_group name="ag_left_door">
      <object name="a_left_door" />
    </animation_group>
	<animation_group name="ag_right_door">
      <object name="a_right_door" />
    </animation_group>
    <animation_group name="ag_tire_front_right">
      <object name="a_tire_front_right" />
    </animation_group>
    <animation_group name="ag_tire_front_left">
      <object name="a_tire_front_left" />
    </animation_group>
    <animation_group name="ag_tire_rear_right">
      <object name="a_tire_rear_right" />
    </animation_group>
    <animation_group name="ag_tire_rear_left">
      <object name="a_tire_rear_left" />
    </animation_group>
    <animation_group name="doors" enabled="true" speed="0" time="0/30" end_time="20/30" >
      <object name="a_door_back_left" />
      <object name="a_door_back_right" />
    </animation_group>
	
	<animation_group name="doors_left" enabled="false" >
      <object name="a_door_back_left" />
    </animation_group>
	
	<animation_group name="doors_right" enabled="false"  >
      <object name="a_door_back_right" />
    </animation_group>
	
	<animation_group name="explode_rear_doors" enabled="false" >
      <object name="explode_body" />
      <object name="explode_wheels" />
    </animation_group>
  </animations>
 <bodies>
	
    <body name="van_player" enabled="true" template="static">
	  <object name="rp_van_player" />
      <object name="c_van_player" collision_type="mesh_mopp" />
    </body>
	<body name="graph_blocker" enabled="true" template="graph_blocker">
      <object name="c_graph_blocker" collision_type="box" />
	</body>
	<body name="tire_front_right" enabled="true" template="static">
      <object name="c_tire_front_right" collision_type="mesh_mopp" />
    </body>
	<body name="tire_front_left" enabled="true" template="static">
      <object name="c_tire_front_left" collision_type="mesh_mopp" />
    </body>
	<body name="tire_rear_left" enabled="true" template="static">
      <object name="c_tire_rear_left" collision_type="mesh_mopp" />
    </body>
		<body name="tire_rear_right" enabled="true" template="static">
      <object name="c_tire_rear_right" collision_type="mesh_mopp" />
    </body>
	<body name="rim_front_right" enabled="true" template="static">
	  <object name="c_tire_rim_front_right" collision_type="mesh_mopp" />
    </body>
	<body name="rim_front_left" enabled="true" template="static">
	  <object name="c_tire_rim_front_left" collision_type="mesh_mopp" />
    </body>
	<body name="rim_rear_right" enabled="true" template="static">
	  <object name="c_tire_rim_rear_right" collision_type="mesh_mopp" />
    </body>
    <body name="rim_rear_left" enabled="true" template="static">
	  <object name="c_tire_rim_rear_left" collision_type="mesh_mopp" />
    </body>
	<body name="c_van_player" enabled="true" template="static">
      <object name="c_van_player" collision_type="mesh_mopp" />
    </body>
    <body remove_ray_type="ai_vision" name="window_left_front1" enabled="true" template="static">
      <object name="c_window_left_front1" collision_type="mesh_mopp"  two_sided="true"/>
    </body>
    <body remove_ray_type="ai_vision" name="window_left_front2" enabled="true" template="static">
      <object name="c_window_left_front2" collision_type="mesh_mopp"  two_sided="true"/>
    </body>
    <body remove_ray_type="ai_vision" name="window_right_front1" enabled="true" template="static">
      <object name="c_window_right_front1" collision_type="mesh_mopp"  two_sided="true"/>
    </body>
    <body remove_ray_type="ai_vision" name="window_right_front2" enabled="true" template="static">
      <object name="c_window_right_front2" collision_type="mesh_mopp"  two_sided="true"/>
    </body>
    <body name="window_front" enabled="true" template="static">
      <object name="c_window_front" collision_type="mesh_mopp"  two_sided="true"/>
    </body>
    <body remove_ray_type="ai_vision" name="window_back_left" enabled="true" template="animated">
      <object name="c_window_back_left" collision_type="mesh_mopp"  two_sided="true"/>
    </body>
    <body remove_ray_type="ai_vision" name="window_back_right" enabled="true" template="animated">
      <object name="c_window_back_right" collision_type="mesh_mopp"  two_sided="true"/>
    </body>
    <body name="door_back_right" enabled="true" template="animated">
      <object name="a_door_back_right" />
	  <object name="c_door_back_right" collision_type="mesh_mopp" />
    </body>
    <body name="door_back_left" enabled="true" template="animated">
	  <object name="a_door_back_left" />
      <object name="c_door_back_left" collision_type="mesh_mopp" />
    </body>
	<body name="left_door" enabled="true" template="animated">
	  <object name="a_left_door" />
      <object name="c_left_door" collision_type="mesh_mopp" />
	</body>
	<body name="right_door" enabled="true" template="animated">
	  <object name="a_right_door" />
      <object name="c_right_door" collision_type="mesh_mopp" />
    </body>
  </bodies>
  <decal_surfaces default_material="metal">
    <decal_mesh name="dm_window_left_front1" enabled="true" material="glass_breakable" />
    <decal_mesh name="dm_window_left_front2" enabled="true" material="glass_breakable" />
    <decal_mesh name="dm_window_right_front1" enabled="true" material="glass_breakable" />
    <decal_mesh name="dm_window_right_front2" enabled="true" material="glass_breakable" />
    <decal_mesh name="dm_window_front" enabled="true" material="glass_breakable" />
    <decal_mesh name="dm_window_back_left" enabled="true" material="glass_breakable" />
    <decal_mesh name="dm_window_back_right" enabled="true" material="glass_breakable" />
    <decal_mesh name="dm_door_back_right" enabled="true" material="metal_chassis" />
    <decal_mesh name="dm_door_back_left" enabled="true" material="metal_chassis" />
	<decal_mesh name="dm_left_door" enabled="true" material="metal_chassis" />
	<decal_mesh name="dm_right_door" enabled="true" material="metal_chassis" />
	<decal_mesh name="dm_van_player" enabled="true" material="metal_chassis" />
  </decal_surfaces>
  
  
  
  <graphics>
    <lod_object name="player_van">
        <object name="g_van_player" max_distance="5000" lod="0" enabled="true" />
        <object name="g_van_player_lod" lod="1" enabled="true" />
    </lod_object>
    <lod_object name="player_van_interior">
        <object name="g_van_player_interior" max_distance="5000" lod="0" enabled="true" />
