  </graphics>
  <objects>
    <align_point name="e_glass_left" enabled="true" parent="rp_van_player" position="0 0 0" rotation="0 0 0" />
    <align_point name="e_glass_right" enabled="true" parent="rp_van_player" position="0 0 0" rotation="0 0 0" />
