    </lod_object> 
    <lod_object name="player_van_tires">
        <object name="g_van_tires" max_distance="5000" lod="0" enabled="true" />
		<object name="g_van_tires_lod" lod="1" enabled="true" />
    </lod_object> 
	<lod_object name="right_door">
        <object name="g_right_door" max_distance="5000" lod="0" enabled="true" />
		<object name="g_right_door_lod" lod="1"  enabled="true" />
    </lod_object> 
	 <lod_object name="left_door">
