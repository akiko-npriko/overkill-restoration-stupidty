<?xml version="1.0"?>
<dynamic_object>
  <diesel materials="units/vehicles/maserati/vehicle_maserati" orientation_object="rp_maserati" />
  <sequence_manager file="units/vehicles/maserati/vehicle_maserati" />
  
    <animations>
    <animation_group name="front_left_tire">
      <object name="a_tire_front_left" />
    </animation_group>
    <animation_group name="front_right_tire">
      <object name="a_tire_front_right" />
    </animation_group>
    <animation_group name="back_left_tire">
      <object name="a_tire_back_left" />
    </animation_group>
    <animation_group name="back_right_tire">
      <object name="a_tire_back_right" />
    </animation_group>
    <!-- Light animation group -->
    <animation_group name="alarm_lights" enabled="false">
      <object name="ls_left" />
      <object name="ls_right" />
      <object name="ls_rear" />
    </animation_group>  

  </animations>
  
  <bodies>
    <body name="static_body" enabled="true" template="static">
      <object name="rp_maserati" />
      <object name="c_maserati" collision_type="mesh_mopp" />
	</body>
	
	<body name="graph_blocker" enabled="true" template="graph_blocker">
      <object name="c_graph_blocker" collision_type="box" />
	  </body>
	  <body remove_ray_type="ai_vision" name="front_r" enabled="true" template="static">
      <object name="dm_front_r" collision_type="mesh_mopp" two_sided="true"/>
    </body>
    <body remove_ray_type="ai_vision" name="back_r" enabled="true" template="static">
      <object name="dm_back_r" collision_type="mesh_mopp" two_sided="true" />
    </body>
    <body name="rear" enabled="true" template="static">
      <object name="dm_rear" collision_type="mesh_mopp" two_sided="true" />
    </body>
    <body remove_ray_type="ai_vision" name="back_l" enabled="true" template="static">
      <object name="dm_back_l" collision_type="mesh_mopp" two_sided="true"/>
    </body>
    <body remove_ray_type="ai_vision" name="front_l" enabled="true" template="static">
      <object name="dm_front_l" collision_type="mesh_mopp" two_sided="true"/>
    </body>
    <body name="windshield" enabled="true" template="static">
      <object name="dm_windshield" collision_type="mesh_mopp" two_sided="true"/>
    </body>
    <body name="front_left_tire" enabled="true" template="static">
      <object name="dm_front_l_tire" collision_type="mesh_mopp" />
    </body>
    <body name="back_left_tire" enabled="true" template="static">
      <object name="dm_back_l_tire" collision_type="mesh_mopp" />
    </body>
    <body name="front_right_tire" enabled="true" template="static">
      <object name="dm_front_r_tire" collision_type="mesh_mopp" />
    </body>
    <body name="back_right_tire" enabled="true" template="static">
      <object name="dm_back_r_tire" collision_type="mesh_mopp" />
    </body>
    
  </bodies>
  <decal_surfaces default_material="metal" >
    <decal_mesh name="dm_metal" enabled="true" material="metal_chassis" />
	<decal_mesh name="dm_front_l_tire" enabled="true" material="rubber" />
    <decal_mesh name="dm_front_r_tire" enabled="true" material="rubber" />
    <decal_mesh name="dm_back_r_tire" enabled="true" material="rubber" />
    <decal_mesh name="dm_back_l_tire" enabled="true" material="rubber" />
    <decal_mesh name="dm_windshield" enabled="true" material="glass_breakable" />
    <decal_mesh name="dm_front_l" enabled="true" material="glass_breakable" />
    <decal_mesh name="dm_back_l" enabled="true" material="glass_breakable" />
    <decal_mesh name="dm_rear" enabled="true" material="glass_breakable" />
    <decal_mesh name="dm_back_r" enabled="true" material="glass_breakable" />
    <decal_mesh name="dm_front_r" enabled="true" material="glass_breakable" />
  </decal_surfaces>
  <graphics>
     <lod_object name="maserati">
        <object name="g_maserati" max_distance="5000" lod="0" enabled="true" instance_struct="world_tm" />
        <object name="g_maserati_lod" lod="1" enabled="true" instance_struct="world_tm" />
     </lod_object> 
	 <lod_object name="win1">
        <object name="g_windshield" max_distance="5000" lod="0" enabled="true" instance_struct="world_tm" />
		<object name="g_windshield_lod" lod="0" enabled="false" instance_struct="world_tm" />
    </lod_object> 
	<lod_object name="win2">
        <object name="g_front_r" max_distance="5000" lod="0" enabled="true" instance_struct="world_tm" />
		<object name="g_front_r_lod" lod="1"  enabled="false" instance_struct="world_tm" />
    </lod_object> 
	 <lod_object name="win4">
        <object name="g_back_r" max_distance="5000" lod="0" enabled="true" instance_struct="world_tm" />
		    <object name="g_back_r_lod" lod="0" enabled="false" instance_struct="world_tm" />
    </lod_object> 
	 <lod_object name="win5">
        <object name="g_back_l" max_distance="5000" lod="0" enabled="true" instance_struct="world_tm" />
		<object name="g_back_l_lod" lod="0" enabled="false" instance_struct="world_tm" />
    </lod_object> 
	 <lod_object name="win6">
        <object name="g_front_l" max_distance="5000" lod="0" enabled="true" instance_struct="world_tm" />
		<object name="g_front_l_lod" lod="0" enabled="false" instance_struct="world_tm" />
    </lod_object> 
	 <lod_object name="win7">
     <object name="g_rear" max_distance="5000" lod="0" enabled="true" instance_struct="world_tm" />
		<object name="g_rear_lod" lod="0" enabled="false" instance_struct="world_tm" />
    </lod_object> 
	 <lod_object name="win8">
        <object name="g_windshield_sht" max_distance="5000" lod="0" enabled="false" instance_struct="world_tm" />
		<object name="g_windshield_sht_lod" lod="1" enabled="false" instance_struct="world_tm" />
    </lod_object> 
	 <lod_object name="win9">
        <object name="g_front_r_sht" max_distance="5000" lod="0" enabled="false" instance_struct="world_tm" />
		<object name="g_front_r_sht_lod" lod="1" enabled="false" instance_struct="world_tm" />
    </lod_object> 
	 <lod_object name="win10">
        <object name="g_back_r_sht" max_distance="5000" lod="0" enabled="false" instance_struct="world_tm" />
		<object name="g_back_r_sht_lod" lod="1" enabled="false" instance_struct="world_tm" />
    </lod_object> 
	 <lod_object name="win11">
        <object name="g_rear_sht" max_distance="5000" lod="0" enabled="false" instance_struct="world_tm" />
		<object name="g_rear_sht_lod" lod="1" enabled="false" instance_struct="world_tm" />
    </lod_object> 
	 <lod_object name="win12">
        <object name="g_back_l_sht" max_distance="5000" lod="0" enabled="false" instance_struct="world_tm" /> 
		<object name="g_back_l_sht_lod" lod="1" enabled="false" instance_struct="world_tm" />
    </lod_object>
	<lod_object name="win13">
        <object name="g_front_l_sht" max_distance="5000" lod="0" enabled="false" instance_struct="world_tm" /> 
		<object name="g_front_l_sht_lod" lod="1" enabled="false" instance_struct="world_tm" />
    </lod_object>

    <object enabled="false" name="g_lights" />
    <object enabled="false" name="g_lights_il"/>
    <object enabled="false" name="g_lights_rear_effect"/>
    <object enabled="false" name="g_lights_left_effect"/>
    <object enabled="false" name="g_lights_right_effect"/>

    <object name="g_front_r_tire" enabled="true" />
    <object name="g_front_l_tire" enabled="true" />
    <object name="g_back_l_tire" enabled="true" />
    <object name="g_back_r_tire" enabled="true" />
    
	<object name="s_maserati" enabled="true" shadow_caster="true" instance_struct="world_tm"/>
  </graphics>
  
  <objects>
    <align_point name="e_window_right_back" enabled="true" parent="rp_maserati" position="0 0 0" rotation="0 0 0" />
    <align_point name="e_window_right_front" enabled="true" parent="rp_maserati" position="0 0 0" rotation="0 0 0" />
    <align_point name="e_window_left_back" enabled="true" parent="rp_maserati" position="0 0 0" rotation="0 0 0" />
    <align_point name="e_window_left_front" enabled="true" parent="rp_maserati" position="0 0 0" rotation="0 0 0" />
   </objects>

    <lights>
    <light name="ls_left" far_range="2000" type="spot|specular"   end_angle="53" multiplier="identity" editable="true" />
    <light name="ls_right" far_range="2000" type="spot|specular"   end_angle="39" multiplier="identity" editable="true" />
    <light name="ls_rear" far_range="350" type="omni|specular" multiplier="0.1" falloff="4" editable="true" />
    </lights> 
    
</dynamic_object>