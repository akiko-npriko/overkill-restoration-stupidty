<?xml version="1.0"?>
<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">
			<state name="fps/reload/super" type="once" segment="base" speed="1.0">
				<anim name="super_reload"/>
				<keys>
					<key at="trigger" trigger="wp_huntsman_barrel_close" callback="play_sound" class_name="base" param1="wp_huntsman_barrel_close"/>
					<key at="trigger" trigger="wp_huntsman_barrel_open" callback="play_sound" class_name="base" param1="wp_huntsman_barrel_open"/>
					<key at="trigger" trigger="wp_huntsman_lock_click" callback="play_sound" class_name="base" param1="wp_huntsman_lock_click"/>
					<key at="trigger" trigger="wp_huntsman_shell_ground" callback="play_sound" class_name="base" param1="wp_huntsman_shell_ground"/>
					<key at="trigger" trigger="wp_huntsman_shell_insert" callback="play_sound" class_name="base" param1="wp_huntsman_shell_insert"/>
					<key at="trigger" trigger="wp_huntsman_shell_out" callback="play_sound" class_name="base" param1="wp_huntsman_shell_out"/>
					<key at="trigger" trigger="wp_foley_generic_lever_release" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_release"/>
					<key at="trigger" trigger="wp_foley_generic_clip_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_grab"/>
					<key at="trigger" trigger="wp_foley_generic_clip_throw" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_throw"/>
					<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
					<key at="trigger" trigger="wp_foley_generic_clip_in_connect" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_in_connect"/>
					<key at="trigger" trigger="wp_foley_generic_lever_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_grab"/>
					<key at="trigger" trigger="wp_foley_generic_lever_pull" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
					<key at="trigger" trigger="wp_foley_generic_back_in_hand" callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
				</keys>
				<exit name="fps/idle"/>
			</state>
			
			<state name="fps/reload/super_doom4" type="once" segment="base" speed="1.0">
				<anim name="super_doom4_reload"/>
				<keys>
					<key at="trigger" trigger="wp_huntsman_barrel_close" callback="play_sound" class_name="base" param1="wp_huntsman_barrel_close"/>
					<key at="trigger" trigger="wp_huntsman_barrel_open" callback="play_sound" class_name="base" param1="wp_huntsman_barrel_open"/>
					<key at="trigger" trigger="wp_huntsman_lock_click" callback="play_sound" class_name="base" param1="wp_huntsman_lock_click"/>
					<key at="trigger" trigger="wp_huntsman_shell_ground" callback="play_sound" class_name="base" param1="wp_huntsman_shell_ground"/>
					<key at="trigger" trigger="wp_huntsman_shell_insert" callback="play_sound" class_name="base" param1="wp_huntsman_shell_insert"/>
					<key at="trigger" trigger="wp_huntsman_shell_out" callback="play_sound" class_name="base" param1="wp_huntsman_shell_out"/>
					<key at="trigger" trigger="wp_foley_generic_lever_release" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_release"/>
					<key at="trigger" trigger="wp_foley_generic_clip_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_grab"/>
					<key at="trigger" trigger="wp_foley_generic_clip_throw" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_throw"/>
					<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
					<key at="trigger" trigger="wp_foley_generic_clip_in_connect" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_in_connect"/>
					<key at="trigger" trigger="wp_foley_generic_lever_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_grab"/>
					<key at="trigger" trigger="wp_foley_generic_lever_pull" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
					<key at="trigger" trigger="wp_foley_generic_back_in_hand" callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
				</keys>
				<exit name="fps/idle"/>
			</state>
			
			<state name="fps/reload/superclassic" type="once" segment="base" speed="1.0">
				<anim name="superclassic_reload"/>
				<keys>
					<key at="trigger" trigger="wp_dsdbcls" callback="play_sound" class_name="base" param1="dsdbcls"/>
					<key at="trigger" trigger="wp_dsdbload" callback="play_sound" class_name="base" param1="dsdbload"/>
					<key at="trigger" trigger="wp_dsdbopn" callback="play_sound" class_name="base" param1="dsdbopn"/>
				</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>

