<dynamic_object>
    <diesel orientation_object="rp_wpn_fps_snp_mosin_m_standard" materials="units/mods/weapons/wpn_fps_snp_kar98k_pts/wpn_fps_snp_kar98k_m_standard" />
    <animations>		
		<animation_group name="reload" enabled="false" >
			<object name="anim_bullets_zero_reload" />
			<object name="a_reload" />
		</animation_group>
		<animation_group name="reload_not_empty" enabled="false" > 
			<object name="anim_bullets_zero_reload_not_empty" />
			<object name="a_reload_not_empty" />
		</animation_group>
		<animation_group name="recoil" enabled="false" > 
			<object name="anim_recoil" />
		</animation_group>
	</animations>
   <graphics>
        <object enabled="true" name="g_bullets" />
        <object enabled="true" name="g_bullet_recoil" />
        <object enabled="true" name="g_clip" />
    </graphics>
</dynamic_object>
