			<object name="anim_bullet_recoil" enabled="true" />
		</animation_group>
		<animation_group name="reload">
			<object name="anim_bullet_reload" enabled="true" />
		</animation_group>
	</animations>
	<graphics>
		<object name="g_bullet_1" enabled="true"/>
