<?xml version="1.0"?>
<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps"/>
		</search>
		<target mode="attach">
			<to name="reload_mk22_pistol" 						redirect="fps/reload/mk22_pistol"/>
			<to name="reload_not_empty_mk22_pistol" 			redirect="fps/reload_not_empty/mk22_pistol"/>
		</target>
	</tweak>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">
			<state name="fps/reload/mk22_pistol" type="once" segment="base" speed="1.0">
				<anim name="mk22_pistol_reload"/>
				<keys>

					<key at="enter"                                                         callback="anim_clbk_stop_weapon_magazine_empty" class_name="base" param1="reload"/>
					<key at="trigger" trigger="bullet_show" 								callback="anim_clbk_check_bullet_object" class_name="base" />

					<key at="trigger" trigger="wp_g17_clip_slide_out" 				        callback="play_sound" class_name="base" param1="mk22_mag_out"/>
					<key at="trigger" trigger="wp_g17_clip_grab" 				            callback="play_sound" class_name="base" param1="wp_g17_clip_grab"/>
					<key at="trigger" trigger="wp_g17_clip_in_contact" 				        callback="play_sound" class_name="base" param1="mk22_mag_contact"/>
					<key at="trigger" trigger="wp_g17_clip_slide_in" 				        callback="play_sound" class_name="base" param1="mk22_mag_in"/>
					<key at="trigger" trigger="wp_deagle_lever_pull" 			            callback="play_sound" class_name="base" param1="mk22_lever_pull"/>
					<key at="trigger" trigger="wp_g17_lever_release" 			            callback="play_sound" class_name="base" param1="mk22_lever_release"/>

					<key at="trigger" trigger="wp_foley_generic_lever_release" 				callback="play_sound" class_name="base" param1="wp_foley_generic_lever_release"/>
					<key at="trigger" trigger="wp_foley_generic_lever_pull" 				callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
					<key at="trigger" trigger="wp_foley_generic_clip_grab" 				    callback="play_sound" class_name="base" param1="wp_foley_generic_clip_grab"/>
					<key at="trigger" trigger="wp_foley_generic_lever_grab" 			    callback="play_sound" class_name="base" param1="wp_foley_generic_lever_grab"/>
					<key at="trigger" trigger="wp_foley_generic_back_in_hand" 			    callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>

				</keys>
				<exit name="fps/idle"/>
			</state>
			<state name="fps/reload_not_empty/mk22_pistol" type="once" segment="base" speed="1.0">
				<anim name="mk22_pistol_reload_not_empty"/>
				<keys>

					<key at="trigger" trigger="bullet_show" 								callback="anim_clbk_check_bullet_object" class_name="base" />

					<key at="trigger" trigger="wp_g17_clip_slide_out" 				        callback="play_sound" class_name="base" param1="mk22_mag_out"/>
					<key at="trigger" trigger="wp_g17_clip_grab" 				            callback="play_sound" class_name="base" param1="wp_g17_clip_grab"/>
					<key at="trigger" trigger="wp_g17_clip_in_contact" 				        callback="play_sound" class_name="base" param1="mk22_mag_contact"/>
					<key at="trigger" trigger="wp_g17_clip_slide_in" 				        callback="play_sound" class_name="base" param1="mk22_mag_in"/>
					<key at="trigger" trigger="wp_deagle_lever_pull" 			            callback="play_sound" class_name="base" param1="mk22_lever_pull"/>
					<key at="trigger" trigger="wp_g17_lever_release" 			            callback="play_sound" class_name="base" param1="mk22_lever_release"/>

					<key at="trigger" trigger="wp_foley_generic_lever_release" 				callback="play_sound" class_name="base" param1="wp_foley_generic_lever_release"/>
					<key at="trigger" trigger="wp_foley_generic_lever_pull" 				callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
					<key at="trigger" trigger="wp_foley_generic_clip_grab" 				    callback="play_sound" class_name="base" param1="wp_foley_generic_clip_grab"/>
					<key at="trigger" trigger="wp_foley_generic_lever_grab" 			    callback="play_sound" class_name="base" param1="wp_foley_generic_lever_grab"/>
					<key at="trigger" trigger="wp_foley_generic_back_in_hand" 			    callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>

				</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>
	

	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/recoil"/>
			<anim name="m4_recoil" weight="m4"/>
		</search>
		<target mode="append">
			<anim name="mk22_pistol_recoil" weight="mk22_pistol"/>
		<keys>

				<key at="trigger" trigger="wp_foley_generic_lever_grab" 			    callback="play_sound" class_name="base" param1="wp_foley_generic_lever_grab"/>
				<key at="trigger" trigger="wp_foley_generic_lever_pull" 			    callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
				<key at="trigger" trigger="wp_deagle_lever_pull" 			            callback="play_sound" class_name="base" param1="mk22_lever_pull"/>
				<key at="trigger" trigger="wp_g17_lever_release" 			            callback="play_sound" class_name="base" param1="mk22_lever_release"/>
				<key at="trigger" trigger="wp_foley_generic_lever_release" 			    callback="play_sound" class_name="base" param1="wp_foley_generic_lever_release"/>
				<key at="trigger" trigger="wp_foley_generic_back_in_hand" 			    callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>

		</keys>
		</target>
	</tweak>

