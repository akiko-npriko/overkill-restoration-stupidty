<dynamic_object>
    <diesel orientation_object="rp_wpn_fps_pis_deagle"/>
	     <animations>
		<animation_group name="reload">
			<object name="anim_hammer_reload" enabled="true" />
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_hammer_recoil" enabled="true" />
		</animation_group>
		<animation_group name="last_recoil">
			<object name="anim_hammer_last_recoil" enabled="true" />
		</animation_group>
    </animations>
</dynamic_object>
