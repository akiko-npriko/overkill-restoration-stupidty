<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_pis_mk22_pts/wpn_fps_pis_mk22_magazine" orientation_object="rp_magazine" />
    <animations>
		<animation_group name="reload">
			<object name="mag_align" enabled="true" />
		</animation_group>
		<animation_group name="reload_right">
			<object name="anim_mag_reload_right" enabled="true" />
		</animation_group>
		<animation_group name="reload_left">
			<object name="anim_mag_reload_left" enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty">
			<object name="mag_align2" enabled="true" />
        </animation_group>
		<animation_group name="reload_not_empty_right">
			<object name="anim_mag_reload_not_empty_right" enabled="true" />
        </animation_group>
		<animation_group name="reload_not_empty_left">
			<object name="anim_mag_reload_not_empty_left" enabled="true" />
        </animation_group>
    </animations>
	<graphics>
		<object name="g_mag" enabled="true" />
		<object name="g_bullet_1" enabled="true" />
		<object name="g_bullet_2" enabled="true" />
		<object name="g_bullet_3" enabled="true" />
		<object name="g_bullet_4" enabled="true" />
		<object name="g_bullet_5" enabled="true" />
		<object name="g_bullet_6" enabled="true" />
		<object name="g_bullet_7" enabled="true" />
		<object name="g_bullet_8" enabled="true" />
		<object name="g_bullet_9" enabled="true" />
		<object name="g_bullet_10" enabled="true" />
	</graphics>
</dynamic_object>
