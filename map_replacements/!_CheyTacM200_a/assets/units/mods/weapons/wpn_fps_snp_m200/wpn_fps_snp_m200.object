<dynamic_object>
	<diesel orientation_object="rp_wpn_fps_snp_m200"/>
	<animations>
		<animation_group name="reload">
			<object name="anim_bolt_reload" enabled="true"/>
			<object name="anim_boltguide_reload" enabled="true"/>
			<object name="anim_mag_reload" enabled="true"/>
			<object name="anim_magrelease_reload" enabled="true"/>
		</animation_group>
		<animation_group name="reload_not_empty">
			<object name="anim_mag_tact_reload" enabled="true"/>
			<object name="anim_magrelease_tact_reload" enabled="true"/>
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_bolt_recoil" enabled="true"/>
			<object name="anim_boltguide_recoil" enabled="true"/>
		</animation_group>
		<animation_group name="equip">
			<object name="anim_bolt_draw" enabled="true"/>
			<object name="anim_boltguide_draw" enabled="true"/>
		</animation_group>
	</animations>
</dynamic_object>