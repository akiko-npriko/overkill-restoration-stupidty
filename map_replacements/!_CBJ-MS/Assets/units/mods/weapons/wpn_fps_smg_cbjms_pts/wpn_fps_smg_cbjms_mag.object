<dynamic_object>
    <diesel materials="units/mods/weapons/wpn_fps_smg_cbjms_pts/wpn_fps_smg_cbjms_mag" orientation_object="rp_wpn_fps_smg_mp9_m_short"/>
	<animations> 
		<animation_group name="reload_not_empty">
			<object name="mag_align_tactical" enabled="true"/>
		</animation_group>	
		<animation_group name="reload">
			<object name="mag_align_reload" enabled="true"/>
		</animation_group>
	</animations>
  
    <graphics>
        <object name="g_mag_short_lod0" enabled="true"/>
        <object name="g_bullet_1" enabled="true"/>
        <object name="g_bullet_2" enabled="true"/>
    </graphics>
</dynamic_object>