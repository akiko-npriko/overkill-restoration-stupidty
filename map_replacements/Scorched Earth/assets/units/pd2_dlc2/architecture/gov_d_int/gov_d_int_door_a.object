<dynamic_object>
	<diesel orientation_object="rp_gov_d_int_door_a" materials="units/pd2_dlc2/architecture/gov_d_int/gov_d_int_door_a" />
	<sequence_manager file="units/pd2_dlc2/architecture/gov_d_int/gov_d_int_door_a" />
	<animations>
		<animation_group name="anim_open_close" enabled="false">
			<object name="a_door_a" />
		</animation_group>
	</animations>
	<bodies>
		<body name="body_door" enabled="true" template="animated">
			<object name="a_door_a" />
			<object name="c_box_door_a" collision_type="box" padding="-2.5" />
		</body>
		<body name="body_hitbox_door_handle_in" enabled="false" template="static">
			<object name="rp_gov_d_int_door_a" />
			<object name="c_hitbox_door_handle_in" collision_type="box" padding="-2.5" />
		</body>
		<body name="body_hitbox_door_handle_out" enabled="false" template="static">
			<object name="rp_gov_d_int_door_a" />
			<object name="c_hitbox_door_handle_out" collision_type="box" padding="-2.5" />
		</body>
	</bodies>
	<decal_surfaces default_material="wood">
		<decal_mesh name="g_door_a" enabled="true" material="wood" />
	</decal_surfaces>
	<graphics>
		<graphic_group name="sawicongroup" 					enabled="false" culling_object="g_icon">
			<lod_object name="saw_icon">
					<object name="g_icon" 		enabled="true"  max_distance="450"  max_draw_lod="0" />
					<object name="g_icon_lod1" 	enabled="true"  lod="1" />
			</lod_object>
		</graphic_group>
		<object name="g_ecm"				enabled="false"/>
		<object name="g_glow_func1_green"	enabled="false"/>
		<object name="g_glow_func2_green"	enabled="false"/>
		<object name="g_keycard"			enabled="false"/>
		<object name="g_door_a"				enabled="true" />
	</graphics>
</dynamic_object>
