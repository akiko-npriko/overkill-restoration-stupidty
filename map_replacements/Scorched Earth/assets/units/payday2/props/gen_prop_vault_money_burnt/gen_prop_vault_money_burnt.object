<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/payday2/props/gen_prop_vault_money_burnt/gen_prop_vault_money" orientation_object="rp_gen_prop_vault_money_burnt" />
	<sequence_manager file="units/payday2/props/gen_prop_vault_money_burnt/gen_prop_vault_money_burnt" />

	<animations>
		<animation_group name="anim" enabled="false">
		<object name="root" />
		<object name="jt_end_1" />
		<object name="jt_end_2" />
		<object name="jt_end_3" />
		<object name="jt_end_4" />
		<object name="jt_end_5" />
		<object name="anim_collision" />
		<object name="anim_collision_conpensate" />
		</animation_group>
	</animations>

	<bodies>
		<body name="body_money" enabled="true" template="static">
			<object name="rp_gen_prop_vault_money_burnt" />
			<object name="c_money" collision_type="box" padding="-2.5" />
		</body>

		<body name="body_money_static" enabled="false" template="static">
			<object name="rp_gen_prop_vault_money_burnt" />
			<object name="c_money_static" collision_type="box" padding="-2.5" />
		</body>

		<body name="body_money_anim" enabled="false" template="animated">
			<object name="anim_collision" />
			<object name="c_money_anim" 		collision_type="convex" padding="-2.5" />
			<object name="c_money_anim_fill_1" 	collision_type="box" 	padding="-2.5" />
		</body>

		<body name="body_money_anim_fill" enabled="false" template="animated">
			<object name="anim_collision_conpensate" />
			<object name="c_money_anim_fill_2" collision_type="box" padding="-2.5" />
		</body>
	</bodies>

	<decal_surfaces default_material="plastic">
	</decal_surfaces>

	<graphics>
		<object name="g_money" enabled="false" />
		<graphic_group name="grp_money" enabled="true" culling_object="c_money">
			<lod_object name="lod_money">
				<object name="g_money_lod0"		enabled="true"  max_distance="350"  max_draw_lod="0" />
				<object name="g_money_lod1" 	enabled="true"  lod="1" />
			</lod_object>
		</graphic_group>
	</graphics>
</dynamic_object>