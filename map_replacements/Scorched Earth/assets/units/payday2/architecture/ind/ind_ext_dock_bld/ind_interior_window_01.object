<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/payday2/architecture/ind/ind_ext_dock_bld/ind_interior_window_01" orientation_object="rp_ind_interior_window_01" />
	<sequence_manager file="units/payday2/architecture/ind/ind_ext_dock_bld/ind_interior_window_01" />
	<bodies>
		<body name="window1" enabled="true" template="window">
			<object name="rp_ind_interior_window_01"/>
			<object name="c_box" collision_type="box" padding="-2" />
		</body>
		<body name="window3" enabled="false" template="raycoll_static">
			<object name="rp_ind_interior_window_01"/>
		</body>
	</bodies>
	
	<graphics>
		<object name="g_1" enabled="true" />
		<object name="g_2" enabled="false" />
	</graphics>
	
	<decal_surfaces default_material="glass_breakable" static="true">
		<decal_mesh name="dm_1" enabled="true" material="glass_breakable" />
	</decal_surfaces>
	
	<objects>
		<align_point name="e_e" enabled="true" parent="rp_ind_interior_window_01" position="0 0 0" rotation="0 0 0" />
	</objects>
</dynamic_object>