<?xml version="1.0" ?>
<dynamic_object>
	<diesel materials="units/payday2/architecture/ind/ind" orientation_object="rp_ind_ext_pipe_1_short" />
	<bodies>
        <body name="static_body" template="static" enabled="true" >
            <object name="rp_ind_ext_pipe_1_short"/>
			<object name="c_capsule_01" collision_type="capsule" padding="-2.5"/>
        </body>
    </bodies>
	
	<decal_surfaces default_material="metal">
        <decal_mesh enabled="true" name="dm_metal_hollow" material="sheet_metal" />
    </decal_surfaces>

    <graphics>		
		<lod_object name="pipe">
			<object name="g_pipe_1_short_lod_0" enabled="true" lod="0" max_distance="800"/>
			<object name="g_pipe_1_short_lod_1" enabled="true" lod="1"/>
		</lod_object>
		<object enabled="true" name="s_s" shadow_caster="true"/>
    </graphics>
</dynamic_object> 