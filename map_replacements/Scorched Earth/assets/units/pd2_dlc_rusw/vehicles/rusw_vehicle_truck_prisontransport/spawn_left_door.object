<dynamic_object>
	<diesel materials="units/pd2_dlc_rusw/vehicles/rusw_vehicle_truck_prisontransport/rusw_vehicle_truck_prisontransport" orientation_object="rp_spawn_left_door" />
	<bodies>
		<body name="body_static" enabled="true" template="dynamic" friction="0.8" collides_with_mover="false">
			<object name="c_convex_01" collision_type="convex" padding="-2.5" mass="8"/>
		</body>
	</bodies>
	<decal_surfaces default_material="metal">
		<decal_mesh name="dm_metal" enabled="true" material="metal" />
	</decal_surfaces>
	<graphics>
		<object name="g_g" enabled="true"/>
		<object name="s_s" enabled="true" shadow_caster="true" />
	</graphics>
</dynamic_object>
