<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/lapd/armor_skins/lapd_fbi_light_shotgun/lapd_fbi_light_shotgun" orientation_object="root_point" />

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="co_culling">
			<object name="g_body_shitbag" enabled="true"/>
			<object name="g_swat_sg" enabled="true"/>
			<object name="g_beanie_lod1" enabled="true"/>

		<!--Balaclavas; Only one should be used at a time-->
			<object name="g_balaclava_a" enabled="false"/> <!--Covered nose-->
			<object name="g_balaclava_b" enabled="false"/> <!--Exposed nose-->

		<!--Heads; Only one should be used at a time and they should not be used alongside a balaclava-->
			<object name="g_head_black_b_var1" enabled="false"/>
			<object name="g_head_black_b_var2" enabled="false"/>
			<object name="g_head_black_b_var3" enabled="false"/>
			<object name="g_head_black_b_var4" enabled="false"/>
			<object name="g_head_black_b_var5" enabled="false"/>
			<object name="g_head_black_b_var6" enabled="false"/>
			<object name="g_head_black_b_var7" enabled="false"/>
			<object name="g_head_white_b_var1" enabled="false"/>
			<object name="g_head_white_b_var2" enabled="false"/>
			<object name="g_head_white_b_var3" enabled="false"/>
			<object name="g_head_white_b_var4" enabled="true"/>
			<object name="g_head_white_b_var5" enabled="false"/>
			<object name="g_head_white_b_var6" enabled="false"/>
			<object name="g_head_white_b_var7" enabled="false"/>

		<!--Faces; Only one should be used at a time and they should only be used alongside a balaclava-->
			<object name="g_face_a" enabled="false"/>
			<object name="g_face_b" enabled="false"/>
			<object name="g_face_c" enabled="false"/>
			<object name="g_face_d" enabled="false"/>
			<object name="g_face_e" enabled="false"/>
			<object name="g_face_f" enabled="false"/>
			<object name="g_face_g" enabled="false"/>
			<object name="g_face_h" enabled="false"/>

		<!--Goggles; Only one should be used at a time and they should each be used with their corresponding glass-->
			<object name="g_glasses" enabled="false"/> <!--Use alongside g_glasses_glass-->
			<object name="g_glasses_glass" enabled="false"/>

			<object name="g_shades" enabled="true"/> <!--Use alongside g_shades_glass-->
			<object name="g_shades_glass" enabled="true"/>

		<!--Headset-->
			<object name="g_headset" enabled="true"/>

		<!--Gun Holster-->
			<object name="g_holster_l" enabled="false"/>
		</graphic_group>
	</graphics>
</dynamic_object>