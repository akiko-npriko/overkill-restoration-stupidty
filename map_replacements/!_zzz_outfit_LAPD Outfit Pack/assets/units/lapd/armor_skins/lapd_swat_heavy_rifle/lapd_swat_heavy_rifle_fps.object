<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/lapd/armor_skins/lapd_swat_heavy_rifle/lapd_swat_heavy_rifle_fps" orientation_object="root_point" />
	

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="bounding_box_char">
			<object name="g_body" enabled="true"/>
			<object name="g_swat_heavy_ar" enabled="true"/>

		<!--Arms; Only one should be used at a time-->
		<!--Should be the same as the third-person model-->
			<object name="g_arms_black_a" enabled="false"/> <!--Use alongside g_head_black_a_var1, g_head_black_a_var5, or g_face_h-->
			<object name="g_arms_black_b" enabled="false"/> <!--Use alongside g_head_black_a_var2-->
			<object name="g_arms_black_c" enabled="false"/> <!--Use alongside g_head_black_a_var4, g_head_black_a_var6, or g_face_e-->
			<object name="g_arms_black_d" enabled="false"/> <!--Use alongside g_head_black_a_var3-->
			<object name="g_arms_black_e" enabled="false"/> <!--Use alongside g_head_black_a_var7-->
			<object name="g_arms_white_a" enabled="false"/> <!--Use alongside g_head_white_a_var1, g_head_white_a_var6, g_head_white_a_var7, g_face_a, or g_face_d-->
			<object name="g_arms_white_b" enabled="true"/> <!--Use alongside g_head_white_a_var2, g_face_c, or g_face_g-->
			<object name="g_arms_white_c" enabled="false"/> <!--Use alongside g_head_white_a_var3, g_head_white_a_var5, g_face_b, or g_face_f-->
			<object name="g_arms_white_d" enabled="false"/> <!--Use alongside g_head_white_a_var4-->

		<!--Sleeves-->
		<!--Should be the same as the third-person model-->
			<object name="g_longsleeve" enabled="true"/>
		</graphic_group>
	</graphics>
</dynamic_object>