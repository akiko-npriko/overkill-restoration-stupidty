<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_upg_m_g36_lanc/wpn_fps_upg_m_g36_lanc" orientation_object="rp_mag" />
	<animations>
    <animation_group name="reload">
      <object name="mag_align" enabled="true" />
    </animation_group>    
	<animation_group name="reload_not_empty">
      <object name="mag_align_2" enabled="true" />
    </animation_group>
  </animations>
	<graphics>
		<object name="g_mag" enabled="true" />
		<object name="g_bullet_1" enabled="true" />
		<object name="g_bullet_2" enabled="true" />
	</graphics>
</dynamic_object>
