	<animations>  
	
		<animation_group name="reload">
			<object name="clip_ejection_reload" enabled="true" />
			<object name="anim_ejectorpin_reload" enabled="true" />
		</animation_group>
		
		<animation_group name="reload_not_empty">
			<object name="clip_ejection_reload_not_empty" enabled="true" />
			<object name="anim_ejectorpin_reload_not_empty" enabled="true" />
		</animation_group>
		
		<animation_group name="recoil">
			<object name="anim_house_recoil" enabled="true" />
			<object name="anim_cocking_lever_recoil" enabled="true" />
		</animation_group>
    </animations>
</dynamic_object>