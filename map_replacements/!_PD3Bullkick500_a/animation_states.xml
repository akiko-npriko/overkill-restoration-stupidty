	<!--Redirects-->
				
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps"/>
		</search>
		<target mode="attach">

			<to name="reload_bk500_spin" 					redirect="fps/reload/bk500_spin1"/>
			<to name="reload_bk500_spin" 					redirect="fps/reload/bk500_spin2"/>
			<to name="reload_bk500_spin" 					redirect="fps/reload/bk500_spin3"/>

			<to name="reload_not_empty_bk500_spin" 			redirect="fps/reload/bk500_spin1"/>
			<to name="reload_not_empty_bk500_spin" 			redirect="fps/reload/bk500_spin2"/>
			<to name="reload_not_empty_bk500_spin" 			redirect="fps/reload/bk500_spin3"/>
			
		</target>
		
	</tweak>
