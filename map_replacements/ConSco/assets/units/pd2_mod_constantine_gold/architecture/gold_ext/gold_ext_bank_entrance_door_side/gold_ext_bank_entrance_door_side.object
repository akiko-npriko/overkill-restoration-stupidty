<dynamic_object>
	<diesel materials="units/pd2_mod_constantine_gold/architecture/gold_ext/gold_ext_bank_entrance_door_side/gold_ext_bank_entrance_door_side" orientation_object="rp_brb_ext_bank_entrance_door_side" />
	<sequence_manager file="units/pd2_mod_constantine_gold/architecture/gold_ext/gold_ext_bank_entrance_door_side/gold_ext_bank_entrance_door_side" />
	<bodies>
	<!--<body name="body_doors_closed" enabled="true" template="static">
			<object name="rp_brb_ext_bank_entrance_door_main" />
			<object name="c_box_doors_closed_01" collision_type="box" padding="-2.5" />
		</body>
	-->

		<body name="body_doors_open" enabled="true" template="static">
			<object name="rp_brb_ext_bank_entrance_door_side" />
			<object name="c_box_frame_open_01" 			collision_type="box" padding="-2.5" />
			<object name="c_box_frame_open_02" 			collision_type="box" padding="-2.5" />
			<object name="c_box_frame_open_03" 			collision_type="box" padding="-2.5" />
			<object name="c_box_frame_open_04" 			collision_type="box" padding="-2.5" />
			<object name="c_box_door_1_1" 				collision_type="box" padding="-2.5"/>
			<object name="c_box_door_1_2" 				collision_type="box" padding="-2.5"/>
			<object name="c_box_door_1_3" 				collision_type="box" padding="-2.5"/>
			<object name="c_box_door_1_4" 				collision_type="box" padding="-2.5"/>
			<object name="c_box_door_1_5" 				collision_type="box" padding="-2.5"/>
			<object name="c_box_door_2_1" 				collision_type="box" padding="-2.5"/>
			<object name="c_box_door_2_2" 				collision_type="box" padding="-2.5"/>
			<object name="c_box_door_2_3" 				collision_type="box" padding="-2.5"/>
			<object name="c_box_door_2_4" 				collision_type="box" padding="-2.5"/>
			<object name="c_box_door_2_5" 				collision_type="box" padding="-2.5"/>
			<object name="c_mopp_frame_s_open"			collision_type="mesh_mopp" padding="-2.5"/>
		</body>

		<body name="body_doors_crashed_open" enabled="true" template="static">
			<object name="rp_brb_ext_bank_entrance_door_side" />
			<object name="c_mopp_frame_s_crashed_open"	collision_type="mesh_mopp" padding="-2.5"/>
		</body>
		<body name="body_doors_crashed_open_nav" enabled="false" template="nav_walk">
			<object name="rp_brb_ext_bank_entrance_door_side" />
			<object name="c_mopp_nav_doors_crashed_open" 	collision_type="mesh_mopp" padding="-2.5" />
		</body>
		<body name="body_dm_doors_s_crashed_open" enabled="false" template="static"  collides_with_mover="false">
			<object name="rp_brb_ext_bank_entrance_door_side" />
			<object name="c_mopp_dm_doors_s_crashed_open" 	collision_type="mesh_mopp" padding="-2.5" />
		</body>

		<body name="body_glass_1_top" enabled="true" template="static" remove_ray_type="vis_graph ai_vision">
			<object name="g_glass_1_top" />
			<object name="c_glass_1_top" collision_type="box" padding="-2.5" />
		</body>
		<body name="body_glass_1_bottom" enabled="true" template="static" remove_ray_type="vis_graph ai_vision">
			<object name="g_glass_1_bottom" />
			<object name="c_glass_1_bottom" collision_type="box" padding="-2.5" />
		</body>
		<body name="body_mover_blocker_1" enabled="true" template="mover_blocker">
			<object name="rp_brb_ext_bank_entrance_door_side" />
			<object name="c_mover_blocker_1" collision_type="box" padding="-2.5" />
		</body>

		<body name="body_glass_2_top" enabled="true" template="static" remove_ray_type="vis_graph ai_vision">
			<object name="g_glass_2_top" />
			<object name="c_glass_2_top" collision_type="box" padding="-2.5" />
		</body>
		<body name="body_glass_2_bottom" enabled="true" template="static" remove_ray_type="vis_graph ai_vision">
			<object name="g_glass_2_bottom" />
			<object name="c_glass_2_bottom" collision_type="box" padding="-2.5" />
		</body>
		<body name="body_mover_blocker_2" enabled="true" template="mover_blocker">
			<object name="rp_brb_ext_bank_entrance_door_side" />
			<object name="c_mover_blocker_2" collision_type="box" padding="-2.5" />
		</body>

	</bodies>

	<decal_surfaces default_material="thin_layer">
	<!--<decal_mesh name="dm_metal_closed" 			enabled="true" 	material="metal" />
	-->	<decal_mesh name="dm_metal_open" 			enabled="true" 	material="metal" />
		<decal_mesh name="dm_metal_crashed_open" 	enabled="true" 	material="metal" />
		<decal_mesh name="dm_glass_1_top" 			enabled="true" 	material="glass_unbreakable" />
		<decal_mesh name="dm_glass_1_bottom" 		enabled="true" 	material="glass_unbreakable" />
		<decal_mesh name="dm_glass_2_top" 			enabled="true" 	material="glass_unbreakable" />
		<decal_mesh name="dm_glass_2_bottom" 		enabled="true" 	material="glass_unbreakable" />
		<decal_mesh name="dm_plaster" 				enabled="true" 	material="plaster" />
		<decal_mesh name="dm_plaster_crashed_open"	enabled="true" 	material="plaster" />
	</decal_surfaces>

	<graphics>
	<!--<graphic_group name="grp_doors_closed" enabled="false">
			<object name="g_doors_closed" enabled="true" />
		</graphic_group>
	-->	<graphic_group name="grp_doors_open" enabled="true">
			<object name="g_doors_open" 		enabled="true"/>
			<object name="g_glass_1_top" 		enabled="true" 		shadow_caster="false"/>
			<object name="g_glass_1_top_dmg"	enabled="false" 	shadow_caster="false"/>
			<object name="g_glass_1_bottom" 	enabled="true" 		shadow_caster="false"/>
			<object name="g_glass_1_bottom_dmg"	enabled="false" 	shadow_caster="false"/>
			<object name="g_glass_2_top" 		enabled="true" 		shadow_caster="false"/>
			<object name="g_glass_2_top_dmg"	enabled="false" 	shadow_caster="false"/>
			<object name="g_glass_2_bottom" 	enabled="true" 		shadow_caster="false"/>
			<object name="g_glass_2_bottom_dmg"	enabled="false" 	shadow_caster="false"/>
			<object name="s_s_doors_open"		enabled="true" 		shadow_caster="true"/>
		</graphic_group>
		
		<graphic_group name="grp_doors_crashed_open" enabled="false">
			<object name="g_doors_crashed_open" enabled="true" />
		</graphic_group>

	</graphics>
</dynamic_object>
