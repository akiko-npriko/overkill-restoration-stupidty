<dynamic_object>
	<diesel materials="units/pd2_mod_gunrunnerclubhouse/terrain/gunrunner_terrain" orientation_object="rp_mex_terrain" />
	<bodies>
		<body name="body_static" enabled="true" template="static">
			<object name="rp_mex_terrain" />
			<object name="c_mesh_mopp" collision_type="mesh_mopp" />
		</body>
	</bodies>
	<decal_surfaces default_material="snow">
		<decal_mesh name="dm_dirt" 	material="snow" 		enabled="true"/>
	</decal_surfaces> 
	<graphics>
		<object name="g_terrain" enabled="true" shadow_caster="false" />
		<object name="g_road" enabled="true" shadow_caster="false" />
		<object name="g_gas_station_concrete" enabled="true" shadow_caster="false" />
	</graphics>
</dynamic_object>
