<dynamic_object>
    <diesel materials="units/mods/weapons/wpn_fps_pis_m6d_pts/wpn_fps_pis_m6d_body" orientation_object="rp_body"/>
     <animations>
		<animation_group name="reload">
			<object name="anim_bolt_reload" enabled="true" />
		</animation_group>
		<animation_group name="reload_right">
			<object name="anim_bolt_reload_right" enabled="true" />
		</animation_group>
		<animation_group name="reload_left">
			<object name="anim_bolt_reload_left" enabled="true" />
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_bolt_recoil" enabled="true" />
		</animation_group>
		<animation_group name="last_recoil">
			<object name="anim_bolt_last_recoil" enabled="true" />
		</animation_group>
    </animations>
	<graphics>
        <object enabled="true" name="g_m6d_base" />
        <object enabled="true" name="g_m6d_interactables" />
		<object enabled="true" name="g_m6d_slide" />
		<object enabled="true" name="g_m6d_slide_button" />
    </graphics>
</dynamic_object>
