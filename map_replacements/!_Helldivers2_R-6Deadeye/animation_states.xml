<?xml version="1.0"?>
<tweaks>

	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">

		<state name="fps/reload/r6/enter" type="once" segment="base" speed="1">
			<to name="reload_exit" redirect="fps/reload/r6/exit"/>
			<to name="reload_not_empty_exit" redirect="fps/reload/r6/not_empty_exit"/>
			<anim name="r6_reload_enter"/>
			<keys>
				<key at="trigger" trigger="wp_m1873_lever_pull" callback="play_sound" class_name="base" param1="wp_r6_lever_pull"/>
				<key at="trigger" trigger="wp_m1873_lever_push" callback="play_sound" class_name="base" param1="wp_r6_lever_push"/>
				<key at="trigger" trigger="wp_m1873_bullet_in" callback="play_sound" class_name="base" param1="wp_r6_bullet_in"/>
				<key at="trigger" trigger="wp_m1873_casing_land" callback="play_sound" class_name="base" param1="wp_r6_casing_land"/>
				<key at="trigger" trigger="wp_ak47_tilt_back" callback="play_sound" class_name="base" param1="wp_ak47_tilt_back"/>
				<key at="trigger" trigger="wp_ak47_tilt" callback="play_sound" class_name="base" param1="wp_ak47_tilt"/>
				<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
			</keys>
			<exit name="fps/reload/r6/loop"/>
		</state>
		
		<state name="fps/reload/r6/loop" type="loop" segment="base" speed="1">
			<to name="reload_exit" redirect="fps/reload/r6/exit"/>
			<to name="reload_not_empty_exit" redirect="fps/reload/r6/not_empty_exit"/>
			<anim name="r6_reload_loop"/>
			<keys>
				<key at="enter" callback="enter_shotgun_reload_loop" class_name="base" param1="fps/reload/r6/loop"/>
				<key at="trigger" trigger="wp_m1873_lever_push" callback="play_sound" class_name="base" param1="wp_r6_lever_push"/>
				<key at="trigger" trigger="wp_m1873_lever_pull" callback="play_sound" class_name="base" param1="wp_r6_lever_pull"/>
				<key at="trigger" trigger="wp_m1873_bullet_in" callback="play_sound" class_name="base" param1="wp_r6_bullet_in"/>
				<key at="trigger" trigger="wp_m1873_casing_land" callback="play_sound" class_name="base" param1="wp_r6_casing_land"/>
				<key at="trigger" trigger="wp_ak47_tilt_back" callback="play_sound" class_name="base" param1="wp_ak47_tilt_back"/>
				<key at="trigger" trigger="wp_ak47_tilt" callback="play_sound" class_name="base" param1="wp_ak47_tilt"/>
				<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
				<!--<key at="enter" callback="enter_shotgun_reload_loop" class_name="base" param1="fps/reload/r6/loop"/>-->
				<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base"/>
				
				<key at="exit" callback="anim_clbk_stop_weapon_reload" class_name="base"/>
			</keys>
		</state>
		
		<state name="fps/reload/r6/exit" type="mix" segment="base" speed="1.0">
			<anim name="r6_reload_exit" />
			<keys>
				<key at="trigger" trigger="wp_m1873_lever_push" callback="play_sound" class_name="base" param1="wp_r6_lever_push"/>
				<key at="trigger" trigger="wp_m1873_lever_pull" callback="play_sound" class_name="base" param1="wp_r6_lever_pull"/>
				<key at="trigger" trigger="wp_m1873_bullet_in" callback="play_sound" class_name="base" param1="wp_r6_bullet_in"/>
				<key at="trigger" trigger="wp_m1873_casing_land" callback="play_sound" class_name="base" param1="wp_r6_casing_land"/>
				<key at="trigger" trigger="wp_ak47_tilt_back" callback="play_sound" class_name="base" param1="wp_ak47_tilt_back"/>
				<key at="trigger" trigger="wp_ak47_tilt" callback="play_sound" class_name="base" param1="wp_ak47_tilt"/>
				<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
				
				<key at="exit" callback="anim_clbk_stop_weapon_reload_all" class_name="base"/>
			</keys>
			<exit name="fps/idle"/>
		</state>
		
		<state name="fps/reload/r6/not_empty_exit" type="once" segment="base" speed="1.0">
		<anim name="r6_reload_not_empty_exit"/>
		<keys>
				<key at="trigger" trigger="wp_m1873_lever_push" callback="play_sound" class_name="base" param1="wp_r6_lever_push"/>
				<key at="trigger" trigger="wp_m1873_lever_pull" callback="play_sound" class_name="base" param1="wp_r6_lever_pull"/>
				<key at="trigger" trigger="wp_m1873_bullet_in" callback="play_sound" class_name="base" param1="wp_r6_bullet_in"/>
				<key at="trigger" trigger="wp_m1873_casing_land" callback="play_sound" class_name="base" param1="wp_r6_casing_land"/>
				<key at="trigger" trigger="wp_ak47_tilt_back" callback="play_sound" class_name="base" param1="wp_ak47_tilt_back"/>
				<key at="trigger" trigger="wp_ak47_tilt" callback="play_sound" class_name="base" param1="wp_ak47_tilt"/>
				<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
			
			<key at="exit" callback="anim_clbk_stop_weapon_reload_all" class_name="base"/>
		</keys>
		<exit name="fps/idle"/>
		</state>
		
	</target>
		
	</tweak>
	

