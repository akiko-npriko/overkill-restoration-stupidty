<?xml version="1.0"?>
<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>

		<target mode="append">
			<state name="fps/reload/x_fmgnine" type="once" segment="base" speed="1.0">
				<anim name="x_fmgnine_reload"/>
				<keys>
					<key at="trigger" trigger="wp_foley_generic_lever_release" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_release"/>
					<key at="trigger" trigger="wp_foley_generic_clip_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_grab"/>
					<key at="trigger" trigger="wp_foley_generic_clip_throw" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_throw"/>
					<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
					<key at="trigger" trigger="wp_foley_generic_clip_in_connect" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_in_connect"/>
					<key at="trigger" trigger="wp_foley_generic_lever_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_grab"/>
					<key at="trigger" trigger="wp_foley_generic_lever_pull" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
					<key at="trigger" trigger="wp_foley_generic_back_in_hand" callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
					<key at="trigger" trigger="wp_clip_generic_smg_center" callback="play_sound" class_name="base" param1="wp_clip_generic_smg_center"/>
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base"/>
					
					<key at="trigger" trigger="wp_sr2_pick_up" callback="play_sound" class_name="base" param1="wp_sr2_pick_up"/>
					<key at="trigger" trigger="wp_sr2_grab_mag" callback="play_sound" class_name="base" param1="wp_sr2_grab_mag"/>
					<key at="trigger" trigger="wp_sr2_pull_out_mag" callback="play_sound" class_name="base" param1="wp_sr2_pull_out_mag"/>
					<key at="trigger" trigger="wp_sr2_put_in_mag" callback="play_sound" class_name="base" param1="wp_sr2_put_in_mag"/>
					<key at="trigger" trigger="wp_sr2_pull_lever" callback="play_sound" class_name="base" param1="wp_sr2_pull_lever"/>
					<key at="trigger" trigger="wp_sr2_release_lever" callback="play_sound" class_name="base" param1="wp_sr2_release_lever"/>
					<key at="trigger" trigger="wp_sr2_put_down" callback="play_sound" class_name="base" param1="wp_sr2_put_down"/>

					<key at="trigger" trigger="wp_akimbo_mag_grab" callback="play_sound" class_name="base" param1="wp_akmsu_x_take_new"/>
					<key at="trigger" trigger="wp_akimbo_mag_out" callback="play_sound" class_name="base" param1="wp_akmsu_x_clip_slide_out"/>
					<key at="trigger" trigger="wp_akimbo_mag_in" callback="play_sound" class_name="base" param1="wp_akmsu_x_clip_slide_in"/>
				</keys>
				<exit name="fps/idle"/>
			</state>

			<state name="fps/reload_not_empty/x_fmgnine" type="once" segment="base" speed="1.0">
				<anim name="x_fmgnine_reload_not_empty"/>
				<keys>	
					<key at="trigger" trigger="wp_foley_generic_lever_release" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_release"/>
					<key at="trigger" trigger="wp_foley_generic_clip_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_grab"/>
					<key at="trigger" trigger="wp_foley_generic_clip_throw" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_throw"/>
					<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
					<key at="trigger" trigger="wp_foley_generic_clip_in_connect" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_in_connect"/>
					<key at="trigger" trigger="wp_foley_generic_back_in_hand" callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
					<key at="trigger" trigger="wp_clip_generic_smg_center" callback="play_sound" class_name="base" param1="wp_clip_generic_smg_center"/>
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base"/>
					
					<key at="trigger" trigger="wp_sr2_pick_up" callback="play_sound" class_name="base" param1="wp_sr2_pick_up"/>
					<key at="trigger" trigger="wp_sr2_grab_mag" callback="play_sound" class_name="base" param1="wp_sr2_grab_mag"/>
					<key at="trigger" trigger="wp_sr2_pull_out_mag" callback="play_sound" class_name="base" param1="wp_sr2_pull_out_mag"/>
					<key at="trigger" trigger="wp_sr2_put_in_mag" callback="play_sound" class_name="base" param1="wp_sr2_put_in_mag"/>
					<key at="trigger" trigger="wp_sr2_put_down" callback="play_sound" class_name="base" param1="wp_sr2_put_down"/>

					<key at="trigger" trigger="wp_akimbo_mag_grab" callback="play_sound" class_name="base" param1="wp_akmsu_x_take_new"/>
					<key at="trigger" trigger="wp_akimbo_mag_out" callback="play_sound" class_name="base" param1="wp_akmsu_x_clip_slide_out"/>
					<key at="trigger" trigger="wp_akimbo_mag_in" callback="play_sound" class_name="base" param1="wp_akmsu_x_clip_slide_in"/>
				</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>

