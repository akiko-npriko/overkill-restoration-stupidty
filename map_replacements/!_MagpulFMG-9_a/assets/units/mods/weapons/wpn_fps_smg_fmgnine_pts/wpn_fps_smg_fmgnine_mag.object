	<animations>
		<animation_group name="reload">
			<object name="anim_mag_reload" enabled="true"/>
		</animation_group>
		<animation_group name="reload_not_empty">
			<object name="anim_mag_tact_reload" enabled="true"/>
		</animation_group>
