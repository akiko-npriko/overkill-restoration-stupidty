<?xml version="1.0"?>
<tweaks>	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps"/>
		</search>
		<target mode="attach">
			<to name="underbarrel_reload_xeno" redirect="fps/reload/underbarrel/xeno"/>
			<to name="underbarrel_reload_not_empty_xeno" redirect="fps/reload_not_empty/underbarrel/xeno"/>
			<to name="underbarrel_enter_xeno" redirect="fps/enter/underbarrel/xeno"/>
			<to name="underbarrel_exit_xeno" redirect="fps/exit/underbarrel/xeno"/>
		</target>
	</tweak>
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/idle"/>
			<anim name="m4_idle" weight="m4"/>
		</search>
		<target mode="append">
			<anim name="xeno_underbarrel_idle" weight="xeno_underbarrel * (1-steelsight_weight)"/>
		</target>
	</tweak>
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">

			<state name="fps/enter/underbarrel/xeno" type="once" segment="base" speed="1.0">
				<anim name="xeno_underbarrel_enter"/>
				<keys>
					<key at="trigger" trigger="wp_foley_generic_tilt" callback="play_sound" class_name="base" param1="wp_foley_generic_tilt"/>
					<key at="trigger" trigger="selector_switch" callback="play_sound" class_name="base" param1="arbiter_push_button"/>
					<key at="trigger" trigger="wp_foley_generic_tilt_back" callback="play_sound" class_name="base" param1="wp_foley_generic_tilt_back"/>
				</keys>
				<exit name="fps/idle/underbarrel/xeno"/>
			</state>

			<state name="fps/exit/underbarrel/xeno" type="once" segment="base" speed="1.0">
				<anim name="xeno_underbarrel_exit"/>
				<keys>
					<key at="trigger" trigger="wp_foley_generic_tilt" callback="play_sound" class_name="base" param1="wp_foley_generic_tilt"/>
					<key at="trigger" trigger="selector_switch" callback="play_sound" class_name="base" param1="arbiter_push_button"/>
					<key at="trigger" trigger="wp_foley_generic_tilt_back" callback="play_sound" class_name="base" param1="wp_foley_generic_tilt_back"/>
				</keys>
				<exit name="fps/idle"/>
			</state>

			<state name="fps/equip/underbarrel/xeno" type="mix" segment="base" speed="1.0">
				<anim name="xeno_underbarrel_equip"/>
			</state>

			<state name="fps/unequip/underbarrel/xeno" type="mix" segment="base" speed="1.0">
				<anim name="xeno_underbarrel_unequip"/>
			</state>

			<state name="fps/start_running/underbarrel/xeno" type="mix" segment="base" speed="1.0">
				<anim name="xeno_underbarrel_sprint_enter"/>
				<exit name="fps/running/underbarrel/xeno"/>
			</state>

			<state name="fps/running/underbarrel/xeno" type="mixloop" segment="base" speed="1.0">
				<anim name="xeno_underbarrel_sprint"/>
			</state>

			<state name="fps/stop_running/underbarrel/xeno" type="mix" segment="base" speed="2.0">
				<anim name="xeno_underbarrel_sprint_exit"/>
				<exit name="fps/idle/underbarrel/xeno"/>
			</state>

			<state name="fps/melee/underbarrel/xeno" type="mix" segment="base" speed="1.0">
				<anim name="xeno_underbarrel_melee"/>
				<keys>
					<key at="enter" callback="anim_clbk_stop_weapon_anim" class_name="base" param1="reload"/>
					<key at="enter" callback="play_sound" class_name="base" param1="m4_melee_attack"/>
				</keys>
				<exit name="fps/idle/underbarrel/xeno"/>
			</state>

			<state name="fps/melee_miss/underbarrel/xeno" type="mix" segment="base" speed="1.0">
				<anim name="xeno_underbarrel_melee_miss"/>
				<keys>
					<key at="enter" callback="anim_clbk_stop_weapon_anim" class_name="base" param1="reload"/>
					<key at="enter" callback="play_sound" class_name="base" param1="m4_melee_attack"/>
				</keys>
				<exit name="fps/idle/underbarrel/xeno"/>
			</state>

			<state name="fps/idle/underbarrel/xeno" type="mixloop" segment="base" speed="1.0">
				<anim name="xeno_underbarrel_idle"/>
			</state>

			<state name="fps/recoil/underbarrel/xeno" type="mixloop" segment="base" speed="1.0">
				<anim name="xeno_underbarrel_recoil"/>
			</state>

			<state name="fps/recoil_enter/underbarrel/xeno" type="once" segment="base" speed="1.0">
				<anim name="xeno_underbarrel_recoil_enter"/>
				<exit name="fps/idle/underbarrel/xeno"/>
			</state>

			<state name="fps/recoil_exit/underbarrel/xeno" type="once" segment="base" speed="1.0">
				<anim name="xeno_underbarrel_recoil_exit"/>
				<exit name="fps/idle/underbarrel/xeno"/>
			</state>

			<state name="fps/recoil_loop/underbarrel/xeno" type="mixloop" segment="base" speed="1.0">
				<anim name="xeno_underbarrel_recoil_loop"/>
			</state>

			<state name="fps/reload/underbarrel/xeno" type="once" segment="base" speed="1.0">
				<anim name="xeno_underbarrel_reload"/>
				<keys>
					<key at="trigger" trigger="wp_china_push_in_shell" callback="play_sound" class_name="base" param1="wp_china_push_in_shell"/>
					<key at="trigger" trigger="wp_china_pull_handle" callback="play_sound" class_name="base" param1="wp_china_pull_handle"/>
					<key at="trigger" trigger="wp_china_push_handle" callback="play_sound" class_name="base" param1="wp_china_push_handle"/>
					<key at="trigger" trigger="wp_foley_generic_lever_release" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_release"/>
					<key at="trigger" trigger="wp_foley_generic_lever_pull"  callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
					<key at="trigger" trigger="wp_foley_generic_back_in_hand" callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
					<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
					<key at="trigger" trigger="wp_foley_generic_tilt_back" callback="play_sound" class_name="base" param1="wp_foley_generic_tilt_back"/>
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle/underbarrel/xeno"/>
			</state>
			
			<state name="fps/reload_not_empty/underbarrel/xeno" type="once" segment="base" speed="1.0">
				<anim name="xeno_underbarrel_reload_not_empty"/>
				<keys>
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle/underbarrel/xeno"/>
			</state>
		</target>
	</tweak>
	
