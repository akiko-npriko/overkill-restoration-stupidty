<?xml version="1.0"?>



<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">
			<state name="fps/reload/sako_85" type="once" segment="base" speed="1.0">
				<anim name="sako_85_reload"/>
				<keys>
					<key at="enter" callback="anim_clbk_stop_weapon_magazine_empty" class_name="base" param1="reload"/>		
					
					<key at="trigger" trigger="wp_steyr_scout_reload_empty_bolt_out_up" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_empty_bolt_out_up"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_empty_bolt_out" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_empty_bolt_out"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_empty_mag_out" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_empty_mag_out"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_empty_mag_in" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_empty_mag_in"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_empty_mag_tap" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_empty_mag_tap"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_empty_bolt_in" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_empty_bolt_in"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_empty_bolt_in_down" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_empty_bolt_in_down"/>			
					<key at="trigger" trigger="wp_foley_generic_lever_pull" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
					<key at="trigger" trigger="wp_foley_generic_lever_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_grab"/>
					<key at="trigger" trigger="wp_foley_generic_lever_release" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_release"/>

					<key at="trigger" trigger="wp_steyr_scout_reload_mag_out_contact" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_mag_out_contact"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_mag_out" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_mag_out"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_mag_in" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_mag_in"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_mag_in_contact" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_mag_in_contact"/>			
					<key at="trigger" trigger="wp_foley_generic_clip_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_grab"/>
					<key at="trigger" trigger="wp_foley_generic_clip_throw" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_throw"/>
					<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
					<key at="trigger" trigger="wp_foley_generic_clip_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_grab"/>
			
			
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle"/>
			</state>
			
			
			<state name="fps/reload_not_empty/sako_85" type="once" segment="base" speed="1.0">
				<anim name="sako_85_reload_not_empty"/>
				<keys>
					<key at="enter" callback="anim_clbk_stop_weapon_magazine_empty" class_name="base" param1="reload"/>	
					
					<key at="trigger" trigger="wp_steyr_scout_reload_mag_out_contact" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_mag_out_contact"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_mag_out" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_mag_out"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_mag_in" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_mag_in"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_mag_in_contact" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_mag_in_contact"/>			
					<key at="trigger" trigger="wp_foley_generic_clip_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_grab"/>
					<key at="trigger" trigger="wp_foley_generic_clip_throw" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_throw"/>
					<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
					<key at="trigger" trigger="wp_foley_generic_clip_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_grab"/>
			
					<key at="trigger" trigger="wp_steyr_scout_reload_empty_bolt_out_up" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_empty_bolt_out_up"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_empty_bolt_out" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_empty_bolt_out"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_empty_mag_out" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_empty_mag_out"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_empty_mag_in" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_empty_mag_in"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_empty_mag_tap" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_empty_mag_tap"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_empty_bolt_in" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_empty_bolt_in"/>
					<key at="trigger" trigger="wp_steyr_scout_reload_empty_bolt_in_down" callback="play_sound" class_name="base" param1="wp_steyr_scout_reload_empty_bolt_in_down"/>			
					<key at="trigger" trigger="wp_foley_generic_lever_pull" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
					<key at="trigger" trigger="wp_foley_generic_lever_release" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_release"/>
					<key at="trigger" trigger="wp_foley_generic_lever_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_grab"/>

					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>
	
