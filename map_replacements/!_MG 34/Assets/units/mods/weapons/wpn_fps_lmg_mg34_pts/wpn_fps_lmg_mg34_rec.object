<dynamic_object>
    <diesel orientation_object="rp_wpn_fps_lmg_mg34_reciever" materials="units/mods/weapons/wpn_fps_lmg_mg34_pts/wpn_fps_lmg_mg34_rec" />
    
	<animations>
		<animation_group name="reload">
		  <object name="anim_draghandle_reload" enabled="true" />
		  <object name="anim_draghandle_reload" enabled="true" />
		  <object name="anim_dh_reload" enabled="true" />
		</animation_group>
		
		<animation_group name="reload_not_empty">
		  <object name="anim_draghandle_reload_not_empty" enabled="true" />
		  <object name="anim_draghandle_reload_not_empty" enabled="true" />
		  <object name="anim_dh_reload_not_empty" enabled="true" />
		</animation_group>
		
		<animation_group name="recoil">
		</animation_group>
	</animations>
	
	<graphics>
        <object enabled="true" name="g_base" />
        <object enabled="true" name="g_handle" />
    </graphics>
</dynamic_object>
