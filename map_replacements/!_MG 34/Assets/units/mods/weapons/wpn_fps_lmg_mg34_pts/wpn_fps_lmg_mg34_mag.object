<dynamic_object>
    <diesel orientation_object="rp_wpn_fps_lmg_mg34_mag" materials="units/mods/weapons/wpn_fps_lmg_mg34_pts/wpn_fps_lmg_mg34_mag" />
    
	<animations>
		<animation_group name="reload">
		  <object name="anim_mag_reload" enabled="true" />
		  <object name="a_belt_2_reload" enabled="true" />
		  <object name="a_belt_3_reload" enabled="true" />
		  <object name="a_belt_4_reload" enabled="true" />
		   <object name="anim_mag_handle_reload" enabled="true" />
		</animation_group>
		
		<animation_group name="reload_not_empty">
		  <object name="anim_mag_reload_not_empty" enabled="true" />
		  <object name="a_belt_2_reload_not_empty" enabled="true" />
		  <object name="a_belt_3_reload_not_empty" enabled="true" />
		  <object name="a_belt_4_reload_not_empty" enabled="true" />
		  <object name="anim_mag_handle_not_empty" enabled="true" />
		</animation_group>
		
		<animation_group name="recoil">
		</animation_group>
	</animations>
	
	<graphics>
        <object enabled="true" name="g_mag_handle" />
        <object enabled="true" name="g_mag" />
		
        <object enabled="true" name="g_bullet_1" />
        <object enabled="true" name="g_bullet_2" />
        <object enabled="true" name="g_bullet_3" />
        <object enabled="true" name="g_bullet_4" />
        <object enabled="true" name="g_bullet_5" />
        <object enabled="true" name="g_bullet_6" />
    </graphics>
</dynamic_object>
