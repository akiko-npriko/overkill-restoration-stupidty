<dynamic_object>
    <diesel orientation_object="rp_wpn_fps_pis_c96_b_standard" materials="units/mods/weapons/wpn_fps_pis_c96_pts/wpn_fps_pis_c96_b_finned_hammer" />
    <animations>		
		<animation_group name="reload" enabled="false" >
			<object name="a_reload_not_empty" />
		</animation_group>
		<animation_group name="reload_not_empty" enabled="false" >
			<object name="a_reload" />
		</animation_group>
		<animation_group name="recoil" enabled="false" >
			<object name="a_recoil" />
			<object name="a_recoil_hammer" />
		</animation_group>
		<animation_group name="last_recoil" enabled="false" >
			<object name="a_last_recoil" />
		</animation_group>
	</animations>
    <graphics>
        <object enabled="true" name="g_bolt_lod0" />
        <object enabled="true" name="g_hammer_lod0" />
        <object enabled="true" name="g_barrel_lod0" />
    </graphics>
</dynamic_object>
