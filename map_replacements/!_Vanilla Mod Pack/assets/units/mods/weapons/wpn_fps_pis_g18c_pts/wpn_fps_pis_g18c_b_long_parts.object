<dynamic_object>
    <diesel orientation_object="rp_wpn_fps_pis_g18c_b_standard" materials="units/mods/weapons/wpn_fps_pis_g18c_pts/wpn_fps_pis_g18c_b_long_parts"/>
    <animations>
		<animation_group name="reload">
			<object name="anim_reload" enabled="true"/>
		</animation_group>
		<animation_group name="reload_right">
			<object name="akimbo_anim_bolt_reload_right" enabled="true"/>
		</animation_group>
		<animation_group name="reload_left">
			<object name="akimbo_anim_bolt_reload_left" enabled="true"/>
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_bolt_recoil" enabled="true"/>
		</animation_group>
		<animation_group name="last_recoil">
			<object name="anim_bolt_last_recoil" enabled="true"/>
		</animation_group>
    </animations>
    <graphics>
        <object enabled="true" name="g_slide_lod0"/>
        <object name="g_no_blurr" enabled="true"/>
    </graphics>
</dynamic_object>