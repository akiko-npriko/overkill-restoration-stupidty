<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_smg_mac10_pts/wpn_fps_smg_mac10_body_m4" orientation_object="rp_wpn_fps_smg_mac10_body_m4"/>

	<animations>	
		<animation_group name="reload" >
			<object name="anim_bolt_reload" enabled="true"/>
		</animation_group>	

		<animation_group name="recoil">
			<object name="anim_bolt_recoil" enabled="true"/>
		</animation_group>	
	</animations>

	<graphics>
		<object name="g_body_draghandle" enabled="true"/>
		<object name="g_body" enabled="true"/>
		<object name="g_no_blurr" enabled="true"/>
	</graphics>
</dynamic_object>
