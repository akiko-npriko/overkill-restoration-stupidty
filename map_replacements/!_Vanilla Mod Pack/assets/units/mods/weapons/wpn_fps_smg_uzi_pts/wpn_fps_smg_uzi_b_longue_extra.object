<dynamic_object>
    <diesel orientation_object="rp_wpn_fps_smg_uzi_body_standard" materials="units/mods/weapons/wpn_fps_smg_uzi_pts/wpn_fps_smg_uzi_b_longue_extra"/>
    <animations>		
		<animation_group name="reload" enabled="false">
			<object name="a_reload"/>
			<object name="a_reload_sling"/>
		</animation_group>
		<animation_group name="reload_not_empty" enabled="false">
			<object name="a_reload_sling_not_empty"/>
		</animation_group>
		<animation_group name="recoil" enabled="false">
			<object name="a_recoil"/>
			<object name="a_recoil_sling"/>
		</animation_group>
	</animations>
    <graphics>
        <object enabled="true" name="g_body_lod0"/>
        <object enabled="false" name="g_bolt_lod0"/>
        <object enabled="false" name="g_sling_mount_lod0"/>
    </graphics>
</dynamic_object>