<dynamic_object>
	<diesel orientation_object="rp_wpn_fps_pis_x_shrew" />
	<animations>
		<animation_group name="reload_right" enabled="false" >
		  <object name="anim_reload_right_bolt" enabled="true" />
		  <object name="anim_barrel_reload_right" enabled="true" />
		  <object name="anim_m_reload" enabled="true" />
		</animation_group>
		<animation_group name="reload_left" enabled="false" >
		  <object name="anim_reload_left_bolt" enabled="true" />
		  <object name="anim_barrel_reload_left" enabled="true" />
		  <object name="anim_m_reload_left" enabled="true" />
		</animation_group>
		
		<animation_group name="recoil">
		  <object name="anim_recoil_bolt" enabled="true" />
		  <object name="anim_h_recoil" enabled="true" />
		</animation_group>
		<animation_group name="last_recoil">
		  <object name="anim_last_recoil_bolt" enabled="true" />
		  <object name="anim_last_recoil" enabled="true" />
		</animation_group>				
		<animation_group name="reload_not_empty_right" enabled="false" >
		  <object name="anim_m_reload_not_empty" enabled="true" />
		</animation_group>			
		<animation_group name="reload_not_empty_left" enabled="false" >
		  <object name="anim_m_reload_not_empty_left" enabled="true" />
		</animation_group>	
	</animations>
</dynamic_object>
