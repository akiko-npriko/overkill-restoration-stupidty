	<graphics>
		<object name="g_mag" enabled="true" />
		<object name="g_bullet_1" enabled="false" />
		<object name="g_boolet_1" enabled="true" />
		<object name="g_bullet_2" enabled="false" />
		<object name="g_bullet_3" enabled="false" />
	</graphics>
</dynamic_object>
