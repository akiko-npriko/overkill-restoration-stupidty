<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_pis_smolak_pts/wpn_fps_pis_smolak_m_custom_extra" orientation_object="rp_wpn_fps_ass_asval_m_standard" />
		
	<animations>
