<dynamic_object>
    <diesel orientation_object="rp_wpn_fps_shot_benelli_body_standard" materials="units/mods/weapons/wpn_third_shot_minibeck_pts/wpn_third_shot_minibeck_body_standard"/>    
   <animations>
		<animation_group name="reload">
		  <object name="anim_bolt_reload" enabled="true"/>
		</animation_group>
		<animation_group name="recoil">
		  <object name="anim_bolt_recoil" enabled="true"/>
		</animation_group>
	</animations>
	<graphics>
       		<graphic_group name="character" enabled="true" culling_object="g_bolt_lod0">
        <object enabled="true" inherit_bounding_volume="co_culling" name="g_bolt_lod0" />
	</graphic_group>
        <object enabled="false" name="g_body_lod0"/>
    </graphics>
</dynamic_object>