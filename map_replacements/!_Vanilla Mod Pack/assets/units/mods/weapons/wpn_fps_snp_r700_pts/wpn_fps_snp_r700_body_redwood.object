<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_snp_r700_pts/wpn_fps_snp_r700_body_redwood" orientation_object="rp_wpn_fps_snp_r700_body_standard" />
		
	<animations>

		<animation_group name="reload" enabled="false">
		  <object name="anim_mag_release_reload" enabled="true" />			
		</animation_group>

		<animation_group name="reload_not_empty" enabled="false">
		  <object name="anim_mag_release_reload_not_empty" enabled="true" />
		</animation_group>


	</animations>

	<graphics>
		<object name="g_rec" enabled="true"/>
		<object name="g_release" enabled="true"/>
	</graphics>

</dynamic_object>
