<dynamic_object>
	<diesel orientation_object="rp_wpn_fps_pis_x_beer" />
	<animations>		
		<animation_group name="recoil" enabled="false">
		  <object name="anim_recoil" enabled="true" />
		  <object name="anim_bolt_recoil" enabled="true" />
		  <object name="anim_dh_recoil" enabled="true" />
		</animation_group>
		<animation_group name="last_recoil" enabled="false">
		  <object name="anim_last_recoil" enabled="true" />
		  <object name="anim_dh_last_recoil" enabled="true" />
		</animation_group>
		
		<!-- AKIMBO -->
		<animation_group name="reload_right"  enabled="false" > 
			<object name="anim_bolt_reload_right" enabled="true" />
			<object name="anim_m_reload" enabled="true" />
		</animation_group>
		<animation_group name="reload_left" enabled="false">
			<object name="anim_bolt_reload_left" enabled="true" />
			<object name="anim_m_reload_left" enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty_right" enabled="false">
			<object name="anim_m_reload_not_empty" enabled="true" />
        </animation_group>
		<animation_group name="reload_not_empty_left" enabled="false">
			<object name="anim_reload_not_empty_left" enabled="true" />
        </animation_group>
	</animations>
</dynamic_object>