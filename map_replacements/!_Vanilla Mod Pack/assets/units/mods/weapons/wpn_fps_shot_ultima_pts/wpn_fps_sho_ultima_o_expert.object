<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_shot_ultima_pts/wpn_fps_sho_ultima_o_expert" orientation_object="rp_wpn_fps_sho_ultima_body_standard" />

	<animations>	
		<animation_group name="recoil">
			<object name="a_bolt_recoil" enabled="true" />
    	</animation_group>

    	<animation_group name="reload">
    		<object name="a_bolt_reload" enabled="true" />
    		<object name="a_reload" enabled="true" />
    	</animation_group>

    	<animation_group name="reload_not_empty">
    		<object name="a_reload_not_empty" enabled="true" />
    	</animation_group>
</animations>

	<graphics>
		<object name="g_body" enabled="true" />
	</graphics>

</dynamic_object>
