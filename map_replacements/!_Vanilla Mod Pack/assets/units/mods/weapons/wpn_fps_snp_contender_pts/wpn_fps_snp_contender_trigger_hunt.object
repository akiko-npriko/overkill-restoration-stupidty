<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_snp_contender_pts/wpn_fps_snp_contender_trigger_hunt" orientation_object="rp_wpn_fps_snp_contender_triggerguard" />
	<graphics>
		<object name="g_trigger_guard" enabled="true" />
	</graphics>
    <animations>
		<animation_group name="reload" >
			<object name="anim_trigger_guard_reload" enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty" >
			<object name="anim_trigger_guard_reload_not_empty" enabled="true" />
		</animation_group>
	</animations>
</dynamic_object>
