<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_snp_contender_pts/wpn_fps_snp_contender_receiver_hunt" orientation_object="rp_wpn_fps_snp_contender_receiver" />
	<graphics>
		<object name="g_receiver" enabled="true" />
		<object name="g_hammer" enabled="true" />
		<object name="g_trigger" enabled="true" />
	</graphics>
    <animations>
		<animation_group name="recoil" >
			<object name="anim_trigger_recoil" enabled="true" />
		</animation_group>
		<animation_group name="reload" >
			<object name="anim_cocking_lever_reload" enabled="true" />
		</animation_group>
			<animation_group name="reload_not_empty" >
		<object name="anim_cocking_lever_reload_not_empty" enabled="true" />
		</animation_group>
			<animation_group name="recoil" >
		<object name="anim_cocking_lever_recoil" enabled="true" />
		</animation_group>
	</animations>
</dynamic_object>
