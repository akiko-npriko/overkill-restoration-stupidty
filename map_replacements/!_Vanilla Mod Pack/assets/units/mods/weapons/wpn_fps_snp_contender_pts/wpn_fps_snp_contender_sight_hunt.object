<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_snp_contender_pts/wpn_fps_snp_contender_sight_hunt" orientation_object="rp_wpn_fps_snp_contender_barrel_standard" />
	<graphics>
		<object name="g_bullet" enabled="false" />
		<object name="g_barrel_standard" enabled="true" />
	</graphics>
    <animations>
		<animation_group name="reload" >
			<object name="anim_barrel_reload" enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty" >
			<object name="anim_barrel_reload_not_empty" enabled="true" />
		</animation_group>
		<animation_group name="reload" >
			<object name="anim_bullet_reload" enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty" >
			<object name="anim_bullet_reload_not_empty" enabled="true" />
		</animation_group>
	</animations>
</dynamic_object>
