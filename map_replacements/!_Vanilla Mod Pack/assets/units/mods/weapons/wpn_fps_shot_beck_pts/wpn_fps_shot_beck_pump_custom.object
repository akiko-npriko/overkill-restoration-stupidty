<dynamic_object>
    <diesel materials="units/mods/weapons/wpn_fps_shot_beck_pts/wpn_fps_shot_beck_pump_custom" orientation_object="rp_wpn_fps_shot_r870_fg_big"/>
	  <animations>	
<animation_group name="recoil">
		<object name="anim_bolt_recoil" enabled="true" />
    </animation_group>
    <animation_group name="recoil_zoom">
		<object name="anim_bolt_recoil_zoom" enabled="true" />
    </animation_group>
    <animation_group name="reload_exit">
    <object name="anim_bolt_reload_exit" enabled="true" />
    </animation_group>
</animations>
      <graphics>
		<graphic_group name="character" enabled="true" culling_object="g_bigpump">
        <object enabled="true" inherit_bounding_volume="co_culling" name="g_bigpump" />
	</graphic_group>
    </graphics>
</dynamic_object>
