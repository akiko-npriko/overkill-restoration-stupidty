<unit type="bnk" slot="1" >
    <object file="units/pd2_mod_score/equipment/score_bnk_trolly_caged/score_bnk_trolly_caged" />
	<network sync="spawn"/>
	<extensions>
		<extension name="base" class="MissionDoor" >
			<var name="tweak_data" value="score_door_trolley" />
		</extension>
		<extension class="ScriptUnitData" name="unit_data" />
		<extension name="damage" class="UnitDamage" />
		<extension name="waypoint" class="WaypointExt" />
		<extension name="sync_unit_data" class="SyncUnitData" />
	</extensions>
</unit>
