<unit type="bnk" slot="1" >
    <object file="units/pd2_mod_score/equipment/score_bnk_trolly_caged/score_bnk_trolly_money" />
	<network sync="spawn"/>
	<extensions>
		<extension name="unit_data" class="ScriptUnitData" />
		<extension name="damage" class="UnitDamage" />
		<extension name="interaction" class="CarryInteractionExt">
			<var name="tweak_data" value="money_small" />
			<var name="_interact_object" value="interact"/>
			<var name="_ray_object_names" type="table" >
				<var value="interact"/>
			</var>
			<var name="_remove_on_interact" value="false" />
			<var name="_global_event" value="pku_money" />
		</extension>
		<extension name="carry_data" class="CarryData">
			<var name="_carry_id" value="money" />
		</extension>
	</extensions>
</unit>
