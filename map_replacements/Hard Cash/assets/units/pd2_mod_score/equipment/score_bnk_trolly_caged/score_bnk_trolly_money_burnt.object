<?xml version="1.0" ?>
<dynamic_object>
	<diesel materials="units/pd2_mod_score/equipment/score_bnk_trolly_caged/score_bnk_trolly_money_burnt" orientation_object="rp_root" />
	<sequence_manager file="units/pd2_mod_score/equipment/score_bnk_trolly_caged/score_bnk_trolly_money" />
    <bodies>
        <body name="cash_full_body" template="static" enabled="true" >
            <object name="rp_root"/>
			<object name="g_money_full" collision_type="box" padding="-2.5"/>
        </body>
        <body name="cash_half_body" template="static" enabled="false" >
			<object name="g_money_half" collision_type="box" padding="-2.5"/>
        </body>
    </bodies>
	
	<graphics>
		<graphic_group name="g_group" enabled="true" culling_object="co_culling">
			<object name="g_money_full"	enabled="true" 	shadow_caster="true"/>
			<object name="g_money_half"	enabled="false"	shadow_caster="true"/>
		</graphic_group>
	</graphics>
</dynamic_object> 