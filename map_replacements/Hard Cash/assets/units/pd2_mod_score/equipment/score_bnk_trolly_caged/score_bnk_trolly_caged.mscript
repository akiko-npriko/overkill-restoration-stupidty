		<position x="0" y="0" z="90" />
		<rotation w="1" x="0" y="0" z="0" />
	</object3d>
	<object3d name="a_box_004" mode="add">
		<parent name="rp_root" />
		<position x="28" y="-50" z="10" />
		<rotation w="1" x="0" y="0" z="0" />
