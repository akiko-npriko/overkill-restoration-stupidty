<dynamic_object>
    <diesel orientation_object="rp_wpn_fps_snp_msr_body_msr" materials="units/mods/weapons/wpn_fps_snp_tac50_pts/wpn_fps_snp_tac50_body" />
   <animations>
		<animation_group name="reload">
		  <object name="anim_bolt_reload" enabled="true" />
		  <object name="anim_bolt_reload_rotate" enabled="true" />
		</animation_group>
		<animation_group name="recoil">
		  <object name="anim_bolt_recoil" enabled="true" />
		  <object name="anim_bolt_recoil_rotate" enabled="true" />
		</animation_group>
	</animations>
    <graphics>
        <object enabled="true" name="g_bolt" />
        <object enabled="true" name="g_firingpin" />
        <object enabled="true" name="g_receiver" />
        <object enabled="true" inherit_bounding_volume="co_culling" name="g_body" />
    </graphics>
</dynamic_object>
