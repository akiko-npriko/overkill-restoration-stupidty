<?xml version="1.0" ?>
<small_prop_object>
	<diesel materials="units/pvsmg/skins/pvsmg/pvsmg" orientation_object="root_point"/>
	
	<!-- Some of the co boxes makes the belt on the hips look buggy, so i changed collision grouping and collider groups lol, it may clip with the legs sometimes, but its better than it looking like shit-->
	<!-- Also this is all written by me-->
	<!-- Steal and I will kill you on a thursday!!-->
	<!-- You may not know which Thursday it will be, but it will be a fucking thursday alright-->
	<!-- Watch your back, kid!-->
	<!-- Drink some water :-)-->
	<!-- Stay frosty-->
	
	<bodies>
		<body name="Hips_belt_01" enabled="true" template="static" collision_class="hair" collision_group="7" collides_with="5" collides_with_mover="false" friction="0.01" keyframed="true" collision_script_quiet_time="0.05" collision_script_tag="small" ray="ignore" lin_damping="0" ang_damping="1" restitution="-10">
