<dynamic_object>
    <diesel materials="units/mods/weapons/wpn_fps_pis_degfifty_pts/wpn_fps_pis_degfifty_body_std" orientation_object="rp_wpn_fps_pis_deagle_body_standard"/>
     <animations>
		<animation_group name="reload">
			<object name="anim_bolt_reload" enabled="true" />
		</animation_group>
		<animation_group name="reload_right">
			<object name="anim_bolt_reload_right" enabled="true" />
		</animation_group>
		<animation_group name="reload_left">
			<object name="anim_bolt_reload_left" enabled="true" />
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_bolt_recoil" enabled="true" />
		</animation_group>
		<animation_group name="last_recoil">
			<object name="anim_bolt_last_recoil" enabled="true" />
		</animation_group>
    </animations>
	<graphics>
        <object enabled="true" name="g_body_deg50" />
        <object enabled="true" name="g_grip_deg50" />
		<object enabled="true" name="g_barrel_deg50" />
		<object enabled="true" name="g_slide_deg50" />
    </graphics>
</dynamic_object>
