<?xml version="1.0"?>
<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_subset">
		<search>
			<xml/>
		</search>
		
		<!--
			Replace all instances of 'degfifty' below with the ID of your animation.
			Note that recoil_steelsight does not have a unique animation in this degfifty; you can edit the filepath in the 'file' section with one if you wish.
			If your gun cannot be fired in full auto, you can delete the recoil_enter, recoil_loop, and recoil_exit lines.
		-->
		
		<target mode="attach">
			<anim name="degfifty_reload" 			file="anims/fps/degfifty/degfifty_reload" blend_set="all"/>
			<anim name="degfifty_reload_not_empty" 	file="anims/fps/degfifty/degfifty_reload_not_empty" blend_set="all"/>
			<anim name="degfifty_idle" 			file="anims/fps/degfifty/degfifty_idle" blend_set="all"/>
			<anim name="degfifty_recoil" 			file="anims/fps/degfifty/degfifty_recoil" blend_set="all"/>
			<anim name="degfifty_recoil_steelsight" 	file="anims/fps/degfifty/degfifty_recoil_steelsight" blend_set="all"/>
			<anim name="degfifty_equip" 			file="anims/fps/degfifty/degfifty_equip" blend_set="all"/>
			<anim name="degfifty_unequip" 			file="anims/fps/degfifty/degfifty_unequip" blend_set="all"/>
			<anim name="degfifty_melee" 			file="anims/fps/degfifty/degfifty_melee" blend_set="all"/>
			<anim name="degfifty_melee_miss" 		file="anims/fps/degfifty/degfifty_melee_miss" blend_set="all"/>
			<anim name="degfifty_use" 			file="anims/fps/degfifty/degfifty_use" blend_set="all"/>
			<anim name="degfifty_sprint_enter" 		file="anims/fps/degfifty/degfifty_sprint_enter" blend_set="all"/>
			<anim name="degfifty_sprint" 			file="anims/fps/degfifty/degfifty_sprint" blend_set="all"/>
			<anim name="degfifty_sprint_exit" 		file="anims/fps/degfifty/degfifty_sprint_exit" blend_set="all"/>
			<anim name="degfifty_com_down_var1" 		file="anims/fps/degfifty/degfifty_com_var1" blend_set="all"/>
			<anim name="degfifty_com_stop" 		file="anims/fps/degfifty/degfifty_com_var5" blend_set="all"/>
			<anim name="degfifty_com_come" 		file="anims/fps/degfifty/degfifty_com_var6" blend_set="all"/>
			<anim name="degfifty_com_point" 		file="anims/fps/degfifty/degfifty_com_var7" blend_set="all"/>
			<anim name="degfifty_get_up" 			file="anims/fps/degfifty/degfifty_getup" blend_set="all"/>
			<anim name="degfifty_gogo" 			file="anims/fps/degfifty/degfifty_gogo" blend_set="all"/>
			<anim name="degfifty_tased" 			file="anims/fps/degfifty/degfifty_tased" blend_set="all"/>
			<anim name="degfifty_tased_boost" 		file="anims/fps/degfifty/degfifty_tased_boost" blend_set="all"/>
			<anim name="degfifty_tased_exit" 		file="anims/fps/degfifty/degfifty_tased_exit" blend_set="all"/>
			<anim name="degfifty_inspect" 			file="anims/fps/degfifty/degfifty_inspect" blend_set="all"/>
		</target>
	</tweak>
</tweaks>