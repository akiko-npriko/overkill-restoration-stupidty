<dynamic_object>
	<diesel materials="units/pd2_dlc_tag/props/tag_prop_office_telephone/tag_prop_office_telephone" orientation_object="rp_are_prop_office_telephone" />
	<sequence_manager file="units/pd2_dlc_tag/props/tag_prop_office_telephone/tag_prop_office_telephone" />
	<bodies>
		<body name="body_static" enabled="true" template="static">
			<object name="rp_are_prop_office_telephone" />
			<object name="c_convex" collision_type="convex" padding="-2.5" />
		</body>
	</bodies>
	<decal_surfaces default_material="plastic">
		<decal_mesh name="dm_plastic" enabled="true" material="plastic" />
	</decal_surfaces>
	<graphics>
		<graphic_group name="grp_phone" enabled="true" >
		<lod_object name="grp_lod_g_telephone">
			<object name="g_telephone_lod0" enabled="true" max_distance="1500" />
			<object name="g_telephone_lod1" enabled="true" />
		</lod_object>
		<lod_object name="lod_outline">
			<object name="g_outline_lod0" enabled="true" max_distance="300" />
			<object name="g_outline_lod1" enabled="true" />
		</lod_object>
		</graphic_group>
	</graphics>
</dynamic_object>
