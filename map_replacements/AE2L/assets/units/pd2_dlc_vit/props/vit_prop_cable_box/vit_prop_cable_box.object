<dynamic_object>
    <diesel orientation_object="rp_vit_prop_cable_box" materials="units/pd2_dlc_vit/props/vit_prop_cable_box/vit_prop_cable_box" />
    <sequence_manager file="units/pd2_dlc_vit/props/vit_prop_cable_box/vit_prop_cable_box" />
    
	<animations>
		<animation_group name="ag_door">
			<object name="a_box_door" />
		</animation_group>
	</animations>

	<bodies>
		<body name="static_body" enabled="true" template="static">
			<object name="rp_vit_prop_cable_box" />
			<object name="c_box_01" collision_type="box" />
		</body>
		<body name="animated_body" enabled="true" template="animated" collides_with_mover="false">
			<object name="a_box_door" />
			<object name="c_box_02" collision_type="box" />
		</body>
	</bodies>

	<decal_surfaces default_material="metal" static="true">
		<decal_mesh name="dm_metal_fusebox_door" enabled="true" material="metal"/>
		<decal_mesh name="dm_metal_fusebox" enabled="true" material="metal"/>
	</decal_surfaces>
	
	<graphics>
		<graphic_group name="grp_outline" enabled="false">
			<lod_object name="lod_outline">
				<object name="g_outline_lod0" enabled="true"  max_distance="200" />
				<object name="g_outline_lod1" enabled="true" />
			</lod_object>
		</graphic_group>
		<graphic_group name="grp_box" enabled="true">
			<object enabled="true" name="g_fusebox" />
			<object enabled="true" name="g_fusebox_door" />
			<object name="g_cables_rest" enabled="true"/>
		</graphic_group>

		<graphic_group name="cable_red" enabled="false">
			<object name="g_cable_r" 		enabled="true"/>
			<object name="g_cable_r_dmg" 	enabled="false"/>
		</graphic_group>

		<graphic_group name="cable_green" enabled="false">
			<object name="g_cable_g" 		enabled="true"/>
			<object name="g_cable_g_dmg" 	enabled="false"/>
		</graphic_group>

		<graphic_group name="cable_blue" enabled="false">
			<object name="g_cable_b" 		enabled="true"/>
			<object name="g_cable_b_dmg" 	enabled="false"/>
		</graphic_group>

		<graphic_group name="cable_yellow" enabled="false">
			<object name="g_cable_y"		enabled="true"/>
			<object name="g_cable_y_dmg"	enabled="false"/>
		</graphic_group>
    </graphics>
</dynamic_object>
