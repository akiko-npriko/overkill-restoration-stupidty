<dynamic_object>
	<diesel materials="units/pd2_dlc_vit/architecture/vit_int/vit_int_trims/vit_int_trim_1_m" orientation_object="rp_vit_int_wall_book_shelf_2_m" />
	<sequence_manager file="units/pd2_dlc_vit/architecture/vit_int/vit_int_trims/vit_int_wall_book_shelf_2_m" />
	
	<animations>
		<animation_group name="grp_anim_door_left" enabled="false">
			<object name="anime_left" />			
		</animation_group>
		
		<animation_group name="grp_anim_door_right" enabled="false">
			<object name="anime_right" />			
		</animation_group>
	</animations>
	
	<bodies>
		<body name="body_static_left" enabled="true" template="static">
			<object name="rp_vit_int_wall_book_shelf_2_m" />			
			<object name="c_capsule_l_2" collision_type="capsule" padding="-2.5" />
			<object name="c_capsule_l_1" collision_type="capsule" padding="-2.5" />			
			<object name="c_box_left_13" collision_type="box" padding="-2.5" />
			<object name="c_box_left_12" collision_type="box" padding="-2.5" />
		</body>
		<body name="body_static_right" enabled="true" template="static">
			<object name="rp_vit_int_wall_book_shelf_2_m" />
			<object name="c_capsule_r_1" collision_type="capsule" padding="-2.5" />
			<object name="c_capsule_r_2" collision_type="capsule" padding="-2.5" />			
			<object name="c_box_right_24" collision_type="box" padding="-2.5" />
			<object name="c_box_right_25" collision_type="box" padding="-2.5" />			
		</body>
		<body name="door_collision_left" enabled="true" template="animated">
			<object name="anime_left" />
			<object name="c_box_left_01" collision_type="box" padding="-2.5"/>
			<object name="c_box_left_02" collision_type="box" padding="-2.5"/>
			<object name="c_box_left_03" collision_type="box" padding="-2.5"/>
			<object name="c_box_left_04" collision_type="box" padding="-2.5"/>
			<object name="c_box_left_05" collision_type="box" padding="-2.5"/>
			<object name="c_box_left_06" collision_type="box" padding="-2.5"/>
			<object name="c_box_left_07" collision_type="box" padding="-2.5"/>
			<object name="c_box_left_08" collision_type="box" padding="-2.5"/>
			<object name="c_box_left_09" collision_type="box" padding="-2.5"/>
			<object name="c_box_left_10" collision_type="box" padding="-2.5"/>
			<object name="c_box_left_11" collision_type="box" padding="-2.5"/>			
			<object name="c_convex_l_1" collision_type="convex" padding="-2.5" />
		</body>
		<body name="door_collision_right" enabled="true" template="animated">
			<object name="anime_right" />
			<object name="c_box_right_01" collision_type="box" padding="-2.5"/>
			<object name="c_box_right_02" collision_type="box" padding="-2.5"/>
			<object name="c_box_right_03" collision_type="box" padding="-2.5"/>
			<object name="c_box_right_04" collision_type="box" padding="-2.5"/>
			<object name="c_box_right_05" collision_type="box" padding="-2.5"/>
			<object name="c_box_right_06" collision_type="box" padding="-2.5"/>
			<object name="c_box_right_07" collision_type="box" padding="-2.5"/>
			<object name="c_box_right_08" collision_type="box" padding="-2.5"/>
			<object name="c_box_right_09" collision_type="box" padding="-2.5"/>
			<object name="c_box_right_10" collision_type="box" padding="-2.5"/>
			<object name="c_box_right_11" collision_type="box" padding="-2.5"/>
			<object name="c_convex_r_1" collision_type="convex" padding="-2.5"/>
		</body>				
		
	</bodies>
	<decal_surfaces default_material="thin_layer">
		<decal_mesh name="dm_concrete_left" enabled="true" material="concrete" />
		<decal_mesh name="dm_concrete_right" enabled="true" material="concrete" />
		<decal_mesh name="dm_metal_move_left" enabled="true" material="metal" />
		<decal_mesh name="dm_metal_move_right" enabled="true" material="metal" />
		<decal_mesh name="dm_metal_static_left" enabled="true" material="metal" />
		<decal_mesh name="dm_metal_static_right" enabled="true" material="metal" />
		<decal_mesh name="dm_wood_left" enabled="true" material="wood" />
		<decal_mesh name="dm_wood_right" enabled="true" material="wood" />
	</decal_surfaces>
	<graphics>
		<object name="g_g_shelf_side_left" enabled="true" instance_struct="world_tm"/>
		<object name="g_open_left" enabled="false" instance_struct="world_tm"/>
		<object name="g_g_shelf_side_right" enabled="false" instance_struct="world_tm"/>
		<object name="g_open_right" enabled="false" instance_struct="world_tm"/>
