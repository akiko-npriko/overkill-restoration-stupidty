<dynamic_object>
	<diesel materials="units/pd2_dlc_rvd/props/rvd_prop_nitrogen_canister/rvd_prop_nitrogen_canister" orientation_object="rp_rvd_interactable_nitrogen_canister" />
	<sequence_manager file="units/pd2_dlc_rvd/props/rvd_prop_nitrogen_canister/rvd_interactable_nitrogen_canister" />
		<animations>
	        <animation_group name="gouge_meter" enabled="false" >
				<object name="anim_locator" enabled="true"/>
	        </animation_group>
	    </animations>
	<bodies>
		<body name="body_static" enabled="true" template="static">
			<object name="rp_rvd_interactable_nitrogen_canister" />
			<object name="c_capsule_01" collision_type="capsule" padding="-2.5" />
		</body>
	</bodies>
	<effects>
		<effect_spawner name="nitrogen_smoke" enabled="false" object="e_effect" effect="effects/payday2/particles/smoke_trail/smoke_nitrogen" />
	</effects>
	<graphics>
		<graphic_group name="grp_canister" enabled="true">
			<object name="g_g" enabled="true" />
			<object name="g_gouge_meter" enabled="true" />
		</graphic_group>
		<graphic_group name="grp_outline" enabled="true">
		<lod_object name="lod_g_outline">
			<object name="g_outline_lod0" enabled="true" max_distance="1500" />
			<object name="g_outline_lod1" enabled="true" />
		</lod_object>
		</graphic_group>
	</graphics>
</dynamic_object>
