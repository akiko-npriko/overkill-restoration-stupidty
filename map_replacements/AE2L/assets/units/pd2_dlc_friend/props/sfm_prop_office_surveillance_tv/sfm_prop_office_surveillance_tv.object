<dynamic_object>
	<diesel materials="units/pd2_dlc_friend/props/sfm_prop_office_surveillance_tv/sfm_prop_office_surveillance_tv" orientation_object="rp_sfm_prop_office_surveillance_tv" />
	<sequence_manager file="units/pd2_dlc_friend/props/sfm_prop_office_surveillance_tv/sfm_prop_office_surveillance_tv" />
	<bodies>
		<body name="static_body" enabled="true" template="static">
			<object name="rp_sfm_prop_office_surveillance_tv" />
			<object name="c_box_01" collision_type="box" padding="-2.5" />
		</body>
		
		
	</bodies>

	<decal_surfaces >
		<decal_mesh name="dm_glass_breakable" enabled="true" material="glass_breakable" />
		<decal_mesh name="dm_plastic" enabled="true" material="plastic" />
	</decal_surfaces>

	<graphics>
		<lod_object name="lod_g">
			<object name="g_lod0" enabled="true" max_distance="5000" />
			<object name="g_lod1" enabled="true" />
		</lod_object>

		<graphic_group name="grp_static_a" enabled="true" >
			<lod_object name="lod_g_screen_a">
				<object name="g_screen_a_lod0" enabled="true" max_distance="5000" />
				<object name="g_screen_a_lod1" enabled="true" />
			</lod_object>
		</graphic_group>
		<graphic_group name="grp_static_b" enabled="true" >
			<lod_object name="lod_g_screen_b">
				<object name="g_screen_b_lod0" enabled="true" max_distance="5000" />
				<object name="g_screen_b_lod1" enabled="true" />
			</lod_object>
		</graphic_group>
		<graphic_group name="grp_static_c" enabled="true" >
			<lod_object name="lod_g_screen_c">
				<object name="g_screen_c_lod0" enabled="true" max_distance="5000" />
				<object name="g_screen_c_lod1" enabled="true" />
			</lod_object>
		</graphic_group>
		<graphic_group name="grp_static_d" enabled="true" >
			<lod_object name="lod_g_screen_d">
				<object name="g_screen_d_lod0" enabled="true" max_distance="5000" />
				<object name="g_screen_d_lod1" enabled="true" />
			</lod_object>
		</graphic_group>
		<graphic_group name="grp_static_e" enabled="true" >
			<lod_object name="lod_g_screen_e">
				<object name="g_screen_e_lod0" enabled="true" max_distance="5000" />
				<object name="g_screen_e_lod1" enabled="true" />
			</lod_object>
		</graphic_group>
		<graphic_group name="grp_static_f" enabled="true" >
			<lod_object name="lod_g_screen_f">
				<object name="g_screen_f_lod0" enabled="true" max_distance="5000" />
				<object name="g_screen_f_lod1" enabled="true" />
			</lod_object>
		</graphic_group>

		<graphic_group name="grp_dmg" enabled="false" >
			<lod_object name="lod_g_dmg_screen">
				<object name="g_dmg_screen_lod0" enabled="true" max_distance="5000" />
				<object name="g_dmg_screen_lod1" enabled="true" />
			</lod_object>
		</graphic_group>

		<object name="s_s" enabled="true" shadow_caster="true" />
	</graphics>

</dynamic_object>