			<object name="rp_suburbia_cellar_house2_stairs"/>
			<object name="c_bullet_box_001" collision_type="box" padding="-2"/>
			<object name="c_bullet_box_002" collision_type="box" padding="-2"/>
			<object name="c_bullet_box_003" collision_type="box" padding="-2"/>
