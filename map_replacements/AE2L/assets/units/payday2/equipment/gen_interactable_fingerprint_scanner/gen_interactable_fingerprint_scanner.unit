<?xml version="1.0"?>
<unit type="gen" slot="1">
	<object file="units/payday2/equipment/gen_interactable_fingerprint_scanner/gen_interactable_fingerprint_scanner" />
	<network sync="spawn"/>
	<extensions>
		<extension name="unit_data" class="ScriptUnitData" />
		<extension name="damage" class="UnitDamage" />
		<extension name="interaction" class="UseInteractionExt">
			<var name="tweak_data" value="fingerprint_scanner" />
			<var name="drop_in_sync_tweak_data" value="true" />
		</extension>
	</extensions>
</unit>