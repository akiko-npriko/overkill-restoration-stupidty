<dynamic_object>
	<diesel orientation_object="rp_gen_interactable_fingerprint_scanner" materials="units/payday2/equipment/gen_interactable_fingerprint_scanner/gen_interactable_fingerprint_scanner" />
	<sequence_manager file="units/payday2/equipment/gen_interactable_fingerprint_scanner/gen_interactable_fingerprint_scanner" />
	<bodies>
		<body name="body_scanner" enabled="true" template="static">
			<object name="rp_gen_interactable_fingerprint_scanner" />
			<object name="g_scanner" collision_type="box" padding="-2.5" />
		</body>
	</bodies>
	<graphics>
		<object name="g_display_access_granted"	enabled="false"/>
		<object name="g_display_enter_code"		enabled="false"/>
		<object name="g_display_place_thumb"	enabled="true"/>
		<object name="g_thumb"					enabled="false"/>
		<object name="g_contour"				enabled="false"/>
		<object name="g_scanner"				enabled="true"/>
		<graphic_group name="outline" enabled="false" >
			<lod_object name="lod_outline">
				<object name="g_outline_lod0" enabled="true"  max_distance="1000" />
				<object name="g_outline_lod1" enabled="true" />
			</lod_object>
		</graphic_group>

	</graphics>
</dynamic_object>