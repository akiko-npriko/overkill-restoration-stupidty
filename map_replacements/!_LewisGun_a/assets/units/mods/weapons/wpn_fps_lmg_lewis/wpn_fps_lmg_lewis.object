<dynamic_object>
	<diesel orientation_object="rp_wpn_fps_lmg_lewis"/>
	<animations>
		<animation_group name="equip">
			<object name="anim_carryhandle_equip" enabled="true"/>
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_bolt_recoil" enabled="true"/>
			<object name="anim_carryhandle_recoil" enabled="true"/>
		</animation_group>
		<animation_group name="reload">
			<object name="anim_bolt_reload" enabled="true"/>
			<object name="anim_bolt2_reload" enabled="true"/>
			<object name="anim_mag_reload" enabled="true"/>
			<object name="anim_mag2_reload" enabled="true"/>
		</animation_group>
		<animation_group name="reload_not_empty">
			<object name="anim_mag_tact_reload" enabled="true"/>
			<object name="anim_mag2_tact_reload" enabled="true"/>
		</animation_group>
	</animations>
</dynamic_object>