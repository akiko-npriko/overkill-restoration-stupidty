		<object name="g_bullet_6" enabled="true"/>
		<object name="g_bullet_7" enabled="true"/>
		<object name="g_bullet_8" enabled="true"/>
		<object name="g_bullet_9" enabled="true"/>
		<object name="g_bullet_10" enabled="true"/>
		<object name="g_bullet_11" enabled="true"/>
		<object name="g_bullet_12" enabled="true"/>
		<object name="g_bullet_13" enabled="true"/>
		<object name="g_bullet_14" enabled="true"/>
		<object name="g_bullet_15" enabled="true"/>
