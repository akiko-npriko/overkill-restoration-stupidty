<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_ass_sub2000_pts/wpn_fps_ass_sub2000_m_short" orientation_object="rp_wpn_fps_ass_sub2000_m_standard" />
			
	<animations>
    <animation_group name="reload" enabled="false">
		<object name="anim_mag_reload"/>
    </animation_group>
	
    <animation_group name="reload_not_empty" enabled="false">
		<object name="anim_mag_reload_not_empty"/>
    </animation_group>
	</animations>

	<graphics>
		<object name="g_mag" enabled="true" />
		<object name="g_ext" enabled="false" />
		<object name="g_bullet_1" enabled="true" />
		<object name="g_bullet_2" enabled="true" />
		<object name="g_bullet_3" enabled="true" />
	</graphics>
</dynamic_object>
