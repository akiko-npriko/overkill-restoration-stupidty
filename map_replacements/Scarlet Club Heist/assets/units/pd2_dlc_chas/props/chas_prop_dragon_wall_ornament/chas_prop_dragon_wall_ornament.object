<dynamic_object>
	<diesel materials="units/pd2_dlc_chas/props/chas_prop_dragon_wall_ornament/chas_prop_dragon_wall_ornament" orientation_object="rp_chas_prop_dragon_wall_ornament" />
	<bodies>
		<body name="body_static" enabled="true" template="static">
			<object name="rp_chas_prop_dragon_wall_ornament" />
			<object name="c_convex_01" collision_type="convex" padding="-2.5" />
			<object name="c_convex_05" collision_type="convex" padding="-2.5" />
			<object name="c_convex_02" collision_type="convex" padding="-2.5" />
			<object name="c_convex_03" collision_type="convex" padding="-2.5" />
			<object name="c_convex_04" collision_type="convex" padding="-2.5" />
			<object name="c_meshmop" collision_type="mesh_mopp" padding="-2.5" />
		</body>
	</bodies>
	<decal_surfaces default_material="stone">
		<decal_mesh name="dm_stone" enabled="true" material="stone" />
	</decal_surfaces>
	<graphics>
		<lod_object name="lod_g_dragon">
			<object name="g_dragon_lod0" enabled="true" max_distance="2000" />
			<object name="g_dragon_lod1" enabled="true" />
		</lod_object>
		<lod_object name="lod_g_wall_disc">
			<object name="g_wall_disc_lod0" enabled="true" max_distance="2000" />
			<object name="g_wall_disc_lod1" enabled="true" />
		</lod_object>
	</graphics>
</dynamic_object>
