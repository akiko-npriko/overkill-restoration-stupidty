<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/pd2_dlc_dah/architecture/dah_windows/dah_windows" orientation_object="rp_dah_ext_window_01_c" />
	<sequence_manager file="units/pd2_dlc_dah/architecture/dah_windows/dah_ext_window_01_c" />
	<bodies>
		<body name="window1" enabled="true" template="window">
			<object name="rp_dah_ext_window_01_c"/>
			<object name="c_box" collision_type="box" padding="-2" />
		</body>
		<body name="window1_hole" enabled="false" template="window">
			<object name="rp_dah_ext_window_01_c"/>
			<object name="c_meshmopp" collision_type="mesh_mopp"/>
		</body>
	</bodies>
	
	<graphics>
		<object name="g_1" enabled="true"/>
		<object name="g_2" enabled="false"/>
		<object name="g_3" enabled="false"/>
		<object name="g_4" enabled="false"/>
	</graphics>
	
	<decal_surfaces default_material="glass_breakable" static="true">
		<decal_mesh name="dm_1" enabled="true" material="glass_breakable" />
		<decal_mesh name="dm_2" enabled="false" material="glass_breakable" />
	</decal_surfaces>
	
	<objects>
		<align_point name="e_e" enabled="true" parent="rp_dah_ext_window_01_c" position="0 0 0" rotation="0 0 0" />
	</objects>
</dynamic_object>
