<?xml version="1.0" ?>
<dynamic_object>
	<diesel materials="units/payday2/architecture/sch_int_nightclub/sch_int_nightclub" orientation_object="rp_com_int_nightclub_window_large" />
	<sequence_manager file="units/payday2/architecture/sch_int_nightclub/sch_int_nightclub_window_large" />
	<bodies>
		
		<body name="body_window" enabled="true" template="static" remove_ray_type="vis_graph ai_vision">
			<object name="rp_com_int_nightclub_window_large" />
			<object name="g_window" collision_type="box" padding="-2.5" />
		</body>
	
	</bodies>

	<decal_surfaces default_material="glass_breakable" static="true">
		<decal_mesh name="dm_glass_breakable" 	enabled="true" material="glass_breakable" />
	</decal_surfaces>

	<graphics>
		<object name="g_window" 	enabled="true" shadow_caster="false"	/>
		<object name="g_window_dmg" enabled="false" shadow_caster="false"	/>
		<object name="g_frame" 	enabled="true" shadow_caster="false"	/>
	</graphics>
</dynamic_object>