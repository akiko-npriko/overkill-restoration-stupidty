<?xml version="1.0" ?>
<dynamic_object>
	<diesel materials="units/payday2/architecture/sch_int_nightclub/sch_int_nightclub" orientation_object="rp_com_int_nightclub_wall_2m_glass_door" />
	<sequence_manager file="units/payday2/architecture/sch_int_nightclub/sch_int_nightclub_wall_2m_glass_door" />
	<bodies>
		<body name="body_frame" enabled="true" template="static">
			<object name="rp_com_int_nightclub_wall_2m_glass_door" />
			<object name="c_hcm_int_wall_2m_b_glass" collision_type="mesh_mopp" />
		</body>
		<body name="body_window_left" enabled="true" template="static" remove_ray_type="vis_graph ai_vision">
			<object name="rp_com_int_nightclub_wall_2m_glass_door" padding="-2.5"/>
			<object name="g_window_left" collision_type="box" />
		</body>
		<body name="body_window_right" enabled="true" template="static" remove_ray_type="vis_graph ai_vision">
			<object name="rp_com_int_nightclub_wall_2m_glass_door" />
			<object name="g_window_right" collision_type="box" padding="-2.5"/>
		</body>
		<body name="body_window_top" enabled="true" template="static" remove_ray_type="vis_graph ai_vision">
			<object name="rp_com_int_nightclub_wall_2m_glass_door" />
			<object name="g_window_top" collision_type="box" padding="-2.5"/>
		</body>
	</bodies>

	<decal_surfaces default_material="glass_breakable" static="true">
		<decal_mesh name="dm_hcm_int_wall_2m_b_glass_wood" 	enabled="true" material="hardwood" />
		<decal_mesh name="dm_hcm_int_wall_2m_b_glass_metal" 	enabled="true" material="metal" />
		<decal_mesh name="g_window_left" 				enabled="true" material="glass_breakable" />
		<decal_mesh name="g_window_right" 				enabled="true" material="glass_breakable" />
		<decal_mesh name="g_window_top" 				enabled="true" material="glass_breakable" />
	</decal_surfaces>

	<graphics>
		<object name="g_hcm_int_wall_2m_b_glass" 	enabled="true" shadow_caster="false" />
		<object name="g_window_left" 				enabled="true" shadow_caster="false" />
		<object name="g_window_right" 				enabled="true" shadow_caster="false" />
		<object name="g_window_top" 				enabled="true" shadow_caster="false" />
	</graphics>
</dynamic_object>