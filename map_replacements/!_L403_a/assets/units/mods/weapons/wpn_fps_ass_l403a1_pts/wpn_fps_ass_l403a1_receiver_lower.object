<?xml version="1.0"?>
<dynamic_object>
  <diesel materials="units/mods/weapons/wpn_fps_ass_l403a1_pts/wpn_fps_ass_l403a1_receiver_lower" orientation_object="rp_receiver_lower" />
     <animations>

    <animation_group name="reload">
      <object name="anim_reload_mag_release" enabled="true" />
      <object name="anim_reload_empty_bolt_catch" enabled="true" />
      <object name="anim_reload_empty_bolt_catch_ambi" enabled="true" />
    </animation_group>    
	<animation_group name="reload_not_empty">
      <object name="anim_reload_not_empty_mag_release" enabled="true" />
    </animation_group>
  </animations>
  <graphics>

		<object  name="g_bolt_catch" enabled="true" />
		<object  name="g_mag_catch" enabled="true" />
		<object  name="g_mag_release" enabled="true" />
		<object  name="g_bolt_catch_ambi" enabled="true" />
		<object  name="g_castle_nut" enabled="true" />
		<object  name="g_hammer" enabled="true" />
		<object  name="g_mag_release_left" enabled="true" />
		<object  name="g_sear" enabled="true" />
		<object  name="g_sling_mount" enabled="true" />
		<object  name="g_receiver_lower" enabled="true" />
		<object  name="g_trigger" enabled="true" />
		<object  name="g_trigger_guard" enabled="true" />
		<object  name="g_selector" enabled="true" />

		

  </graphics>
</dynamic_object>
