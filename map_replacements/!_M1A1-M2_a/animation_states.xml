<?xml version="1.0"?>
<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">
			<state name="fps/reload_not_empty/m1a1" type="once" segment="base" speed="1.0">
				<anim name="m1a1_reload_not_empty"/>
				<keys>
					<key at="trigger" trigger="wp_m1carbine_tilt" 				callback="play_sound" class_name="base" param1="wp_ak47_tilt"/>
					<key at="trigger" trigger="wp_m1carbine_mag_grab" 			callback="play_sound" class_name="base" param1="wp_m16_clip_grab"/>
					<key at="trigger" trigger="wp_m1carbine_mag_out" 			callback="play_sound" class_name="base" param1="wp_m14_clip_slide_out"/>
					<key at="trigger" trigger="wp_m1carbine_mag_in" 			callback="play_sound" class_name="base" param1="wp_m4_clip_slide_in"/>
					<key at="trigger" trigger="wp_m1carbine_bolt_pull_release" 	callback="play_sound" class_name="base" param1="wp_m14_lever_release"/>
					<key at="trigger" trigger="wp_m1carbine_back_in_hand" 		callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
					<key at="trigger" trigger="bullet_show" 					callback="anim_clbk_check_bullet_object" class_name="base"/>
				</keys>
				<exit name="fps/idle"/>
			</state>

			<state name="fps/reload/m1a1" type="once" segment="base" speed="1.0">
				<anim name="m1a1_reload"/>
				<keys>
					<key at="trigger" trigger="wp_m1carbine_tilt" 				callback="play_sound" class_name="base" param1="wp_ak47_tilt"/>
					<key at="trigger" trigger="wp_m1carbine_mag_grab" 			callback="play_sound" class_name="base" param1="wp_m16_clip_grab"/>
					<key at="trigger" trigger="wp_m1carbine_mag_out" 			callback="play_sound" class_name="base" param1="wp_m14_clip_slide_out"/>
					<key at="trigger" trigger="wp_m1carbine_mag_in" 			callback="play_sound" class_name="base" param1="wp_m4_clip_slide_in"/>
					<key at="trigger" trigger="wp_m1carbine_bolt_pull_release" 	callback="play_sound" class_name="base" param1="wp_m14_lever_release"/>
					<key at="trigger" trigger="wp_m1carbine_back_in_hand" 		callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
					<key at="trigger" trigger="bullet_show" 					callback="anim_clbk_check_bullet_object" class_name="base"/>
				</keys>
				<exit name="fps/idle"/>
			</state>

			<state name="fps/reload_not_empty/m2" type="once" segment="base" speed="1.0">
				<anim name="m2_reload_not_empty"/>
				<keys>
					<key at="trigger" trigger="wp_m1carbine_tilt" 				callback="play_sound" class_name="base" param1="wp_ak47_tilt"/>
					<key at="trigger" trigger="wp_m1carbine_mag_grab" 			callback="play_sound" class_name="base" param1="wp_m16_clip_grab"/>
					<key at="trigger" trigger="wp_m1carbine_mag_out" 			callback="play_sound" class_name="base" param1="wp_m14_clip_slide_out"/>
					<key at="trigger" trigger="wp_m1carbine_mag_in" 			callback="play_sound" class_name="base" param1="wp_m4_clip_slide_in"/>
					<key at="trigger" trigger="wp_m1carbine_bolt_pull_release" 	callback="play_sound" class_name="base" param1="wp_m14_lever_release"/>
					<key at="trigger" trigger="wp_m1carbine_back_in_hand" 		callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
					<key at="trigger" trigger="bullet_show" 					callback="anim_clbk_check_bullet_object" class_name="base"/>
				</keys>
				<exit name="fps/idle"/>
			</state>

			<state name="fps/reload/m2" type="once" segment="base" speed="1.0">
				<anim name="m2_reload"/>
				<keys>
					<key at="trigger" trigger="wp_m1carbine_tilt" 				callback="play_sound" class_name="base" param1="wp_ak47_tilt"/>
					<key at="trigger" trigger="wp_m1carbine_mag_grab" 			callback="play_sound" class_name="base" param1="wp_m16_clip_grab"/>
					<key at="trigger" trigger="wp_m1carbine_mag_out" 			callback="play_sound" class_name="base" param1="wp_m14_clip_slide_out"/>
					<key at="trigger" trigger="wp_m1carbine_mag_in" 			callback="play_sound" class_name="base" param1="wp_m4_clip_slide_in"/>
					<key at="trigger" trigger="wp_m1carbine_bolt_pull_release" 	callback="play_sound" class_name="base" param1="wp_m14_lever_release"/>
					<key at="trigger" trigger="wp_m1carbine_back_in_hand" 		callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
					<key at="trigger" trigger="bullet_show" 					callback="anim_clbk_check_bullet_object" class_name="base"/>
				</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>

