<?xml version="1.0"?>
<dynamic_object>
  <diesel materials="units/world/props/yacht/piano_grand/piano_grand" orientation_object="rp_lxy_prop_piano_grand" />
  <sequence_manager file="units/world/props/yacht/piano_grand/lxy_prop_piano_grand" />

  <animations>
      <animation_group name="lid" enabled="false">
        <object name="a_lid" />
        <object name="a_lid_arm" />
        <object name="a_lid_arm1" />
      </animation_group>
  </animations>

  <bodies>
    <body name="static_body" enabled="true" template="static">
        <object name="rp_lxy_prop_piano_grand"/>
      	<object collision_type="box" name="c_box_000" padding="-2"/>
      	<object collision_type="box" name="c_box_001" padding="-2"/>
      	<object collision_type="box" name="c_box_002" padding="-2"/>
      	<object collision_type="box" name="c_box_003" padding="-2"/>
      	<object collision_type="box" name="c_box_004" padding="-2"/>
      	<object collision_type="box" name="c_box_005" padding="-2"/>
      	<object collision_type="box" name="c_box_006" padding="-2"/>
      	<object collision_type="box" name="c_box_007" padding="-2"/>
      	<object collision_type="box" name="c_box_008" padding="-2"/>
      	<object collision_type="box" name="c_box_009" padding="-2"/>
      	<object collision_type="convex" name="c_convex_000" padding="-2"/>
    		<object collision_type="convex" name="c_convex_001" padding="-2"/>
    		<object collision_type="convex" name="c_convex_002" padding="-2"/>
    		<object collision_type="convex" name="c_convex_003" padding="-2"/>
    		<object collision_type="convex" name="c_convex_004" padding="-2"/>
    </body>
    <body name="lid" enabled="true" template="animated">
      <object name="a_lid" />
      <object name="c_convex_005" collision_type="convex" padding="-2" />
      <object name="c_convex_006" collision_type="convex" padding="-2" />
    </body>
    <body name="lid_arm" enabled="true" template="animated">
      <object name="a_lid_arm" />
      <object name="c_box_010" collision_type="box" padding="-2" />
    </body>
  </bodies>
  <decal_surfaces default_material="wood">
    <decal_mesh name="dm_lid" enabled="false"  material="wood"/>
    <decal_mesh name="dm_wood" enabled="true"  material="wood"/>
    <decal_mesh name="dm_metal" enabled="true" material="metal"/>
    <decal_mesh name="dm_plastic" enabled="true" material="plastic"/>
  </decal_surfaces>
  <graphics>
    <object name="g_g" enabled="true"  />
    <object name="g_lid" enabled="true"  />
    <object name="g_lid_arm" enabled="true"  />
    <object name="g_lid_arm1" enabled="false"  />
    <object name="g_lid_arm2" enabled="false"  />
  </graphics>
</dynamic_object>