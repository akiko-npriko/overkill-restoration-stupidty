<dynamic_object>
    <diesel orientation_object="rp_cas_prop_locker" materials="units/pd2_dlc_casino/props/cas_prop_locker/cas_prop_locker" />
    <sequence_manager file="units/pd2_dlc_casino/props/cas_prop_locker/cas_prop_locker" />
	<animations>
		<animation_group name="anim" enabled="false">
			<object name="a_door_joint" />
		</animation_group>
	</animations>


    <bodies>
        <body enabled="true" template="static" name="body_locker">
            <object name="rp_cas_prop_locker" />
            <object name="c_meshmopp_locker" collision_type="mesh_mopp" />
        </body>

        <body enabled="true" template="animated" name="body_door">
            <object name="a_door_joint" />
            <object name="c_meshmopp_door" collision_type="mesh_mopp" />
        </body>
    </bodies>
    <graphics>
        <object name="g_g" enabled="true" />
        <lod_object name="saw_icon">
			<object name="g_icon_saw"   enabled="true"  max_distance="450"  max_draw_lod="0" />
			<object name="g_icon_saw_lod01"  enabled="true"  lod="1" />
		</lod_object>
		<lod_object name="lockpick_icon">
			<object name="g_icon"   enabled="true"  max_distance="450"  max_draw_lod="0" />
			<object name="g_icon_lod01"  enabled="true"  lod="1" />
		</lod_object> 
    </graphics>
</dynamic_object>
