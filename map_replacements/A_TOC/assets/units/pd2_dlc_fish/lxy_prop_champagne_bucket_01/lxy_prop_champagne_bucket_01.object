<dynamic_object>
	<diesel materials="units/pd2_dlc_fish/lxy_prop_champagne_bucket_01/lxy_prop_champagne_bucket_01" orientation_object="rp_lxy_prop_champagne_bucket_01" />
	<sequence_manager file="units/pd2_dlc_fish/lxy_prop_champagne_bucket_01/lxy_prop_champagne_bucket_01" />
	<bodies>
		<body name="body_bucket" enabled="true" template="static">
			<object name="rp_lxy_prop_champagne_bucket_01" />
			<object name="c_mesh_mopp" collision_type="mesh_mopp" />	
		</body>
		
		<body name="body_ice" enabled="true" template="static">
			<object name="rp_lxy_prop_champagne_bucket_01" />
			<object name="c_mesh_mopp" collision_type="mesh_mopp" />
		</body>

		<body name="body_bottles" enabled="true" template="static">
			<object name="rp_lxy_prop_champagne_bucket_01" />
			<object name="c_box_01" collision_type="box" padding="-2.5" />
			<object name="c_box_02" collision_type="box" padding="-2.5" />
			<object name="c_box_03" collision_type="box" padding="-2.5" />
		</body>
	</bodies>

	<decal_surfaces default_material="glass">
		<decal_mesh name="dm_glass" enabled="true" material="glass" />
		<decal_mesh name="dm_metal" enabled="true" material="metal" />
	</decal_surfaces>

	<graphics>
		<graphic_group name="grp_bucket" enabled="true">
			<lod_object name="lod_g_bucket">
				<object name="g_bucket_lod0" enabled="true" max_distance="1500" />
				<object name="g_bucket_lod1" enabled="true" max_distance="3000" />
				<object name="g_bucket_lod2" enabled="true" />
			</lod_object>
		</graphic_group>

		<graphic_group name="grp_ice" enabled="true">
			<lod_object name="lod_g_ice">
				<object name="g_ice_lod0" enabled="true" max_distance="1500" />
				<object name="g_ice_lod1" enabled="true" max_distance="3000" />
				<object name="g_ice_lod2" enabled="true" />
			</lod_object>
		</graphic_group>

		<graphic_group name="grp_bottles" enabled="true">
			<lod_object name="lod_g_bottles" enabled="true">
				<object name="g_bottles_lod0" enabled="true" max_distance="1500" />
				<object name="g_bottles_lod1" enabled="true" max_distance="3000" />
				<object name="g_bottles_lod2" enabled="true" />
			</lod_object>
		</graphic_group>

		<object name="s_s_bottle" enabled="true" shadow_caster="true" />
		<object name="s_s_bucket" enabled="true" shadow_caster="true" />
	</graphics>
</dynamic_object>
