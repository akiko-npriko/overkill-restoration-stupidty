<dynamic_object>
	<diesel materials="units/pd2_dlc_fish/lxy_prop_table_dining_01/lxy_prop_table_dining_long_01" orientation_object="rp_lxy_prop_table_dining_round_01" />
	<sequence_manager file="units/pd2_dlc_fish/lxy_prop_table_dining_01/lxy_prop_table_dining_round_01" />
	
	<bodies>
		<body name="body_static" enabled="true" template="static">
			<object name="rp_lxy_prop_table_dining_round_01" />
			<object name="c_box_01" collision_type="box" padding="-2.5" />
			<object name="c_box_02" collision_type="box" padding="-2.5" />
			<object name="c_convex_01" collision_type="convex" padding="-2.5" />
		</body>
		<body name="body_static_skirt" enabled="false" template="static">
			<object name="rp_lxy_prop_table_dining_round_01" />
			<object name="c_convex_02" collision_type="convex" padding="-2.5" />
		</body>
	</bodies>

	<decal_surfaces >
		<decal_mesh name="dm_cloth" enabled="true" material="cloth" />
		<decal_mesh name="dm_metal" enabled="true" material="metal" />
		<decal_mesh name="dm_wood" enabled="true" material="wood" />
	</decal_surfaces>

	<graphics>
		<graphic_group name="main_grp" enabled="true">
			<lod_object name="lod_g">
				<object name="g_lod0" enabled="true" max_distance="1500" />
				<object name="g_lod1" enabled="true" max_distance="3000" />
				<object name="g_lod2" enabled="true" />
			</lod_object>
			<object name="s_s" enabled="true" shadow_caster="true" />
		</graphic_group>

		<graphic_group name="skirt_grp" enabled="false">	
			<lod_object name="lod_g_skirt">
				<object name="g_skirt_lod0" enabled="true" max_distance="1500" />
				<object name="g_skirt_lod1" enabled="true" max_distance="3000" />
				<object name="g_skirt_lod2" enabled="true" />
			</lod_object>		
			<object name="s_s1" enabled="true" shadow_caster="true" />
		</graphic_group>
			
	</graphics>

</dynamic_object>
