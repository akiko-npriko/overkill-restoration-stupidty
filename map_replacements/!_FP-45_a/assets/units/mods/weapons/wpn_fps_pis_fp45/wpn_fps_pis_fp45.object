		<animation_group name="reload">
			<object name="anim_boolet_reload" enabled="true"/>
			<object name="anim_case_reload" enabled="true"/>
			<object name="anim_gripcap_reload" enabled="true"/>
			<object name="anim_plunger_reload" enabled="true"/>
			<object name="anim_rearsight_reload" enabled="true"/>
			<object name="anim_slide_reload" enabled="true"/>
		</animation_group>
	</animations>
</dynamic_object>