		  <object name="anim_bolt_reload" enabled="true" />
		  <object name="anim_magazine_cover_reload" enabled="true" />
		  <object name="anim_magazine_reload" enabled="true" />
		  <object name="anim_magazine_extended_reload" enabled="true" />
		  <object name="anim_magazine_fast_reload" enabled="true" />
		  <object name="anim_magazine_release_reload" enabled="true" />
		</animation_group>		
		<animation_group name="reload_not_empty">
		  <object name="anim_magazine_cover_reload_not_empty" enabled="true" />
		  <object name="anim_magazine_reload_not_empty" enabled="true" />
		  <object name="anim_magazine_extended_reload_not_empty" enabled="true" />
		  <object name="anim_magazine_fast_reload_not_empty" enabled="true" />
		  <object name="anim_magazine_release_reload_not_empty" enabled="true" />
		</animation_group>
		<animation_group name="recoil">
