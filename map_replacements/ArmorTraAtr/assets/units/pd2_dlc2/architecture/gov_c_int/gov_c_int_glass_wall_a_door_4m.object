<dynamic_object>
    <diesel orientation_object="rp_gov_c_int_glass_wall_a_door_4m" materials="units/pd2_dlc2/architecture/gov_c_int/gov_c_int_glass_wall_a_door_4m" />
	<sequence_manager file="units/pd2_dlc2/architecture/gov_c_int/gov_c_int_glass_wall_a_door_4m"/>
    
	<bodies>
		<body enabled="true" template="static" name="static_body" >
				<object name="rp_gov_c_int_glass_wall_a_door_4m" />
				<object name="g_g"   collision_type="mesh_mopp"/>
		</body>
		
		<body enabled="true" template="static" name="glass_1_body" >
			<object name="e_glass_1" />
			<object name="c_box_01"  collision_type="box" padding="-2.5"/>
		</body>
		
		<body enabled="true" template="static" name="glass_2_body" >
			<object name="e_glass_2" />
			<object name="c_box_02"  collision_type="box" padding="-2.5"/>
		</body>
		
		<body enabled="true" template="static" name="glass_3_body" >
			<object name="e_glass_3" />
			<object name="c_box_03"  collision_type="box" padding="-2.5"/>
		</body>
		
	</bodies>
	<decal_surfaces default_material="metal" static="true">
		<decal_mesh name="g_g" 				enabled="true" material="metal" />
		<decal_mesh name="g_glass_1" 				enabled="true" material="glass_unbreakable" />
		<decal_mesh name="g_glass_2" 				enabled="true" material="glass_unbreakable" />
		<decal_mesh name="g_glass_3" 				enabled="true" material="glass_unbreakable" />
	</decal_surfaces>
	
	<graphics>
        <object enabled="true" name="g_g" />
        <object enabled="true" name="g_glass_1" />
        <object enabled="true" name="g_glass_2" />
        <object enabled="true" name="g_glass_3" />
    </graphics>
</dynamic_object>