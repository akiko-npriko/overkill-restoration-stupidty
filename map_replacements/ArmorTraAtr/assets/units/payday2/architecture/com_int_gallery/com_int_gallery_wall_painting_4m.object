<?xml version="1.0" ?>
<dynamic_object>
	<diesel materials="units/payday2/architecture/com_int_gallery/com_int_gallery" orientation_object="rp_com_int_gallery_wall_painting_4m" />
  
	<bodies>
<!--	STATIC BODIES    -->
		
		<body name="static_bodies" template="static" enabled="true" >
            <object name="rp_com_int_gallery_wall_painting_4m"/>
            <object collision_type="box" enabled="true" name="c_box_000" padding="-2.5"/>
            <object collision_type="box" enabled="true" name="c_box_001" padding="-2.5"/>
            <object collision_type="box" enabled="true" name="c_box_002" padding="-2.5"/>
            <object collision_type="box" enabled="true" name="c_box_003" padding="-2.5"/>
            <object collision_type="box" enabled="true" name="c_box_004" padding="-2.5"/>
        </body>
        <body name="body_blocker_mover" enabled="true" template="mover_blocker">
        	<object name="rp_com_int_gallery_wall_painting_4m" />
        	<object name="c_box_blocker_mover" collision_type="box" padding="-2.5" />
        </body>
    </bodies>
	
	<decal_surfaces default_material="plaster" static="true">
		<decal_mesh name="dm_plaster" material="plaster" enabled="true"/>
	</decal_surfaces> 
	
    <graphics>
       
		<object enabled="true" name="g_g" shadow_caster="false" />
        <object enabled="true" name="s_s" shadow_caster="true" />
    </graphics>
</dynamic_object> 