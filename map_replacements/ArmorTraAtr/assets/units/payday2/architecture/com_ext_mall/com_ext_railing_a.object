<?xml version="1.0" ?>
<dynamic_object>
	<diesel materials="units/payday2/architecture/com_ext_mall/com_ext_mall" orientation_object="rp_com_ext_railing_a" />
	<sequence_manager file="units/payday2/architecture/com_ext_mall/com_ext_mall" />
 <bodies>
        <body name="static_body" template="static" enabled="true" >
            <object name="rp_com_ext_railing_a"/>
			<object name="c_box_01" collision_type="box" padding="-2.5"/>
			<object name="c_box_02" collision_type="box" padding="-2.5"/>
			<object name="c_box_03" collision_type="box" padding="-2.5"/>
			<object name="c_box_04" collision_type="box" padding="-2.5"/>
        </body>
		
		<body name="glass_body" template="static" enabled="true" >
			<object name="c_box_glass" collision_type="box" padding="-2.5"/>
	
        </body>
    </bodies>
	
	<decal_surfaces default_material="metal" static="true">
		<decal_mesh name="dm_wood" material="wood" enabled="true"/>
		<decal_mesh name="dm_marble" material="marble" enabled="true"/>
		<decal_mesh name="dm_glass_breakable" material="glass_breakable" enabled="true"/>
	</decal_surfaces> 
	
    <graphics>
        <object enabled="true" name="g_glass" />
        <object enabled="false" name="g_glass_dmg" />
        <object enabled="true" name="g_com_ext_railing_a" />
		<object enabled="true" name="s_s" shadow_caster="true"/>


    </graphics>
</dynamic_object> 