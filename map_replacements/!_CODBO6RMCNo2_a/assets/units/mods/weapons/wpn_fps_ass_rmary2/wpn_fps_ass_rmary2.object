<dynamic_object>
	<diesel orientation_object="rp_wpn_fps_ass_fal" />
	<animations>
		<animation_group name="reload">
			<object name="anim_reload" 			enabled="true" />
			<object name="anim_reload_dh" 		enabled="true" />
			<object name="anim_empty_mag_reload" 		enabled="true" />
			<object name="anim_reload_mag_release" 		enabled="true" />
			<object name="anim_mag_reload" 		enabled="true" />
			<object name="anim_mag_reload_drum" 		enabled="true" />
			<object name="anim_mag_reload_jungle" 		enabled="true" />
			<object name="anim_empty_mag_reload" 		enabled="true" />
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_recoil" 			enabled="true" />
		</animation_group>
		<animation_group name="last_recoil">
			<object name="anim_recoil_last" enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty">
			<object name="anim_empty_mag_reload_not_empty" 	enabled="true" />
			<object name="anim_reload_not_empty_mag_release" 	enabled="true" />
			<object name="anim_mag_reload_not_empty" 	enabled="true" />
			<object name="anim_mag_reload_not_empty_drum" 	enabled="true" />
			<object name="anim_mag_reload_not_empty_jungle" 	enabled="true" />
			<object name="anim_empty_mag_reload_not_empty" 	enabled="true" />
		</animation_group>
	</animations>
</dynamic_object>
