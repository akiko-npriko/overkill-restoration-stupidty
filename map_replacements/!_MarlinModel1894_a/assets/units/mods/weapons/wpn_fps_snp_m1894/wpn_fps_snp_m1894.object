<dynamic_object>
	<diesel orientation_object="rp_wpn_fps_snp_m1894"/>
	<animations>
		<animation_group name="reload_enter">
			<object name="anim_bullet_reload_loop" enabled="true"/>
			<object name="anim_loading_spring_reload_loop" enabled="true"/>
		</animation_group>
		<animation_group name="reload_exit">
			<object name="anim_bolt_reload_exit" enabled="true"/>
			<object name="anim_lever_reload_exit" enabled="true"/>
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_bolt_recoil" enabled="true"/>
			<object name="anim_hammer_recoil" enabled="true"/>
			<object name="anim_lever_recoil" enabled="true"/>
		</animation_group>
	</animations>
</dynamic_object>