<?xml version="1.0" ?>
<dynamic_object>
	<diesel materials="units/payday2/architecture/ind/ind_instanced" orientation_object="rp_ind_ext_pipe_1_variation" />
	<bodies>
        <body name="static_body" template="static" enabled="true" >
            <object name="rp_ind_ext_pipe_1_variation"/>
			<object name="c_capsule_01" collision_type="capsule" padding="-2.5"/>
        </body>
    </bodies>
	
	<decal_surfaces default_material="metal">
        <decal_mesh enabled="true" name="dm_metal_hollow" material="sheet_metal" />
    </decal_surfaces>

    <graphics>
		<lod_object name="pipe">
			<object name="g_pipe_1_var_lod_0" instance_struct="world_tm" enabled="true" lod="0" max_distance="800"/>
			<object name="g_pipe_1_var_lod_1" instance_struct="world_tm" enabled="true" lod="1"/>
		</lod_object>
		<object name="s_pipe_1_var" instance_struct="world_tm" enabled="true" shadow_caster="true"/>
    </graphics>
</dynamic_object> 