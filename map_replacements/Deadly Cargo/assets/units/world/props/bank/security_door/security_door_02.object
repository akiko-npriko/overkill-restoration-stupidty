<?xml version="1.0"?>
<dynamic_object>
  <diesel materials="units/world/props/bank/security_door/security_door_01" orientation_object="rp_security_door_02" />
  <sequence_manager file="units/world/props/bank/security_door/security_door_02" />
  <animations>
    <animation_group name="open_door">
      <object name="a_security_door" enabled="true" />
      <object name="g_security_door" enabled="true" />
      <object name="c_security_door" enabled="true" />
    </animation_group>
  </animations>
  <bodies>
    <body remove_ray_type="vis_graph" add_ray_type="ai_vision" name="static_body" enabled="true" template="static">
      <object name="rp_security_door_02" />
      <object name="c_security_door_frame" collision_type="mesh_mopp" />
    </body>
    <body remove_ray_type="vis_graph walk" add_ray_type="ai_vision" name="static_body1" enabled="true" template="animated">
      <object name="c_security_door" collision_type="box" />
    </body>
  </bodies>
  <decal_surfaces default_material="metal" static="true">
    <decal_mesh name="dm_metal_2" enabled="true" material="sheet_metal" />
    <decal_mesh name="dm_metal" enabled="true" material="steel" />
  </decal_surfaces>
  <graphics>
    <object name="g_security_door" enabled="true"  />
    <object name="g_security_door_frame" enabled="true"  />
  </graphics>
</dynamic_object>