<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/pd2_dlc_cro/dead_meth_cook/dead_meth_cook" orientation_object="rp_dead_meth_cook" />
	<bodies>
		<body name="static_body" collides_with_mover="false" enabled="true" template="static">
			<object name="rp_dead_meth_cook" />
			<object name="c_meshmopp" collision_type="mesh_mopp" />
		</body>
	</bodies>
	<decal_surfaces default_material="flesh">
		<decal_mesh name="c_meshmopp" enabled="true" material="flesh" />
	</decal_surfaces>
	<graphics>
		<object name="g_body" enabled="true"  />
		<object name="s_body" shadow_caster="true" enabled="true" />
	</graphics>
</dynamic_object>