<?xml version="1.0"?>
<tweaks>
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		
		<target mode="append">
			<state name="fps/reload/terminator" type="once" segment="base" speed="1.0">
				<anim name="terminator_reload"/>
				<keys>
					<key at="trigger" trigger="wp_foley_generic_lever_pull" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
					<key at="trigger" trigger="wp_foley_generic_clip_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_grab"/>
					<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
					<key at="trigger" trigger="wp_foley_generic_clip_in_connect" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_in_connect"/>
					<key at="trigger" trigger="wp_clip_generic_smg_center" callback="play_sound" class_name="base" param1="wp_clip_generic_smg_center"/>
					<key at="trigger" trigger="wp_scorpion_lever_pull" callback="play_sound" class_name="base" param1="wp_scorpion_lever_pull"/>
					<key at="trigger" trigger="wp_scorpion_lever_release" callback="play_sound" class_name="base" param1="wp_scorpion_lever_release"/>
					<key at="trigger" trigger="wp_scorpion_clip_slide_out" callback="play_sound" class_name="base" param1="wp_scorpion_clip_slide_out"/>
					<key at="trigger" trigger="wp_scorpion_clip_slide_in" callback="play_sound" class_name="base" param1="wp_scorpion_clip_slide_in"/>
					<key at="trigger" trigger="wp_scorpion_clip_in_contact" callback="play_sound" class_name="base" param1="wp_scorpion_clip_in_contact"/>
					<key at="trigger" trigger="wp_foley_generic_back_in_hand" callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle"/>
			</state>

			<state name="fps/reload_not_empty/terminator" type="once" segment="base" speed="1.0">
				<anim name="terminator_reload_not_empty"/>
				<keys>
					<key at="trigger" trigger="wp_foley_generic_lever_pull" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
					<key at="trigger" trigger="wp_foley_generic_clip_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_grab"/>
					<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
					<key at="trigger" trigger="wp_foley_generic_clip_in_connect" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_in_connect"/>
					<key at="trigger" trigger="wp_clip_generic_smg_center" callback="play_sound" class_name="base" param1="wp_clip_generic_smg_center"/>
					<key at="trigger" trigger="wp_scorpion_lever_pull" callback="play_sound" class_name="base" param1="wp_scorpion_lever_pull"/>
					<key at="trigger" trigger="wp_scorpion_lever_release" callback="play_sound" class_name="base" param1="wp_scorpion_lever_release"/>
					<key at="trigger" trigger="wp_scorpion_clip_slide_out" callback="play_sound" class_name="base" param1="wp_scorpion_clip_slide_out"/>
					<key at="trigger" trigger="wp_scorpion_clip_slide_in" callback="play_sound" class_name="base" param1="wp_scorpion_clip_slide_in"/>
					<key at="trigger" trigger="wp_scorpion_clip_in_contact" callback="play_sound" class_name="base" param1="wp_scorpion_clip_in_contact"/>
					<key at="trigger" trigger="wp_foley_generic_back_in_hand" callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
		
	</tweak>
	
	<!--Single fire recoil animation-->
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/recoil"/>
			<anim name="m4_recoil" weight="m4"/>
		</search>
		<target mode="append">
			<anim name="terminator_recoil" weight="terminator"/>
		</target>
	</tweak>
	
	<!-- ADS/Steelsight single fire recoil animation -->
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/recoil_steelsight"/>
			<anim name="m4_recoil" weight="m4"/>
		</search>
		<target mode="append">
			<anim name="terminator_recoil_steelsight" weight="terminator"/>
		</target>
	</tweak>
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps"/>
		</search>
		<target mode="attach">
			<to name="reload_terminator" 					redirect="fps/reload/terminator"/>
			<to name="reload_not_empty_terminator" 			redirect="fps/reload_not_empty/terminator"/>
		</target>
	</tweak>
	
