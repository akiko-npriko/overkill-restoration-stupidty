<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/nypd/armor_skins/nypd_gensec_heavy_shotgun/nypd_gensec_heavy_shotgun" orientation_object="root_point" />

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="bounding_box_char">
			<object name="g_body_heavy" enabled="true"/>
			<object name="g_swat_heavy_sg" enabled="true"/>
			<object name="g_helmet_lod1" enabled="true"/>
			<object name="g_helmet_lod13" enabled="true"/>
			<object name="g_glass_l" enabled="true"/>
			<object name="g_glass_r" enabled="true"/>

		<!--Balaclavas; Only one should be used at a time-->
			<object name="g_balaclava_a" enabled="false"/> <!--Covered nose-->
			<object name="g_balaclava_b" enabled="true"/> <!--Exposed nose-->

		<!--Heads; Only one should be used at a time and they should not be used alongside a balaclava-->
			<object name="g_head_black_c_var1" enabled="false"/>
			<object name="g_head_black_c_var2" enabled="false"/>
			<object name="g_head_black_c_var3" enabled="false"/>
			<object name="g_head_black_c_var4" enabled="false"/>
			<object name="g_head_black_c_var5" enabled="false"/>
			<object name="g_head_black_c_var6" enabled="false"/>
			<object name="g_head_black_c_var7" enabled="false"/>
			<object name="g_head_white_c_var1" enabled="false"/>
			<object name="g_head_white_c_var2" enabled="false"/>
			<object name="g_head_white_c_var3" enabled="false"/>
			<object name="g_head_white_c_var4" enabled="false"/>
			<object name="g_head_white_c_var5" enabled="false"/>
			<object name="g_head_white_c_var6" enabled="false"/>
			<object name="g_head_white_c_var7" enabled="false"/>

		<!--Faces; Only one should be used at a time and they should only be used alongside a balaclava-->
			<object name="g_face_a" enabled="false"/>
			<object name="g_face_b" enabled="false"/>
			<object name="g_face_c" enabled="false"/>
			<object name="g_face_d" enabled="false"/>
			<object name="g_face_e" enabled="true"/>

		<!--Night-Vision Goggles; Only one should be used at a time-->
			<object name="g_helmet_lod5" enabled="false"/> <!--NVG lifted up-->
			<object name="g_helmet_lod17" enabled="true"/> <!--NVG put down-->

		<!--Gun Holsters-->
			<object name="g_holster_l" enabled="false"/> <!--Left thigh-->
			<object name="g_holster_r" enabled="true"/> <!--Right thigh-->
		</graphic_group>
	</graphics>
</dynamic_object>