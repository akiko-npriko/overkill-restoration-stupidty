<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/nypd/armor_skins/nypd_grenadier/nypd_grenadier" orientation_object="root_point" />

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="bounding_box_char">
			<object name="g_body_grenadier" enabled="true"/>
			<object name="g_helmet_grenadier_lod1" enabled="true"/>
			<object name="g_glass_l" enabled="true"/>
			<object name="g_glass_r" enabled="true"/>

		<!--Faces; Only one should be used at a time-->
			<object name="g_face_a" enabled="true"/>
			<object name="g_face_b" enabled="false"/>
			<object name="g_face_c" enabled="false"/>
			<object name="g_face_d" enabled="false"/>
			<object name="g_face_e" enabled="false"/>

		<!--Explosive Bag-->
			<object name="g_explosivebag" enabled="true"/>

		<!--Gun Holster-->
			<object name="g_holster_l" enabled="true"/>
		</graphic_group>
	</graphics>
</dynamic_object>