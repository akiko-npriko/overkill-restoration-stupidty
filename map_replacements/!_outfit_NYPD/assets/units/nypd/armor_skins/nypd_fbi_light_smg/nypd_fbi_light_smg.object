<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/nypd/armor_skins/nypd_fbi_light_smg/nypd_fbi_light_smg" orientation_object="root_point" />

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="co_culling">
			<object name="g_body" enabled="true"/>
			<object name="g_swat_smg" enabled="true"/>

		<!--Balaclavas; Only one should be used at a time-->
			<object name="g_balaclava_a" enabled="false"/> <!--Covered nose-->
			<object name="g_balaclava_b" enabled="false"/> <!--Exposed nose-->

		<!--Heads; Only one should be used at a time and they should not be used alongside a balaclava-->
			<object name="g_head_black_a_var1" enabled="false"/>
			<object name="g_head_black_a_var2" enabled="false"/>
			<object name="g_head_black_a_var3" enabled="true"/>
			<object name="g_head_black_a_var4" enabled="false"/>
			<object name="g_head_black_a_var5" enabled="false"/>
			<object name="g_head_black_a_var6" enabled="false"/>
			<object name="g_head_black_a_var7" enabled="false"/>
			<object name="g_head_white_b_var1" enabled="false"/>
			<object name="g_head_white_b_var2" enabled="false"/>
			<object name="g_head_white_b_var3" enabled="false"/>
			<object name="g_head_white_b_var4" enabled="false"/>
			<object name="g_head_white_b_var5" enabled="false"/>
			<object name="g_head_white_b_var6" enabled="false"/>
			<object name="g_head_white_b_var7" enabled="false"/>

		<!--Faces; Only one should be used at a time and they should only be used alongside a balaclava-->
			<object name="g_face_a" enabled="false"/>
			<object name="g_face_b" enabled="false"/>
			<object name="g_face_c" enabled="false"/>
			<object name="g_face_d" enabled="false"/>
			<object name="g_face_e" enabled="false"/>

		<!--Goggles; Only one should be used at a time and they should each be used with their corresponding glass-->
			<object name="g_goggles_a" enabled="false"/> <!--Put-down goggles; Use alongside g_glass-->
			<object name="g_glass" enabled="false"/>

			<object name="g_goggles_c" enabled="true"/> <!--Lifted-up goggles; Use alongside g_glass_c-->
			<object name="g_glass_c" enabled="true"/>

		<!--Headset-->
			<object name="g_headset" enabled="false"/>

		<!--Gun Holsters-->
			<object name="g_holster_l" enabled="false"/> <!--Left thigh-->
			<object name="g_holster_r" enabled="true"/> <!--Right thigh-->
		</graphic_group>
	</graphics>
</dynamic_object>