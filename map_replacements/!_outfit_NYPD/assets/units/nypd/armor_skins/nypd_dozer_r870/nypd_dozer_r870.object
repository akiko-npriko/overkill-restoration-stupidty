<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/nypd/armor_skins/nypd_dozer_r870/nypd_dozer_r870" orientation_object="root_point" />

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="bounding_box_char">
			<object name="g_body" enabled="true"/>
			<object name="g_balaclava_a" enabled="true"/>
			<object name="g_helmet" enabled="true"/>
			<object name="g_helmet_glass" enabled="true"/>
			<object name="g_armor_back" enabled="true"/>
			<object name="g_armor_chest" enabled="true"/>
			<object name="g_armor_stomache" enabled="true"/>
			<object name="g_neck" enabled="true"/>
			<object name="g_throat" enabled="true"/>
			<object name="g_shoulderpad_l" enabled="true"/>
			<object name="g_shoulderpad_r" enabled="true"/>
			<object name="g_thigh_l" enabled="true"/>
			<object name="g_thigh_r" enabled="true"/>

		<!--Faces; Only one should be used at a time-->
			<object name="g_face_a" enabled="true"/>
			<object name="g_face_b" enabled="false"/>
			<object name="g_face_c" enabled="false"/>
			<object name="g_face_d" enabled="false"/>
			<object name="g_face_e" enabled="false"/>
			<object name="g_face_f" enabled="false"/>
			<object name="g_face_g" enabled="false"/>
			<object name="g_face_h" enabled="false"/>

		<!--Faceplate-->
			<object name="g_helmet_plate" enabled="true"/>
		</graphic_group>
	</graphics>
</dynamic_object>