<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_ass_74_gl_gp25/wpn_fps_ass_74_gl_gp25" orientation_object="rp_wpn_fps_ass_74_gl_gp25" />
	
	<animations>
		<animation_group name="reload_ul">
			<object name="anim_reload_grenade" enabled="true" />
		</animation_group>
		<animation_group name="enter_switch" >
			<object name="anim_enter_switch" enabled="true" />
		</animation_group>
		<animation_group name="exit_switch" >
			<object name="anim_exit_switch" enabled="true" />
		</animation_group>
	</animations>

	<graphics>
		<object name="g_gp25" enabled="true" />
		<object name="g_grenade" enabled="true" />
		<object name="g_switch" enabled="true" />
	</graphics>
</dynamic_object>
