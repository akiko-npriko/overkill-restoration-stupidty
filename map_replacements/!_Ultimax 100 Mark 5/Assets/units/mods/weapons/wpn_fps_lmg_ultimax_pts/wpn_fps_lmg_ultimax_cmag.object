<dynamic_object>
    <diesel orientation_object="rp_wpn_fps_ass_scar_m_standard" materials="units/mods/weapons/wpn_fps_lmg_ultimax_pts/wpn_fps_lmg_ultimax_cmag" />
    <animations>
		<animation_group name="reload">
			<object name="a_reload" enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty">
			<object name="a_reload_not_empty" enabled="true" />
		</animation_group>
	</animations>
	<graphics>
		<graphic_group name="character" enabled="true" culling_object="g_mag">
			<object enabled="true" inherit_bounding_volume="co_culling" name="g_mag" />
		</graphic_group>
        <object enabled="true" name="g_bullet_1" />
	</graphics>
</dynamic_object>
