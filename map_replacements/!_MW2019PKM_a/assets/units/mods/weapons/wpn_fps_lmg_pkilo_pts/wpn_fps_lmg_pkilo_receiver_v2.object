<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_lmg_pkilo_pts/wpn_fps_lmg_pkilo_receiver_v2" orientation_object="rp_receiver" />
	<animations>
		<animation_group name="reload">
			<object name="anim_ejection_port_reload" 			enabled="true" />
			<object name="anim_left_port_cover_reload" 		enabled="true" />
			<object name="anim_right_port_cover_reload" 		enabled="true" />
		</animation_group>
		<animation_group name="recoil">
			<object name="align_ejection_port_recoil" 			enabled="true" />
			<object name="anim_left_port_cover_recoil" 		enabled="true" />
			<object name="anim_right_port_cover_recoil" 		enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty">
			<object name="anim_ejection_port_reload_not_empty" 			enabled="true" />
			<object name="anim_left_port_cover_reload_not_empty" 		enabled="true" />
			<object name="anim_right_port_cover_reload_not_empty" 		enabled="true" />
		</animation_group>
	</animations>
	<graphics>
		<object name="g_ejection_port_v2" enabled="true" />
		<object name="g_left_port_cover_v2" enabled="true" />
		<object name="g_right_port_cover_v2" enabled="true" />
		<object name="g_receiver_v2" enabled="true" />
		
		<object name="g_carry_handle_v2" enabled="true" />
		<object name="g_feed_lock_v2" enabled="true" />
		<object name="g_gas_tube_v2" enabled="true" />
		<object name="g_tray_v2" enabled="true" />
		<object name="g_trigger_v2" enabled="true" />
				
	</graphics>
	
</dynamic_object>
