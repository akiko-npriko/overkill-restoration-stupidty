<dynamic_object>
	<diesel orientation_object="rp_wpn_fps_lmg_svinet" />
	<animations>
		<animation_group name="reload">
			<object name="anim_bolt_reload" 			enabled="true" />
			<object name="anim_cover_reload" 		enabled="true" />
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_bolt_recoil" 			enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty">
			<object name="anim_bolt_reload_not_empty" 	enabled="true" />
			<object name="anim_cover_reload_not_empty" 	enabled="true" />
		</animation_group>
	</animations>
</dynamic_object>
