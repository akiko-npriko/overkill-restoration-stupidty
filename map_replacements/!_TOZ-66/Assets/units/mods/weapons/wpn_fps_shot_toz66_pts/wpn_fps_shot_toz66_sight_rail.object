<dynamic_object>
    <diesel materials="units/mods/weapons/wpn_fps_shot_toz66_pts/wpn_fps_shot_toz66_sight_rail" orientation_object="rp_wpn_fps_shot_huntsman_b_short"/>
  	<animations>
	    <animation_group name="reload">
		    <object name="anim_barrel" enabled="true" />
		    <object name="anim_slug_right" enabled="true" />
		    <object name="anim_slug_left" enabled="true" />
	    </animation_group>
	</animations>
    <graphics>
		<graphic_group name="character" enabled="true" culling_object="g_short_barrel">
			<object enabled="true" inherit_bounding_volume="co_culling" name="g_short_barrel" />
		</graphic_group>
		<object enabled="false" name="g_slug_left" />
		<object enabled="false" name="g_slug_right" />
    </graphics>
</dynamic_object>
