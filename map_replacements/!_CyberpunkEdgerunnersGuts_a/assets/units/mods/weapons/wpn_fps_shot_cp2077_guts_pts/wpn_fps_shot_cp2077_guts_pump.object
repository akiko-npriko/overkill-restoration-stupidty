<dynamic_object>
    <diesel materials="units/mods/weapons/wpn_fps_shot_cp2077_guts_pts/wpn_fps_shot_cp2077_guts_pump" orientation_object="rp_pump"/>
	  <animations>	
	<animation_group name="recoil">
		<object name="anim_bolt_recoil" enabled="true" />
    </animation_group>
    <animation_group name="recoil_zoom">
		<object name="anim_bolt_recoil_zoom" enabled="true" />
    </animation_group>
    <animation_group name="reload_exit">
    <object name="anim_bolt_reload_exit" enabled="true" />
    </animation_group>
</animations>
    <graphics>
        <object enabled="true" name="g_bolt_carrier" />
		<object enabled="true" name="g_guts_pump" />
		<object enabled="true" name="g_screws_pump" />

    </graphics>
</dynamic_object>
