<?xml version="1.0"?>



<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps"/>
		</search>
		<target mode="attach">
			<to name="reload_br14" 						redirect="fps/reload/br14"/>
			<to name="reload_not_empty_br14" 			redirect="fps/reload_not_empty/br14"/>
		</target>
	</tweak>
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">
			<state name="fps/reload/br14" type="once" segment="base" speed="1.0">
				<anim name="br14_reload"/>
					<keys>					
						<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
						
						<key at="trigger" trigger="wp_foley_generic_tilt" callback="play_sound" class_name="base" param1="br14_tilt"/>
						<key at="trigger" trigger="wp_m4_clip_grab" callback="play_sound" class_name="base" param1="br14_mag_grab"/>
						<key at="trigger" trigger="wp_m4_clip_grab_out" callback="play_sound" class_name="base" param1="br14_mag_out"/>
						<key at="trigger" trigger="wp_m4_clip_take_new" callback="play_sound" class_name="base" param1="br14_mag_take_new"/>
						<key at="trigger" trigger="wp_clip_generic_ass_left" callback="play_sound" class_name="base" param1="wp_clip_generic_ass_left"/>
						<key at="trigger" trigger="wp_m4_clip_in_contact" callback="play_sound" class_name="base" param1="br14_mag_contact"/>
						<key at="trigger" trigger="wp_m4_clip_slide_in" callback="play_sound" class_name="base" param1="br14_mag_in"/>
						<key at="trigger" trigger="wp_foley_generic_back_in_hand" callback="play_sound" class_name="base" param1="br14_back_in_hand"/>
						<key at="trigger" trigger="wp_foley_generic_tilt_back" callback="play_sound" class_name="base" param1="br14_tilt_back"/>
						<key at="trigger" trigger="wp_foley_generic_lever_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_grab"/>
						<key at="trigger" trigger="wp_foley_generic_lever_pull" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
						<key at="trigger" trigger="wp_m4_lever_pull_in" callback="play_sound" class_name="base" param1="br14_charging_handle_pull"/>
						<key at="trigger" trigger="wp_m4_lever_release" callback="play_sound" class_name="base" param1="br14_charging_handle_release"/>
					</keys>
				<exit name="fps/idle"/>
			</state>
			
			
			<state name="fps/reload_not_empty/br14" type="once" segment="base" speed="1.0">
				<anim name="br14_reload_not_empty"/>
					<keys>		
						<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
						
						<key at="trigger" trigger="wp_foley_generic_tilt" callback="play_sound" class_name="base" param1="br14_tilt"/>
						<key at="trigger" trigger="wp_m4_clip_grab" callback="play_sound" class_name="base" param1="br14_mag_grab"/>
						<key at="trigger" trigger="wp_m4_clip_grab_out" callback="play_sound" class_name="base" param1="br14_mag_out"/>
						<key at="trigger" trigger="wp_m4_clip_take_new" callback="play_sound" class_name="base" param1="br14_mag_take_new"/>
						<key at="trigger" trigger="wp_clip_generic_ass_left" callback="play_sound" class_name="base" param1="wp_clip_generic_ass_left"/>
						<key at="trigger" trigger="wp_m4_clip_in_contact" callback="play_sound" class_name="base" param1="br14_mag_contact"/>
						<key at="trigger" trigger="wp_m4_clip_slide_in" callback="play_sound" class_name="base" param1="br14_mag_in"/>
						<key at="trigger" trigger="wp_foley_generic_back_in_hand" callback="play_sound" class_name="base" param1="br14_back_in_hand"/>
						<key at="trigger" trigger="wp_foley_generic_tilt_back" callback="play_sound" class_name="base" param1="br14_tilt_back"/>
						<key at="trigger" trigger="wp_foley_generic_lever_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_grab"/>
						<key at="trigger" trigger="wp_foley_generic_lever_pull" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
						<key at="trigger" trigger="wp_m4_lever_pull_in" callback="play_sound" class_name="base" param1="br14_charging_handle_pull"/>
						<key at="trigger" trigger="wp_m4_lever_release" callback="play_sound" class_name="base" param1="br14_charging_handle_release"/>
					</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>
	
