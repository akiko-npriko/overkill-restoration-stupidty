<unit type="hsp" slot="1" >
    <object file="units/custom/pd2_mod_underground_bargains/chl_hospital_saw_teddy/chl_hospital_saw_teddy" />
    <extensions>
        <extension name="unit_data" class="ScriptUnitData" />
		<extension name="damage" class="UnitDamage" />
		<extension name="interaction" class="CarryInteractionExt">
			<var name="tweak_data" value="gen_pku_teddy" />
