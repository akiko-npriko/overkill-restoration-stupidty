		<animation_group name="reload" enabled="false" >
			<object name="a_reload_bullets_bundle" enabled="true" />
			<object name="a_reload_bullet_01" enabled="true" />
			<object name="a_reload_bullet_02" enabled="true" />
			<object name="a_reload_bullet_03" enabled="true" />
			<object name="a_reload_bullet_04" enabled="true" />
			<object name="a_reload_bullet_05" enabled="true" />
		</animation_group>  
		<animation_group name="reload_not_empty" enabled="false" >
			<object name="a_reload_bullets_bundle" enabled="true" />
			<object name="a_reload_bullet_01" enabled="true" />
			<object name="a_reload_bullet_02" enabled="true" />
			<object name="a_reload_bullet_03" enabled="true" />
			<object name="a_reload_bullet_04" enabled="true" />
			<object name="a_reload_bullet_05" enabled="true" />
		</animation_group>
    </animations>
	<graphics>
		<object name="g_slug_1" enabled="true"/>
		<object name="g_slug_2" enabled="true"/>
		<object name="g_slug_3" enabled="true"/>
		<object name="g_slug_4" enabled="true"/>
		<object name="g_slug_5" enabled="true"/>

		<object name="g_cartridge_1" enabled="true"/>
		<object name="g_cartridge_2" enabled="true"/>
		<object name="g_cartridge_3" enabled="true"/>
		<object name="g_cartridge_4" enabled="true"/>
		<object name="g_cartridge_5" enabled="true"/>
	</graphics>
</dynamic_object>