<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_pis_toz81_pts/wpn_fps_pis_toz81_m_bullets" orientation_object="rp_bullets" />	
	<animations>  
		<animation_group name="reload" enabled="false" >
			<object name="a_reload_bullets_bundle" enabled="true" />
			<object name="a_reload_bullet_01" enabled="true" />
			<object name="a_reload_bullet_02" enabled="true" />
			<object name="a_reload_bullet_03" enabled="true" />
			<object name="a_reload_bullet_04" enabled="true" />
			<object name="a_reload_bullet_05" enabled="true" />
		</animation_group>  
		<animation_group name="reload_not_empty" enabled="false" >
			<object name="a_reload_bullets_bundle" enabled="true" />
			<object name="a_reload_bullet_01" enabled="true" />
			<object name="a_reload_bullet_02" enabled="true" />
			<object name="a_reload_bullet_03" enabled="true" />
			<object name="a_reload_bullet_04" enabled="true" />
			<object name="a_reload_bullet_05" enabled="true" />
		</animation_group>
    </animations>
	<graphics>
		<object name="g_bullet_1" enabled="true"/>
		<object name="g_bullet_2" enabled="true"/>
		<object name="g_bullet_3" enabled="true"/>
		<object name="g_bullet_4" enabled="true"/>
		<object name="g_bullet_5" enabled="true"/>

		<object name="g_casing_1" enabled="true"/>
		<object name="g_casing_2" enabled="true"/>
		<object name="g_casing_3" enabled="true"/>
		<object name="g_casing_4" enabled="true"/>
		<object name="g_casing_5" enabled="true"/>
	</graphics>
</dynamic_object>