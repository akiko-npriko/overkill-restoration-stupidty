<?xml version="1.0"?>

<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps"/>
		</search>
		<target mode="attach">
			<to name="reload_toz81" 						redirect="fps/reload/toz81"/>
			<to name="reload_not_empty_toz81" 			redirect="fps/reload_not_empty/toz81"/>
		</target>
	</tweak>
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">
			<state name="fps/reload/toz81" type="once" segment="base" speed="1.0">
				<anim name="toz81_reload"/>
					<keys>
						
						<key at="enter" callback="anim_clbk_stop_weapon_magazine_empty" class_name="base" param1="reload"/>	
							
						<key at="trigger" trigger="wp_foley_generic_clip_take_new" 				callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
						<key at="trigger" trigger="wp_gl40_lock_open" 				            callback="play_sound" class_name="base" param1="wp_gl40_lock_open"/>
						<key at="trigger" trigger="wp_gl40_barrel_open" 				        callback="play_sound" class_name="base" param1="wp_gl40_barrel_open"/>	
						<key at="trigger" trigger="wp_ak47_tilt_back" 				            callback="play_sound" class_name="base" param1="wp_ak47_tilt_back"/>
						<key at="trigger" trigger="wp_gl40_shell_out" 				            callback="play_sound" class_name="base" param1="wp_rbull_shells_out"/>
						<key at="trigger" trigger="wp_ak47_tilt" 				                callback="play_sound" class_name="base" param1="wp_ak47_tilt"/>
						<key at="trigger" trigger="gl_casing_land_hard" 				        callback="play_sound" class_name="base" param1="wp_rbull_shell_hit_ground"/>
						<key at="trigger" trigger="wp_foley_generic_clip_in_connect" 			callback="play_sound" class_name="base" param1="wp_foley_generic_clip_in_connect"/>
						<key at="trigger" trigger="wp_gl40_shell_contact" 			            callback="play_sound" class_name="base" param1="wp_gl40_shell_contact"/>
						<key at="trigger" trigger="wp_gl40_shell_in" 			                callback="play_sound" class_name="base" param1="wp_rbull_shells_in"/>
						<key at="trigger" trigger="wp_gl40_barrel_close" 			            callback="play_sound" class_name="base" param1="wp_gl40_barrel_close"/>
						<key at="trigger" trigger="wp_foley_generic_back_in_hand" 			    callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>

						<key at="trigger" trigger="bullet_show" 								callback="anim_clbk_check_bullet_object" class_name="base" />
					</keys>
					<exit name="fps/idle"/>
				</state>
			
			
			<state name="fps/reload_not_empty/toz81" type="once" segment="base" speed="1.0">
				<anim name="toz81_reload_not_empty"/>
				<keys>		
						<key at="trigger" trigger="wp_foley_generic_clip_take_new" 				callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
						<key at="trigger" trigger="wp_gl40_lock_open" 				            callback="play_sound" class_name="base" param1="wp_gl40_lock_open"/>
						<key at="trigger" trigger="wp_gl40_barrel_open" 				        callback="play_sound" class_name="base" param1="wp_gl40_barrel_open"/>	
						<key at="trigger" trigger="wp_ak47_tilt_back" 				            callback="play_sound" class_name="base" param1="wp_ak47_tilt_back"/>
						<key at="trigger" trigger="wp_gl40_shell_out" 				            callback="play_sound" class_name="base" param1="wp_rbull_shells_out"/>
						<key at="trigger" trigger="wp_ak47_tilt" 				                callback="play_sound" class_name="base" param1="wp_ak47_tilt"/>
						<key at="trigger" trigger="gl_casing_land_hard" 				        callback="play_sound" class_name="base" param1="wp_rbull_shell_hit_ground"/>
						<key at="trigger" trigger="wp_foley_generic_clip_in_connect" 			callback="play_sound" class_name="base" param1="wp_foley_generic_clip_in_connect"/>
						<key at="trigger" trigger="wp_gl40_shell_contact" 			            callback="play_sound" class_name="base" param1="wp_gl40_shell_contact"/>
						<key at="trigger" trigger="wp_gl40_shell_in" 			                callback="play_sound" class_name="base" param1="wp_rbull_shells_in"/>
						<key at="trigger" trigger="wp_gl40_barrel_close" 			            callback="play_sound" class_name="base" param1="wp_gl40_barrel_close"/>
						<key at="trigger" trigger="wp_foley_generic_back_in_hand" 			    callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>

						<key at="trigger" trigger="bullet_show" 								callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>
</tweaks>