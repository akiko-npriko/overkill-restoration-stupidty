<?xml version="1.0"?>



<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">
			<state name="fps/reload/peppermill" type="once" segment="base" speed="1.0">
				<anim name="peppermill_reload"/>
				<keys>	
					<key at="trigger" trigger="wp_peppermill_start" callback="play_sound" class_name="base" param1="peppermill_reload_start"/>
					<key at="trigger" trigger="wp_peppermill_magout" callback="play_sound" class_name="base" param1="peppermill_magout"/>
					<key at="trigger" trigger="wp_peppermill_magin" callback="play_sound" class_name="base" param1="peppermill_mag_in"/>
					<key at="trigger" trigger="wp_peppermill_lid_close" callback="play_sound" class_name="base" param1="peppermill_lid_close"/>
					<key at="trigger" trigger="wp_peppermill_spin_start" callback="play_sound" class_name="base" param1="peppermill_spin_start_reload"/>
					<key at="trigger" trigger="wp_peppermill_spin_end" callback="play_sound" class_name="base" param1="peppermill_spin_end_reload"/>
				</keys>
				<exit name="fps/idle"/>
			</state>
			
			
			<state name="fps/reload_not_empty/peppermill" type="once" segment="base" speed="1.0">
				<anim name="peppermill_reload_not_empty"/>
				<keys>
					<key at="trigger" trigger="wp_peppermill_start" callback="play_sound" class_name="base" param1="peppermill_reload_start"/>
					<key at="trigger" trigger="wp_peppermill_magout" callback="play_sound" class_name="base" param1="peppermill_magout"/>
					<key at="trigger" trigger="wp_peppermill_magin" callback="play_sound" class_name="base" param1="peppermill_mag_in"/>
					<key at="trigger" trigger="wp_peppermill_lid_close" callback="play_sound" class_name="base" param1="peppermill_lid_close"/>
					<key at="trigger" trigger="wp_peppermill_spin_start" callback="play_sound" class_name="base" param1="peppermill_spin_start_reload"/>
					<key at="trigger" trigger="wp_peppermill_spin_end" callback="play_sound" class_name="base" param1="peppermill_spin_end_reload"/>

				</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>
	

	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps"/>
		</search>
		<target mode="attach">
			<to name="reload_peppermill" 						redirect="fps/reload/peppermill"/>
			<to name="reload_not_empty_peppermill" 			redirect="fps/reload_not_empty/peppermill"/>
		</target>
	</tweak>
	













