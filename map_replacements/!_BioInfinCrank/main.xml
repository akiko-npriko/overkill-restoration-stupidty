	</WeaponMod>
	<WeaponMod id="wpn_fps_lmg_peppermill_belt_lock" based_on="wpn_fps_lmg_shuno_m_standard"  type="belt_lock"   a_obj="a_belt_lock" unit="units/mods/weapons/wpn_fps_lmg_peppermill_pts/wpn_fps_lmg_peppermill_belt_lock"  hidden="true" ver="2">
