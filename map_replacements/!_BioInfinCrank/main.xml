	<WeaponMod id="wpn_fps_lmg_peppermill_magazine" based_on="wpn_fps_lmg_shuno_m_standard"  unit="units/mods/weapons/wpn_fps_lmg_peppermill_pts/wpn_fps_lmg_peppermill_magazine"  hidden="true" ver="2">
