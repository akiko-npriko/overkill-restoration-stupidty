<dynamic_object>
	<diesel orientation_object="rp_wpn_fps_lmg_shuno"/>
	
	
	<animations>
		<animation_group name="recoil_force">
			<object name="anim_crank_recoil" enabled="true"/>
			<object name="anim_b_recoil" enabled="true"/>
			<object name="anim_piston_recoil" enabled="true"/>
		</animation_group>
		<animation_group name="recoil_force_exit">
			<object name="anim_crank_reload_not_empty" enabled="true"/>
			<object name="anim_b_reload_not_empty" enabled="true"/>
			<object name="anim_piston_reload_not_empty" enabled="true"/>
		</animation_group>
		<animation_group name="reload">
			<object name="anim_b_reload" enabled="true"/>
			<object name="anim_belt_lock_reload" enabled="true"/>
			<object name="anim_piston_reload" enabled="true"/>
			<object name="anim_crank_reload" enabled="true"/>
			<object name="anim_m_reload" enabled="true"/>
		</animation_group>
	</animations>
	
	
	
	
	
</dynamic_object>