<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_lmg_peppermill_pts/wpn_fps_lmg_peppermill_magazine" orientation_object="rp_magazine"/>
	
	<animations>
		<animation_group name="recoil">
			<object name="anim_lid_recoil" enabled="true"/>
		</animation_group>
		<animation_group name="reload">
			<object name="anim_lid_reload" enabled="true"/>
		</animation_group>
	</animations>
	
	<graphics>
		<object name="g_ammo_box_lid" enabled="true"/>
		<object name="g_ammo_box" enabled="true"/>
		
	</graphics>
</dynamic_object>