<dynamic_object>
    <diesel orientation_object="rp_wpn_fps_smg_tec9"/>
    <animations>
		<animation_group name="reload">
			<object name="anim_bolt_reload" enabled="true" />	
			<object name="anim_mag_reload" enabled="true" />	
			<object name="anim_charging_handle_reload" enabled="true" />	
		</animation_group>
		<animation_group name="reload_not_empty">
			<object name="anim_mag_reload_not_empty" enabled="true" />	
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_bolt_recoil" enabled="true" />	
		</animation_group>
		<animation_group name="last_recoil">
			<object name="anim_bolt_recoil_last" enabled="true" />	
		</animation_group>
	</animations>
</dynamic_object>
