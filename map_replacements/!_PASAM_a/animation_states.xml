<?xml version="1.0"?>
<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>

		<target mode="append">
			<state name="fps/reload_not_empty/c96carbine" type="once" segment="base" speed="1.0">
				<anim name="c96carbine_reload_not_empty"/>
				<keys>
					<key at="trigger" trigger="wp_foley_generic_lever_pull" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
					<key at="trigger" trigger="wp_foley_generic_clip_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_grab"/>
					<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
					<key at="trigger" trigger="wp_foley_generic_clip_in_connect" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_in_connect"/>
					<key at="trigger" trigger="wp_foley_generic_back_in_hand" callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
					<key at="trigger" trigger="wp_foley_generic_lever_release" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_release"/>
					<key at="trigger" trigger="wp_tec9_clip_take_new" callback="play_sound" class_name="base" param1="wp_tec9_clip_take_new"/>
					<key at="trigger" trigger="wp_tec9_clip_slide_out" callback="play_sound" class_name="base" param1="wp_tec9_clip_slide_out"/>
					<key at="trigger" trigger="wp_tec9_clip_in_contact" callback="play_sound" class_name="base" param1="wp_tec9_clip_in_contact"/>
					<key at="trigger" trigger="wp_tec9_clip_slide_in" callback="play_sound" class_name="base" param1="wp_tec9_clip_slide_in"/>
					<key at="trigger" trigger="wp_tec9_lever_pull" callback="play_sound" class_name="base" param1="wp_tec9_lever_pull"/>
					<key at="trigger" trigger="wp_tec9_clip_grab" callback="play_sound" class_name="base" param1="wp_tec9_clip_grab"/>
					<key at="trigger" trigger="wp_clip_generic_smg_left" callback="play_sound" class_name="base" param1="wp_clip_generic_smg_left"/>
					<key at="trigger" trigger="wp_tec9_lever_release" callback="play_sound" class_name="base" param1="wp_tec9_lever_release"/>
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle"/>
			</state>

			<state name="fps/reload/c96carbine" type="once" segment="base" speed="1.0">
				<anim name="c96carbine_reload"/>
				<keys>
					<key at="trigger" trigger="wp_foley_generic_lever_pull" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_pull"/>
					<key at="trigger" trigger="wp_foley_generic_clip_grab" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_grab"/>
					<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
					<key at="trigger" trigger="wp_foley_generic_clip_in_connect" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_in_connect"/>
					<key at="trigger" trigger="wp_foley_generic_back_in_hand" callback="play_sound" class_name="base" param1="wp_foley_generic_back_in_hand"/>
					<key at="trigger" trigger="wp_foley_generic_lever_release" callback="play_sound" class_name="base" param1="wp_foley_generic_lever_release"/>
					<key at="trigger" trigger="wp_tec9_clip_take_new" callback="play_sound" class_name="base" param1="wp_tec9_clip_take_new"/>
					<key at="trigger" trigger="wp_tec9_clip_slide_out" callback="play_sound" class_name="base" param1="wp_tec9_clip_slide_out"/>
					<key at="trigger" trigger="wp_tec9_clip_in_contact" callback="play_sound" class_name="base" param1="wp_tec9_clip_in_contact"/>
					<key at="trigger" trigger="wp_tec9_clip_slide_in" callback="play_sound" class_name="base" param1="wp_tec9_clip_slide_in"/>
					<key at="trigger" trigger="wp_tec9_lever_pull" callback="play_sound" class_name="base" param1="wp_tec9_lever_pull"/>
					<key at="trigger" trigger="wp_tec9_clip_grab" callback="play_sound" class_name="base" param1="wp_tec9_clip_grab"/>
					<key at="trigger" trigger="wp_clip_generic_smg_left" callback="play_sound" class_name="base" param1="wp_clip_generic_smg_left"/>
					<key at="trigger" trigger="wp_tec9_lever_release" callback="play_sound" class_name="base" param1="wp_tec9_lever_release"/>
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>

	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps"/>
		</search>
		<target mode="attach">
			<to name="reload_c96carbine" 						redirect="fps/reload/c96carbine"/>
			<to name="reload_not_empty_c96carbine" 			redirect="fps/reload_not_empty/c96carbine"/>
		</target>
	</tweak>
</tweaks>