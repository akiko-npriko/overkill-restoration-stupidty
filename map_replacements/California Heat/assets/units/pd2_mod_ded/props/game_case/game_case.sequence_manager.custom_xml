<table>
	<unit>
		<sequence editable_state="true" name="'show'" triggable="true">
			<body enabled="true" name="'body_static'"/>
			<object enabled="true" name="'g_case'"/>
		</sequence>
		<sequence editable_state="true" name="'hide'" triggable="true">
			<body enabled="false" name="'body_static'"/>
			<object enabled="false" name="'g_case'"/>
		</sequence>
		<sequence editable_state="true" name="'set_texture_default'" triggable="true">
			<material_config name="'units/pd2_mod_ded/props/game_case/game_case'"/>
		</sequence>
		<sequence editable_state="true" name="'set_texture_raid_ww2'" triggable="true">
			<material_config name="'units/pd2_mod_ded/props/game_case/game_case_raid'"/>
		</sequence>
		<sequence editable_state="true" name="'set_texture_otwd'" triggable="true">
			<material_config name="'units/pd2_mod_ded/props/game_case/game_case_otwd'"/>
		</sequence>
		<sequence editable_state="true" name="'set_texture_pd2_animated_series'" triggable="true">
			<material_config name="'units/pd2_mod_ded/props/game_case/game_case_pd2as'"/>
		</sequence>
		<sequence editable_state="true" name="'set_texture_pd2'" triggable="true">
			<material_config name="'units/pd2_mod_ded/props/game_case/game_case_pd2'"/>
		</sequence>
		<sequence editable_state="true" name="'set_texture_pdth'" triggable="true">
			<material_config name="'units/pd2_mod_ded/props/game_case/game_case_pdth'"/>
		</sequence>
		<sequence editable_state="true" name="'set_texture_pd2_armored_transport'" triggable="true">
			<material_config name="'units/pd2_mod_ded/props/game_case/game_case_pd2_at'"/>
		</sequence>
		<sequence editable_state="true" name="'set_texture_gtfo'" triggable="true">
			<material_config name="'units/pd2_mod_ded/props/game_case/game_case_gtfo'"/>
		</sequence>
	</unit>
</table>