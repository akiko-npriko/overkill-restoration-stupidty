<?xml version="1.0"?>
<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">
			<state name="fps/reload/martinihenry" type="once" segment="base" speed="1.0">
				<anim name="martinihenry_reload"/>
				<keys>
					<key at="trigger" trigger="wp_m1873_lever_push" callback="play_sound" class_name="base" param1="wp_m1873_lever_push"/>
					<key at="trigger" trigger="wp_m1873_lever_pull" callback="play_sound" class_name="base" param1="wp_m1873_lever_pull"/>
					<key at="trigger" trigger="wp_m1873_bullet_in" callback="play_sound" class_name="base" param1="wp_m1873_bullet_in"/>
					<key at="trigger" trigger="wp_m1873_casing_land" callback="play_sound" class_name="base" param1="wp_m1873_casing_land"/>
					<key at="trigger" trigger="wp_ak47_tilt_back" callback="play_sound" class_name="base" param1="wp_ak47_tilt_back"/>
					<key at="trigger" trigger="wp_ak47_tilt" callback="play_sound" class_name="base" param1="wp_ak47_tilt"/>
					<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="wp_foley_generic_clip_take_new"/>
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>

