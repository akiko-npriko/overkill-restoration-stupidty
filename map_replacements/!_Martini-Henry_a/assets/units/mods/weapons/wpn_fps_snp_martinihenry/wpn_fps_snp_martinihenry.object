<dynamic_object>
	<diesel orientation_object="rp_wpn_fps_snp_martinihenry"/>
	<animations>
		<animation_group name="recoil">
			<object name="anim_sling_recoil" enabled="true"/>
		</animation_group>
		<animation_group name="reload">
			<object name="anim_breech_reload" enabled="true"/>
			<object name="anim_bullet_reload" enabled="true"/>
			<object name="anim_case_reload" enabled="true"/>
			<object name="anim_lever_reload" enabled="true"/>
			<object name="anim_sling_reload" enabled="true"/>
		</animation_group>
	</animations>
</dynamic_object>