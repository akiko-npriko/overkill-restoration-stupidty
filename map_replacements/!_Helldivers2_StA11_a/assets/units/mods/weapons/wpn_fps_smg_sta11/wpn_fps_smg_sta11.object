<dynamic_object>
	<diesel orientation_object="rp_sta11" />
	<animations>
		<animation_group name="reload">
			<object name="anim_m_reload" 			enabled="true" />
			<object name="anim_release_reload" 		enabled="true" />
			<object name="anim_dh_reload_1" 			enabled="true" />
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_dh_recoil_1" 			enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty">
			<object name="anim_m_reload_tactical" 	enabled="true" />
			<object name="anim_release_reload_tactical" 	enabled="true" />
		</animation_group>
	</animations>
</dynamic_object>
