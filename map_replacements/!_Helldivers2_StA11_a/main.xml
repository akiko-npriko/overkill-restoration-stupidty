	<!-- StA-11 Submachine Gun - Default Parts -->

	<WeaponMod id="wpn_fps_smg_sta11_barrel" type="barrel" based_on="wpn_fps_smg_coal_b_standard" unit="units/mods/weapons/wpn_fps_smg_sta11_pts/wpn_fps_smg_sta11_barrel" hidden="true" ver="2"/>

