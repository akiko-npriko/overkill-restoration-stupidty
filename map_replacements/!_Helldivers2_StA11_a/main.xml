	<WeaponMod id="wpn_fps_smg_sta11_magazine" type="magazine" based_on="wpn_fps_smg_coal_m_standard" unit="units/mods/weapons/wpn_fps_smg_sta11_pts/wpn_fps_smg_sta11_magazine" hidden="true" ver="2">
