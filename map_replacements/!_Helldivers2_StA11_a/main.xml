	<WeaponMod id="wpn_fps_smg_sta11_m_release" type="extra" based_on="wpn_fps_smg_coal_mr_standard" unit="units/mods/weapons/wpn_fps_smg_sta11_pts/wpn_fps_smg_sta11_m_release" hidden="true" ver="2"/>

	<WeaponMod id="wpn_fps_smg_sta11_receiver" type="lower_reciever" based_on="wpn_fps_smg_coal_body_standard" unit="units/mods/weapons/wpn_fps_smg_sta11_pts/wpn_fps_smg_sta11_receiver" hidden="true" ver="2">
