<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_sho_bp12_pts/wpn_fps_sho_bp12_body" orientation_object="rp_body" />
	<animations>  
		<animation_group name="recoil" enabled="false" >
			<object name="anim_bolt_recoil" enabled="true" />
		</animation_group>
		<animation_group name="reload" enabled="false" >
			<object name="anim_bolt_reload" enabled="true" />
		</animation_group>
    </animations> 
	<graphics>
		<object name="g_upper" enabled="true" />
		<object name="g_lower" enabled="true" />
		<object name="g_bolt" enabled="true" />
	</graphics>
</dynamic_object>
