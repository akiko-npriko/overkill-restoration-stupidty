<dynamic_object>
	<diesel materials="units/pd2_dlc_fex/props/fex_prop_bookshelf/fex_prop_bookshelf" orientation_object="rp_fex_prop_bookshelf" />
	<sequence_manager file="units/pd2_dlc_fex/props/fex_prop_bookshelf/fex_prop_bookshelf" />
	<animations>
		<animation_group name="anim_book_1" enabled="false">
			<object name="anim_book_1" />
		</animation_group>
		<animation_group name="anim_book_2" enabled="false">
			<object name="anim_book_2" />
		</animation_group>
		<animation_group name="anim_book_3" enabled="false">
			<object name="anim_book_3" />
		</animation_group>
		<animation_group name="anim_bookshelf" enabled="false">
			<object name="anim_shelf" />
		</animation_group>
	</animations>
	<bodies>
		<body name="body_collision_01" enabled="true" template="animated">
			<object name="anim_shelf" />
			<object name="c_box_1" collision_type="box" padding="-2.5" />
			<object name="c_box_2" collision_type="box" padding="-2.5" />
			<object name="c_box_3" collision_type="box" padding="-2.5" />
			<object name="c_box_5" collision_type="box" padding="-2.5" />
			<object name="c_box_6" collision_type="box" padding="-2.5" />
			<object name="c_box_7" collision_type="box" padding="-2.5" />
			<object name="c_box_8" collision_type="box" padding="-2.5" />
			<object name="c_box_9" collision_type="box" padding="-2.5" />
		</body>
	</bodies>
	<graphics>
		<graphic_group name="grp_outline" enabled="false">
			<lod_object name="lod_outline">
				<object name="g_outline" 				enabled="true"  max_distance="300" />
				<object name="g_outline_lod" 			enabled="true" />
			</lod_object>
		</graphic_group>
		<graphic_group name="icons" enabled="false">
			<lod_object name="lod_g_icon">
				<object name="g_icon_lod0" enabled="true" max_distance="500" />
				<object name="g_icon_lod1" enabled="true" />
			</lod_object>
		</graphic_group>
		<object name="g_g" 								enabled="true" instance_struct="world_tm" />
		<object name="g_book_1" 						enabled="true" instance_struct="world_tm" />
		<object name="g_book_2" 						enabled="false" instance_struct="world_tm" />
		<object name="g_book_3" 						enabled="false" instance_struct="world_tm" />
		<object name="g_books_var_1" 					enabled="true" instance_struct="world_tm" />
		<object name="g_books_var_1_searched" 			enabled="false" instance_struct="world_tm" />
		<object name="g_books_var_2" 					enabled="false" instance_struct="world_tm" />
		<object name="g_books_var_2_searched" 			enabled="false" instance_struct="world_tm" />
		<object name="g_books_var_3" 					enabled="false" instance_struct="world_tm" />
		<object name="g_books_var_3_searched" 			enabled="false" instance_struct="world_tm" />


		<object name="g_books_var_1_searched_floor" 	enabled="false" instance_struct="world_tm" />
		<object name="g_books_var_2_searched_floor" 	enabled="false" instance_struct="world_tm" />
		<object name="g_books_var_3_searched_floor" 	enabled="false" instance_struct="world_tm" />
	</graphics>
</dynamic_object>
