<unit type="cft" slot="1" >
	<network sync="spawn"/>
    <object file="units/payday2/props/com_prop_jewelry_bag/jewelry_necklace_box_2" />
	<extensions>
		<extension class="ScriptUnitData" name="unit_data" />
		<extension name="damage" class="UnitDamage" />
		
		<extension name="base" class="SmallLootBase">
			<var name="small_loot" value="diamondheist_vault_diamond" />
			<var name="skip_remove_unit" value="true" />
		</extension>
		
		<extension name="interaction" class="SmallLootInteractionExt">
			<var name="tweak_data" value="diamond_pickup_axis" />
			<var name="_interact_object" value="interact"/>
			<var name="_global_event" value="pku_jewelry_instant" />
		</extension>
	</extensions>
</unit>