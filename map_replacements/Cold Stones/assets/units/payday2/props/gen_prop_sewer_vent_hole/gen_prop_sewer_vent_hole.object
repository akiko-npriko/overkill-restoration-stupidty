<dynamic_object>
    <diesel materials="units/payday2/props/gen_prop_sewer_vent_hole/gen_prop_sewer_vent_hole" orientation_object="rp_gen_prop_sewer_vent_hole" />
	<sequence_manager file="units/payday2/props/gen_prop_sewer_vent_hole/gen_prop_sewer_vent_hole"/>
	
	<animations>
		<animation_group name="door" enabled="false">
			<object name="a_door"/>
		</animation_group>
	</animations>
	
    <bodies>
        <body enabled="true" template="animated" name="door_collision" >
            <object collision_type="mesh_mopp" name="c_door" />
        </body>  
        <body enabled="true" template="static" name="shaft_collision" >
            <object collision_type="mesh_mopp" name="c_shaft" />
        </body>        
		<body enabled="true" template="animated" name="padlock_l" >
            <object collision_type="box" name="c_hitbox_lock_l" padding="-2.5" />
        </body>        
		<body enabled="true" template="animated" name="padlock_r" >
            <object collision_type="box" name="c_hitbox_lock_r" padding="-2.5" />
        </body>
    </bodies>
	
    <decal_surfaces>
        <decal_mesh enabled="true" name="dm_concrete" material="concrete" />
        <decal_mesh enabled="true" name="dm_metal" 	  material="metal" />
    </decal_surfaces>
	
    <graphics>
		<graphic_group name="icon" 	enabled="true" culling_object="g_icon">
			<lod_object name="icon_1_lod">
					<object name="g_icon_1" 		enabled="true"  max_distance="450"  max_draw_lod="0" />
					<object name="g_icon_1_lod1" 	enabled="true"  lod="1" />
			</lod_object>
		</graphic_group>
		<graphic_group name="icon_2" 	enabled="true" culling_object="g_icon">
			<lod_object name="icon_2_lod">
					<object name="g_icon_2" 		enabled="true"  max_distance="450"  max_draw_lod="0" />
					<object name="g_icon_2_lod1" 	enabled="true"  lod="1" />
			</lod_object>
		</graphic_group>
        <object enabled="true" name="g_shaft" />
        <object enabled="true" name="s_door" shadow_caster="true" />
        <object enabled="true" name="g_door" />
        <object enabled="true" name="g_padlock_2" />
        <object enabled="true" name="g_padlock_1" />
    </graphics>
	
</dynamic_object>
