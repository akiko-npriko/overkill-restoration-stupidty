<dynamic_object>
    <diesel orientation_object="rp_mex_ext_gas_building" materials="units/pd2_dlc_mex/architecture/mex_ext_gas_station/mex_ext_gas_building" />
    <sequence_manager file="units/pd2_dlc_mex/architecture/mex_ext_gas_station/mex_ext_gas_building" />

    <animations>
    	<animation_group name="front_door_state" enabled="false">
    		<object name="a_door" />
    	</animation_group>
    </animations>

    <bodies>
        <body enabled="true" template="animated" name="front_door" >
			<object name="a_door" />
			<object name="c_mesh_mopp_door" collision_type="mesh_mopp" />
        </body>

        <body enabled="true" template="window" name="static_window_01" >
			<object name="e_window_01" />
			<object name="c_box_window_01" collision_type="box" padding="-2.5"/>			
        </body>
        <body enabled="true" template="window" name="static_window_02" >
			<object name="e_window_02" />
			<object name="c_box_window_02" collision_type="box" padding="-2.5"/>			
        </body>
        <body enabled="true" template="window" name="static_window_03" >
			<object name="e_window_03" />
			<object name="c_box_window_03" collision_type="box" padding="-2.5"/>			
        </body>
        <body enabled="true" template="window_animated" name="static_window_04" >
			<object name="e_window_04" />
			<object name="c_box_window_04" collision_type="box" padding="-2.5"/>			
        </body>
        <body enabled="true" template="window_animated" name="static_window_05" >
			<object name="e_window_05" />
			<object name="c_box_window_05" collision_type="box" padding="-2.5"/>			
        </body>
		
        <body enabled="true" template="static" name="static_body" >
			<object name="rp_mex_ext_gas_building" />
			<object name="c_mesh_mopp_01" collision_type="mesh_mopp" />
			<object name="c_mesh_mopp_02" collision_type="mesh_mopp" />
        </body>
    </bodies>
	
	<decal_surfaces>
		<decal_mesh name="dm_glass_01" enabled="true" material="glass_breakable"/>
		<decal_mesh name="dm_glass_02" enabled="true" material="glass_breakable"/>
		<decal_mesh name="dm_glass_03" enabled="true" material="glass_breakable"/>
		<decal_mesh name="dm_glass_04" enabled="true" material="glass_breakable"/>
		<decal_mesh name="dm_glass_05" enabled="true" material="glass_breakable"/>
		
		<decal_mesh name="dm_concrete" enabled="true" material="concrete"/>
		<decal_mesh name="dm_tile" enabled="true" material="tile"/>
	</decal_surfaces>

    <graphics>
		<lod_object name="lod_text_decals">
			<object name="g_decals" enabled="true" >
				<material materials="mat_ext_decals" max_distance="2000" />
				<material materials="mat_ext_decals_lod" />
			</object>
		</lod_object>
		<lod_object name="lod_int_extra">
			<object name="g_int_extra_lod0" enabled="true" max_distance="1800" />
			<object name="g_int_extra_lod1" enabled="true" />
		</lod_object>
		<lod_object name="lod_front_door">
			<object name="g_door_lod0" enabled="true" max_distance="1000" />
			<object name="g_door_lod1" enabled="true" />
		</lod_object>
		<lod_object name="lod_exterior">
			<object name="g_vtxc" 	enabled="true" >
				<material materials="mat_ext_wall" 			max_distance="3000" />
				<material materials="mat_ext_wall_lod_1" 	max_distance="5000" />
				<material materials="mat_ext_wall_lod_2" />				
			</object>
		</lod_object>
		<object name="s_s" 		enabled="true" shadow_caster="true"/>
		
		<!-- Windows -->
		<object name="g_window_01" enabled="true"/>
		<object name="g_window_01_dmg" enabled="false"/>
		

		<lod_object>
			<object enabled="true" 	name="g_window_02" >
				<material materials="mat_int_extra,mat_glass_breakable" max_distance="500"/>
				<material materials="mat_int_extra_lod,mat_glass_breakable"/>
			</object>
		</lod_object>
		<lod_object>
			<object enabled="false" name="g_window_02_dmg"  >
				<material materials="mat_int_extra,mat_glass_dmg" max_distance="500"/>
				<material materials="mat_int_extra_lod,mat_glass_dmg"/>
			</object>
		</lod_object>
		
		<lod_object>
			<object enabled="true" 	name="g_window_03" >
				<material materials="mat_int_extra,mat_glass_breakable" max_distance="500"/>
				<material materials="mat_int_extra_lod,mat_glass_breakable"/>
			</object>
		</lod_object>
		<lod_object>
			<object enabled="false" name="g_window_03_dmg"  >
				<material materials="mat_int_extra,mat_glass_dmg" max_distance="500"/>
				<material materials="mat_int_extra_lod,mat_glass_dmg"/>
			</object>
		</lod_object>
		
		<object name="g_window_05" enabled="true"/>
		<object name="g_window_04_dmg" enabled="false"/>
		
		<object name="g_window_04" enabled="true"/>
		<object name="g_window_05_dmg" enabled="false"/>
    </graphics>
</dynamic_object>
