<dynamic_object>
    <diesel orientation_object="rp_diamond_pickup_single_01" materials="units/world/props/diamondheist_diamond_pickups/diamond_pickup_io" />
	<sequence_manager file="units/world/props/diamondheist_diamond_pickups/diamond_pickup_single_01" />
    <bodies>
        <body enabled="true" template="static" name="body0" >
            <object name="rp_diamond_pickup_single_01"/>
            <object enabled="true" name="c_diamond_pickup" collision_type="mesh_mopp"/>
        </body>
    </bodies>
	
	<decal_surfaces default_material="glass_unbreakable" static="true"/>
	
    <graphics>
	<graphic_group name="pickup" enabled="true" culling_object="g_diamond_pickup">
		<lod_object name="lod_pickup">
			<object max_draw_lod="0" name="g_diamond_pickup" enabled="true" max_distance="200"/>
			<object lod="1" name="g_diamond_pickup_lod1" enabled="true"/>
		</lod_object>
	</graphic_group>
	<graphic_group name="glow" enabled="true" culling_object="g_diamond_pickup_glow">
		<lod_object name="lod_glow">
			<object max_draw_lod="0" name="g_diamond_pickup_glow" enabled="false" max_distance="500"/>
			<object lod="1" name="g_diamond_pickup_glow_lod1" enabled="false"/>
		</lod_object>
	</graphic_group>
	<graphic_group name="shimmer" enabled="true" culling_object="g_diamond_shimmer">
		<lod_object name="lod_shimmer">
			<object max_draw_lod="0" name="g_diamond_shimmer" enabled="true" max_distance="350"/>
			<object lod="1" name="g_diamond_shimmer_lod1" enabled="true"/>
		</lod_object>
	</graphic_group>
	<graphic_group name="inside" enabled="true" culling_object="g_diamond_inside">
		<lod_object name="lod_inside">
			<object max_draw_lod="0" name="g_diamond_inside" enabled="true" max_distance="300"/>
			<object lod="1" name="g_diamond_inside_lod1" enabled="true"/>
		</lod_object>
	</graphic_group>
        <!-- <object enabled="true" name="g_diamond_pickup" /> -->
		<!-- <object enabled="true" name="g_diamond_inside" /> -->
		<!-- <object enabled="true" name="g_diamond_shimmer" /> -->
		<object enabled="true" name="g_caustics"/> 
       <!-- <object enabled="false" name="g_diamond_pickup_glow" /> -->
    </graphics>
</dynamic_object>
