<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/world/architecture/suburbia/suburbia" orientation_object="rp_suburbia_sewer_gate" />
	<sequence_manager file="units/world/architecture/suburbia/suburbia_cellar_gate" />

	<animations>
		<animation_group name="door" enabled="false">
			<object name="a_door" />
		</animation_group>
	</animations>

	<bodies>
		<body name="frame_bullet" enabled="true" template="raycoll_static">
			<object name="rp_suburbia_sewer_gate"/>
			<object name="c_box_bullet_006" collision_type="box" padding="-2"/>
			<object name="c_box_bullet_007" collision_type="box" padding="-2"/>
			<object name="c_box_bullet_008" collision_type="box" padding="-2"/>
			<object name="c_box_bullet_009" collision_type="box" padding="-2"/>
			<object name="c_box_bullet_010" collision_type="box" padding="-2"/>
			<object name="c_box_bullet_011" collision_type="box" padding="-2"/>
			<object name="c_box_bullet_012" collision_type="box" padding="-2"/>
			<object name="c_box_bullet_013" collision_type="box" padding="-2"/>
			<object name="c_box_bullet_014" collision_type="box" padding="-2"/>
			<object name="c_box_bullet_015" collision_type="box" padding="-2"/>
			<object name="c_box_bullet_016" collision_type="box" padding="-2"/>
			<object name="c_box_bullet_017" collision_type="box" padding="-2"/>
		</body>
		<body name="frame_mover" enabled="true" template="nav_walk_collision">
			<object name="rp_suburbia_sewer_gate"/>
			<object name="c_box_player_001" collision_type="box" padding="-2"/>
			<object name="c_box_player_002" collision_type="box" padding="-2"/>
			<object name="c_box_player_003" collision_type="box" padding="-2"/>
			<object name="c_box_player_004" collision_type="box" padding="-2"/>
			<object name="c_box_player_005" collision_type="box" padding="-2"/>
			<object name="c_box_player_006" collision_type="box" padding="-2"/>
		</body>
		<body name="door_bullet" enabled="true" template="raycoll">
			<object name="a_door"/>
			<object name="c_box_bullet_000" collision_type="box" padding="-2"/>
			<object name="c_box_bullet_001" collision_type="box" padding="-2"/>
			<object name="c_box_bullet_002" collision_type="box" padding="-2"/>
			<object name="c_box_bullet_003" collision_type="box" padding="-2"/>
			<object name="c_box_bullet_004" collision_type="box" padding="-2"/>
			<object name="c_box_bullet_005" collision_type="box" padding="-2"/>
		</body>
		<body name="door_mover" enabled="true" template="animated_no_ray">
			<object name="a_door"/>
			<object name="c_box_player_000" collision_type="box" padding="-2"/>
		</body>
	</bodies>

	<decal_surfaces default_material="metal_catwalk">
		<decal_mesh name="dm_frame_stone"  enabled="true" material="stone"/>
		<decal_mesh name="dm_frame_metal" enabled="true" material="metal_catwalk"/>
		<decal_mesh name="dm_door_metal"  enabled="true" material="metal_catwalk"/>
	</decal_surfaces>

	<graphics>
		<object name="g_gate" enabled="true" />		
		<object name="g_door" enabled="true" />	
		<graphic_group name="sawicongroup" 					enabled="false" culling_object="g_icon_saw">
			<lod_object name="saw_icon">
					<object name="g_icon_saw" 		enabled="true"  max_distance="450"  max_draw_lod="0" />
					<object name="g_icon_saw_lod1" 	enabled="true"  lod="1" />
			</lod_object>
			<lod_object name="crowbar_icon">
					<object name="g_icon_crowbar_lod0" 		enabled="true"  max_distance="450"  max_draw_lod="0" />
					<object name="g_icon_crowbar_lod1" 	enabled="true"  lod="1" />
			</lod_object>
		</graphic_group>
	</graphics>
	
	<objects>
		<align_point name="e_spark" enabled="true" parent="rp_suburbia_sewer_gate" position="0 0 0" rotation="0 0 0" />
	</objects>
</dynamic_object> 