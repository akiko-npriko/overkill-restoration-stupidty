    <bodies>
        <body template="static" name="static_body_destroyed" enabled="false">
			<object name="rp_gov_c_int_wall_explosion" />
			<object name="g_destroyed" 		collision_type="mesh_mopp" />
			<object name="g_destroyed_vtxc" 	collision_type="mesh_mopp" />
        </body>
        <body template="static" name="static_body_whole" enabled="true">
			<object name="g_whole" 			collision_type="mesh_mopp" />
        </body>

		<body enabled="true" template="animated" name="wrecked_bus" >
            <object collision_type="mesh_mopp" name="c_bus" />
        </body>
        <body name="body_ramp" enabled="true" template="nav_walk" keyframed="true">
        	<object collision_type="convex" name="c_convex_ramp" />
        </body>
        <body name="body_blocker" enabled="true" template="mover_blocker">
        	<object name="a_anim_secondary" />
        	<object name="c_bus" collision_type="box" padding="-2.5"/>
        </body>
    </bodies>
	
	<decal_surfaces>
		<decal_mesh name="g_destroyed" 		enabled="true" material="concrete"/>
		<decal_mesh name="g_destroyed_vtxc" enabled="true" material="plaster"/>
		<decal_mesh name="g_whole" 			enabled="true" material="plaster"/>
		<decal_mesh enabled="true" name="dm_bus" material="sheet_metal" />
	</decal_surfaces>
	
    <graphics>
		<object name="g_destroyed" 			enabled="false" />
		<object name="g_destroyed_vtxc" 	enabled="false" />
		<object name="g_whole" 				enabled="true"  />
			
		
		<graphic_group name="destroy" enabled="false">
			<object enabled="true" name="g_bus" />
			<object enabled="true" name="g_door_1" />
			<object enabled="true" name="g_door_2" />
        	<object enabled="true" name="g_glass_shattered" />
        	<object enabled="true" shadow_caster="true" name="s_bus" />
		</graphic_group>
		<graphic_group name="grp_debris" enabled="false" culling_object="co_cull_debris">
			<object 	name="g_debris" enabled="true"/>
        </graphic_group>
    </graphics>

</dynamic_object>
