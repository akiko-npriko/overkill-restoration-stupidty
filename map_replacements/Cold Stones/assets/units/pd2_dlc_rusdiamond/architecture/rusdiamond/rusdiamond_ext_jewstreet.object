<?xml version="1.0" ?>
<dynamic_object>
	<diesel materials="units/payday2/architecture/hcm/hcm_jewstreet" orientation_object="rp_hcm_ext_jewstreet" />
    <bodies>
        <body name="static_body" template="static" enabled="true" >
            <object name="rp_hcm_ext_jewstreet"/>
			<object name="g_hcm_ext_jewstreet" collision_type="mesh_mopp" padding="-2.5"/>
        </body>
    </bodies>
	
	<decal_surfaces default_material="concrete" static="true">
        <decal_mesh name="dm_marble" material="marble" enabled="true"/>
        <decal_mesh name="dm_metal" material="metal" enabled="true"/>
        <decal_mesh name="dm_glass_unbreakable" material="glass_unbreakable" enabled="true"/>
		<decal_mesh name="dm_stone" material="stone" enabled="true"/>
	</decal_surfaces> 
	
    <graphics>
        <object enabled="true" name="g_hcm_ext_jewstreet" shadow_caster="true"/>
    </graphics>
</dynamic_object> 