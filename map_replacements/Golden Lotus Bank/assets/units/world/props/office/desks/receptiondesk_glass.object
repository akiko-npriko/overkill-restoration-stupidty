<?xml version="1.0"?>
<dynamic_object>
  <diesel materials="units/world/props/office/railing/office_railing" orientation_object="rp_receptiondesk_glass" />
  <sequence_manager file="units/world/props/office/desks/receptiondesk_glass" />
  <bodies>
    <body remove_ray_type="walk vis_graph ai_vision" name="receptiondesk_glass" enabled="true" template="raycoll_static">
	  <object name="rp_receptiondesk_glass"/>
      <object name="c_glass" collision_type="box" padding="-2"/>
    </body>
  </bodies>
	<decal_surfaces default_material="glass_breakable" static="true">
		<decal_mesh material="glass_breakable" name="c_glass"/>
	</decal_surfaces>
  <graphics>
    <object name="g_glass" enabled="true" instance_struct="world_tm" />
  </graphics>
  <objects>
    <align_point name="e_glass" enabled="true" parent="rp_receptiondesk_glass" position="0 0 0" rotation="0 0 0" />
  </objects>
</dynamic_object> 