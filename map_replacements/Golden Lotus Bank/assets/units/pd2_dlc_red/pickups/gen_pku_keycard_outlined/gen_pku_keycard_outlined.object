<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/pd2_dlc_red/pickups/gen_pku_keycard_outlined/gen_pku_keycard_outlined" orientation_object="rp_key_card" />
	<sequence_manager file="units/pd2_dlc_red/pickups/gen_pku_keycard_outlined/gen_pku_keycard_outlined" />
	<bodies>
		<body name="body_editor" enabled="true" template="editor">
			<object name="g_key_card_lod1" collision_type="box" />
		</body>
	</bodies>
	<graphics>
		<graphic_group name="grp_card" enabled="true" >
			<lod_object name="lod_keycard">
				<object name="g_key_card_lod0" enabled="true"  max_distance="1000" />
				<object name="g_key_card_lod1" enabled="true" />
			</lod_object>
		</graphic_group>
	</graphics>
</dynamic_object> 
