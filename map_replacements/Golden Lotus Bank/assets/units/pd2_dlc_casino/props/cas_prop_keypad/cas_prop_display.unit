<unit type="cas" slot="1">
    <object file="units/pd2_dlc_casino/props/cas_prop_keypad/cas_prop_display" />
    <network sync="spawn"/>
    <dependencies>
    	<depends_on font="fonts/font_digital" />
    </dependencies>
    <extensions>
        <extension class="ScriptUnitData" name="unit_data" />
        <extension name="damage" class="UnitDamage" />
        <extension class="DigitalGui" name="digital_gui" >
			<var name="_gui_object" value="g_display_red" />
			<var name="TYPE" value="number" />
		</extension>
    </extensions>
</unit>
