<unit type="cas" slot="1">
    <object file="units/pd2_dlc_casino/props/cas_prop_keypad/cas_prop_button" />
    <network sync="spawn"/>
    <dependencies>
    	<depends_on material_config="units/pd2_dlc_casino/props/cas_prop_keypad/cas_prop_button_no_contour" />
    </dependencies>
    <extensions>
        <extension class="ScriptUnitData" name="unit_data" />
        <extension name="damage" class="UnitDamage" />
        <extension name="interaction" class="UseInteractionExt">
        	<var name="tweak_data" value="cas_button_01" />
        	<var name="drop_in_sync_tweak_data" value="true" /> 
        </extension>
    </extensions>
</unit>
