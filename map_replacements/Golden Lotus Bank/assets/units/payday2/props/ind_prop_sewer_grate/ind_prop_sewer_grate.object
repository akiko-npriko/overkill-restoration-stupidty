<dynamic_object>
	<diesel orientation_object="rp_ind_prop_sewer_grate" materials="units/payday2/props/ind_prop_sewer_grate/ind_prop_sewer_grate" />
	<sequence_manager file="units/payday2/props/ind_prop_sewer_grate/ind_prop_sewer_grate" />
	<animations>
		<animation_group name="sound_anim" enabled="false">
			<object name="sound" />
		</animation_group>
	</animations>
	<bodies>
		<body enabled="true" template="static" name="grate" >
			<object collision_type="mesh_mopp" name="c_grate" />
		</body>
		<body enabled="false" template="static" name="grate_hole" >
			<object collision_type="mesh_mopp" name="c_grate_hole" />
		</body>
	</bodies>
	
	<graphics>
		<object name="g_grate"			enabled="true"		shadow_caster="false"/>
		<object name="g_grate_hole"		enabled="false"		shadow_caster="false"/>
		<object name="g_grate_hole_il"	enabled="false"		shadow_caster="false"/>
		<object name="g_thermite"		enabled="false"		shadow_caster="false"/>
		<object name="s_grate"			enabled="true"		shadow_caster="true"/>
		<object name="s_grate_hole"		enabled="false"		shadow_caster="true"/>
		<graphic_group name="icon" 	enabled="false" culling_object="g_icon">
			<lod_object name="icon_lod">
					<object name="g_icon" 		enabled="true"  max_distance="450"  max_draw_lod="0" />
					<object name="g_icon_lod1" 	enabled="true"  lod="1" />
			</lod_object>
		</graphic_group>
	</graphics>
	
</dynamic_object>
