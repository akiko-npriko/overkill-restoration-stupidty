<dynamic_object>
    <diesel orientation_object="rp_ind_vehicle_boat_tug" materials="units/payday2/vehicles/ind_vehicle_boat_tug/ind_vehicle_boat_tug" />
	<sequence_manager file="units/payday2/vehicles/ind_vehicle_boat_tug/ind_vehicle_boat_tug" />
    <animations>
        <animation_group name="anim_grp0" >
            <object enabled="true" name="a_a" />
        </animation_group>
    </animations>
    <bodies>
        <body enabled="true" template="animated" name="anim_body" >
            <object name="a_a" />		
            <object collision_type="mesh_mopp" name="c_mesh_mopp" />
        </body>
    </bodies>
    <graphics>
		<lod_object name="tugboat">
			<object name="g_g" max_distance="5000" lod="0" enabled="true" />
			<object name="g_lod1" max_distance="12500" lod="1" enabled="true" />
			<object name="g_lod2" lod="2" enabled="true" />
		</lod_object> 
        <object enabled="true" shadow_caster="true" name="s_s" />
    </graphics>
</dynamic_object>
