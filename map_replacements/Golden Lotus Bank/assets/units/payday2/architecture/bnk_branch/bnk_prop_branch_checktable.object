<?xml version="1.0" ?>
<dynamic_object>
	<diesel materials="units/payday2/architecture/bnk_branch/bnk_branch" orientation_object="rp_bnk_prop_branch_checktable" />
	<bodies>
        <body name="static_body" template="static" enabled="true" >
            <object name="rp_bnk_prop_branch_checktable"/>
			<object name="c_convex_01" collision_type="convex" padding="-2.5"/>
			<object name="c_convex_02" collision_type="convex" padding="-2.5"/>
			<object name="c_box_01" collision_type="box" padding="-2.5"/>
			<object name="c_box_02" collision_type="box" padding="-2.5"/>
        </body>
    </bodies>
	
	<decal_surfaces default_material="wood">	
		<decal_mesh name="dm_wood" enabled="true" material="wood"/>
	</decal_surfaces>

    <graphics>
		<object name="g_table" enabled="true"/>
    </graphics>
	
</dynamic_object> 