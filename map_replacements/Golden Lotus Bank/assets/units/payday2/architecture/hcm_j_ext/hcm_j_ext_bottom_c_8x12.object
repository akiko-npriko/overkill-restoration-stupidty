<dynamic_object>
    <diesel orientation_object="rp_hcm_j_ext_bottom_c_8x12" materials="units/payday2/architecture/hcm_j_ext/hcm_j_ext" />
    <bodies>
        <body enabled="true" template="static" name="static_body" >
			<object name="rp_hcm_j_ext_bottom_c_8x12" />
			<object name="c_mesh" collision_type="mesh_mopp" />
        </body>
    </bodies>
    <decal_surfaces default_material="stone" >
		<decal_mesh name="dm_glass_breakable" enabled="true" material="glass_breakable"/>
		<decal_mesh name="dm_metal" enabled="true" material="metal"/>
		<decal_mesh name="dm_stone" enabled="true" material="stone"/>
    </decal_surfaces>
    <graphics>
		<object name="g_g_frame" 	enabled="true"/>
		<object name="g_g" 			enabled="true"/>
		<object name="g_glass" 		enabled="true"/>
		<object name="g_interior" 	enabled="false"/>
		<object name="s_s" 			enabled="true" shadow_caster="true"/>
		<object name="s_frame" 		enabled="true" shadow_caster="true"/>
    </graphics>
</dynamic_object>
