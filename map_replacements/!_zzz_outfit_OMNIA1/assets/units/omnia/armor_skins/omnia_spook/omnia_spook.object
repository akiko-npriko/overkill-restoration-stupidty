<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/omnia/armor_skins/omnia_spook/omnia_spook" orientation_object="root_point" />

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="g_body">
			<object name="g_body" enabled="true"/>
			<object name="g_il" enabled="true"/>
			<object name="g_nvg" enabled="true"/>

		</graphic_group>
	</graphics>

	<lights>
		<light name="point_light" enabled="false" multiplier="reddot" far_range="25" near_range="1" falloff="4.0" type="omni|specular" />
	</lights>

</dynamic_object>