<dynamic_object>
    <diesel orientation_object="rp_wpn_fps_lmg_m249_body_standard" materials="units/mods/weapons/wpn_fps_lmg_lsat_pts/wpn_fps_lmg_lsat_body"/>
       
	<animations>
		<animation_group name="reload">
		  <object name="a_reload" enabled="true"/>
		  <object name="a_carry_reload" enabled="true"/>
		</animation_group>
		
		<animation_group name="reload_not_empty">
		  <object name="a_reload_not_empty" enabled="true"/>
		  <object name="a_carry_reload_not_empty" enabled="true"/>
		</animation_group>		
	</animations>
	
	<graphics>
		<graphic_group name="character" enabled="true" culling_object="g_body_lod0">
			<object enabled="true" inherit_bounding_volume="co_culling" name="g_body_lod0" />
		</graphic_group>
        <object enabled="true" name="g_bolt_lod0"/>
        <object enabled="false" name="g_carryhandle_lod0"/>
    </graphics>
</dynamic_object>