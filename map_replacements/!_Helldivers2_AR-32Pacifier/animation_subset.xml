<?xml version="1.0"?>
<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_subset">
		<search>
			<xml/>
		</search>

		<!--
			Replace all instances of 'reprimand' below with the ID of your animation.
			Note that recoil_steelsight does not have a unique animation in this reprimand; you can edit the filepath in the 'file' section with one if you wish.
			If your gun cannot be fired in full auto, you can delete the recoil_enter, recoil_loop, and recoil_exit lines.
		-->

		<target mode="attach">
			<anim name="ar32_reload" 				file="anims/fps/ar32/ar32_reload" blend_set="all"/>
			<anim name="ar32_reload_not_empty" 		file="anims/fps/ar32/ar32_reload_not_empty" blend_set="all"/>

			<anim name="ar32_recoil" 							file="anims/fps/ar32/ar32_recoil" blend_set="all"/>
			<anim name="ar32_idle" 								file="anims/fps/ar32/ar32_idle" blend_set="all"/>
			<anim name="ar32_recoil_enter" 						file="anims/fps/ar32/ar32_recoil_enter" blend_set="all"/>
			<anim name="ar32_recoil_loop" 						file="anims/fps/ar32/ar32_recoil_loop" blend_set="all"/>
			<anim name="ar32_recoil_exit" 						file="anims/fps/ar32/ar32_recoil_exit" blend_set="all"/>
			<anim name="ar32_recoil_steelsight" 				file="anims/fps/ar32/ar32_recoil" blend_set="all"/>
			<anim name="ar32_equip" 							file="anims/fps/ar32/ar32_equip" blend_set="all"/>
			<anim name="ar32_unequip" 							file="anims/fps/ar32/ar32_unequip" blend_set="all"/>
			<anim name="ar32_melee" 							file="anims/fps/ar32/ar32_melee" blend_set="all"/>
			<anim name="ar32_melee_miss" 						file="anims/fps/ar32/ar32_melee_miss" blend_set="all"/>
			<anim name="ar32_use" 								file="anims/fps/ar32/ar32_use" blend_set="all"/>
			<anim name="ar32_sprint_enter" 						file="anims/fps/ar32/ar32_sprint_enter" blend_set="all"/>
			<anim name="ar32_sprint" 							file="anims/fps/ar32/ar32_sprint" blend_set="all"/>
			<anim name="ar32_sprint_exit" 						file="anims/fps/ar32/ar32_sprint_exit" blend_set="all"/>
			<anim name="ar32_com_down_var1" 					file="anims/fps/ar32/ar32_com_var1" blend_set="all"/>
			<anim name="ar32_com_stop" 							file="anims/fps/ar32/ar32_com_var5" blend_set="all"/>
			<anim name="ar32_com_come" 							file="anims/fps/ar32/ar32_com_var6" blend_set="all"/>
			<anim name="ar32_com_point" 						file="anims/fps/ar32/ar32_com_var7" blend_set="all"/>
			<anim name="ar32_get_up" 							file="anims/fps/ar32/ar32_get_up" blend_set="all"/>
			<anim name="ar32_gogo" 								file="anims/fps/ar32/ar32_gogo" blend_set="all"/>
			<anim name="ar32_tased" 							file="anims/fps/ar32/ar32_tased" blend_set="all"/>
			<anim name="ar32_tased_boost" 						file="anims/fps/ar32/ar32_tased_boost" blend_set="all"/>
			<anim name="ar32_tased_exit" 						file="anims/fps/ar32/ar32_tased_exit" blend_set="all"/>
			<anim name="ar32_inspect" 							file="anims/fps/ar32/ar32_inspect" blend_set="all"/> 
		</target>
	</tweak>
</tweaks>