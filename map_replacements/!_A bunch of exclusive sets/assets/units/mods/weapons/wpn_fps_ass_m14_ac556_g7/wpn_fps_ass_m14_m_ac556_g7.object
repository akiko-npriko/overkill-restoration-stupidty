<dynamic_object>
    <diesel materials="units/mods/weapons/wpn_fps_ass_m14_ac556_g7/wpn_fps_ass_m14_m_ac556_g7" orientation_object="rp_wpn_fps_ass_m14_m_standard"/>
	<animations>  
		<animation_group name="reload" enabled="false" >
			<object name="mag_align_reload" enabled="true" />
			<object name="spare_mag_align_reload" enabled="true" />
		</animation_group>  
		<animation_group name="reload_not_empty" enabled="false" >
			<object name="mag_align_reload_tactical" enabled="true" />
			<object name="spare_mag_align_reload_tactical" enabled="true" />
		</animation_group>
    </animations>
	<graphics>
        <object enabled="true" name="g_speedpull" />
        <object enabled="true" name="g_mag" />
        <object enabled="true" name="g_bullet_1" />
        <object enabled="true" name="g_bullet_2" />
        <object enabled="true" name="g_bullet_3" />
		<object name="g_spare_speedpull" enabled="true" />
		<object name="g_spare_mag" enabled="true" />
		<object name="g_spare_bullets" enabled="true" />
    </graphics>
</dynamic_object>
