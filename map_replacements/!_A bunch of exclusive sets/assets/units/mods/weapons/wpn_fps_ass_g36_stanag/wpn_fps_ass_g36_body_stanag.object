<dynamic_object>
    <diesel  materials="units/mods/weapons/wpn_fps_ass_g36_stanag/wpn_fps_ass_g36_body_stanag"  orientation_object="rp_wpn_fps_ass_g36_body_standard"/>
	<animations>
		<animation_group name="reload">
			<object name="anim_bolt_reload" enabled="true" />
			<object name="anim_handle_reload" enabled="true" />
		</animation_group>
		<animation_group name="recoil">
			<object name="anim_recoil" enabled="true" />
		</animation_group>
	</animations>
    <graphics>
        <object 	name="g_release" 		enabled="true" />
        <object 	name="g_base" 		enabled="true" />
        <object  	name="g_bolt" 	enabled="true" />
        <object  	name="g_handle" 	enabled="true" />
        <object  	name="g_no_blurr" 	enabled="true" />
    </graphics>
</dynamic_object>
