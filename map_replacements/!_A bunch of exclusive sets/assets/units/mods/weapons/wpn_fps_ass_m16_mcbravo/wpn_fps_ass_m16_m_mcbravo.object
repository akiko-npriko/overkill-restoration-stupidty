<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_ass_m16_mcbravo/wpn_fps_ass_m16_m_mcbravo" orientation_object="rp_wpn_fps_ass_m4_m_strike_small" />
	<animations>
		<animation_group name="reload">
			<object name="mag_align" enabled="true" />
	</animation_group>  
	
	<animation_group name="reload_not_empty">
			<object name="mag_align_2" enabled="true" />
    </animation_group>
  </animations>
  
	<graphics>
		<object name="g_mag" enabled="true" />
		<object name="g_plate" enabled="true" />
		<object name="g_bullet_1" enabled="true" />
		<object name="g_bullet_2" enabled="true" />
	</graphics>
</dynamic_object>
