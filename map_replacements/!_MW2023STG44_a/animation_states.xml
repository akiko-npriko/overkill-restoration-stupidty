				</keys>
				<exit name="fps/idle"/>
			</state>
			
			
			<state name="fps/reload_not_empty/stango44_drum" type="once" segment="base" speed="1.0">
				<anim name="stango44_drum_reload_not_empty"/>
				<keys>
					<key at="enter" callback="anim_clbk_stop_weapon_magazine_empty" class_name="base" param1="reload"/>			
					
			<key at="trigger" trigger="wp_m16_clip_slide_in" callback="play_sound" class_name="base" param1="stango44_drum_in"/>
			<key at="trigger" trigger="wp_m16_clip_grab" callback="play_sound" class_name="base" param1="stango44_mag_release_press"/>
			<key at="trigger" trigger="wp_foley_generic_clip_throw" callback="play_sound" class_name="base" param1="stango44_drum_out"/>
			<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="stango44_mag_take_new"/>
			<key at="trigger" trigger="wp_foley_generic_clip_in_connect" callback="play_sound" class_name="base" param1="stango44_mag_contact"/>
			<key at="trigger" trigger="wp_foley_generic_back_in_hand" callback="play_sound" class_name="base" param1="stango44_back_in_hand"/>
			<key at="trigger" trigger="wp_clip_generic_ass_center" callback="play_sound" class_name="base" param1="stango44_generic_center"/>
			<key at="trigger" trigger="wp_ak47_tilt_back" callback="play_sound" class_name="base" param1="stango44_tilt_back"/>	
			
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>
	
