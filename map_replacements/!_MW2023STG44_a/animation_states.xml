<?xml version="1.0"?>



<tweaks>
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps"/>
		</search>
		<target mode="attach">
			<to name="reload_stango44" 						redirect="fps/reload/stango44"/>
			<to name="reload_not_empty_stango44" 			redirect="fps/reload_not_empty/stango44"/>
			<to name="reload_stango44_drum" 						redirect="fps/reload/stango44_drum"/>
			<to name="reload_not_empty_stango44_drum" 			redirect="fps/reload_not_empty/stango44_drum"/>
		</target>
	</tweak>
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">
			<state name="fps/reload/stango44" type="once" segment="base" speed="1.0">
				<anim name="stango44_reload"/>
				<keys>
					<key at="enter" callback="anim_clbk_stop_weapon_magazine_empty" class_name="base" param1="reload"/>		
					
			<key at="trigger" trigger="wp_m16_lever_release" callback="play_sound" class_name="base" param1="stango44_charging_handle_release"/>
			<key at="trigger" trigger="wp_m16_clip_slide_in" callback="play_sound" class_name="base" param1="stango44_mag_in"/>
			<key at="trigger" trigger="wp_m16_clip_in_contact" callback="play_sound" class_name="base" param1="stango44_mag_contact"/>
			<key at="trigger" trigger="wp_m16_clip_grab_throw" callback="play_sound" class_name="base" param1="stango44_mag_out"/>
			<key at="trigger" trigger="wp_m16_clip_take_new" callback="play_sound" class_name="base" param1="stango44_mag_take_new"/>
			<key at="trigger" trigger="wp_m16_clip_grab" callback="play_sound" class_name="base" param1="stango44_mag_release_press"/>
			<key at="trigger" trigger="wp_foley_generic_lever_grab" callback="play_sound" class_name="base" param1="stango44_charging_handle_pull"/>
			<key at="trigger" trigger="wp_foley_generic_back_in_hand" callback="play_sound" class_name="base" param1="stango44_back_in_hand"/>
			<key at="trigger" trigger="wp_ak47_tilt" callback="play_sound" class_name="base" param1="stango44_tilt"/>
			<key at="trigger" trigger="wp_ak47_tilt_back" callback="play_sound" class_name="base" param1="stango44_tilt_back"/>
			<key at="trigger" trigger="wp_clip_generic_ass_center" callback="play_sound" class_name="base" param1="stango44_generic_center"/>		
			
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle"/>
			</state>
			
			
			<state name="fps/reload_not_empty/stango44" type="once" segment="base" speed="1.0">
				<anim name="stango44_reload_not_empty"/>
				<keys>
					<key at="enter" callback="anim_clbk_stop_weapon_magazine_empty" class_name="base" param1="reload"/>		
					
			<key at="trigger" trigger="wp_m16_clip_slide_in" callback="play_sound" class_name="base" param1="stango44_mag_in"/>
			<key at="trigger" trigger="wp_m16_clip_grab" callback="play_sound" class_name="base" param1="stango44_mag_release_press"/>
			<key at="trigger" trigger="wp_foley_generic_clip_throw" callback="play_sound" class_name="base" param1="stango44_mag_out"/>
			<key at="trigger" trigger="wp_foley_generic_clip_take_new" callback="play_sound" class_name="base" param1="stango44_mag_take_new"/>
			<key at="trigger" trigger="wp_foley_generic_clip_in_connect" callback="play_sound" class_name="base" param1="stango44_mag_contact"/>
			<key at="trigger" trigger="wp_foley_generic_back_in_hand" callback="play_sound" class_name="base" param1="stango44_back_in_hand"/>
			<key at="trigger" trigger="wp_clip_generic_ass_center" callback="play_sound" class_name="base" param1="stango44_generic_center"/>
			<key at="trigger" trigger="wp_ak47_tilt_back" callback="play_sound" class_name="base" param1="stango44_tilt_back"/>	
			
					<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
				</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
	</tweak>
	
