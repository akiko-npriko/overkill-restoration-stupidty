<unit type="infb" slot="1">
	<object file="units/pd2_mod_infb/fancy_timer/fancy_timer" />
	<network sync="spawn"/>
	<dependencies>
			<depends_on font="fonts/font_digital" />
	</dependencies>	
	<extensions>
		<extension class="ScriptUnitData" name="unit_data" />
		<extension class="UnitDamage" name="damage" />		
		<extension class="DigitalGui" name="digital_gui" >
			<var name="_gui_object" value="g_display" />
			<var name="TIMER_PRECISION" value="2" />
			<var name="FONT_SIZE" value="170" />
			<var name="WIDTH" value="1000" />
			<var name="HEIGHT" value="300" />
			<var name="display_format" value="{seconds}" />
			<var name="COLOR_TYPE" value="white" />
		</extension>
	</extensions>
	<sounds>
	</sounds>
</unit>