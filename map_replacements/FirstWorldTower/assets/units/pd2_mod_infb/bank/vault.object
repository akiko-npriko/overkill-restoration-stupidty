<dynamic_object>
	<diesel materials="units/pd2_mod_infb/bank/vault" orientation_object="rp_vault" />
  <sequence_manager file="units/pd2_mod_infb/bank/vault" />
	<bodies>
		<body name="body_static" enabled="true" template="static">
			<object name="c_box_000" collision_type="box" padding="-2.5"/>
			<object name="c_box_001" collision_type="box" padding="-2.5"/>
			<object name="c_box_002" collision_type="box" padding="-2.5"/>
			<object name="c_box_003" collision_type="box" padding="-2.5"/>
			<object name="c_box_004" collision_type="box" padding="-2.5"/>
			<object name="c_box_005" collision_type="box" padding="-2.5"/>					
			<object name="c_box_006" collision_type="box" padding="-2.5"/>
			<object name="c_main_001" collision_type="box" padding="-2.5"/>
			<object name="c_main_002" collision_type="box" padding="-2.5"/>
			<object name="c_main_003" collision_type="box" padding="-2.5"/>
			<object name="c_main_004" collision_type="box" padding="-2.5"/>
			<object name="c_main_005" collision_type="box" padding="-2.5"/>
			<object name="c_main_006" collision_type="box" padding="-2.5"/>
			<object name="c_main_007" collision_type="box" padding="-2.5"/>
			<object name="c_main_008" collision_type="box" padding="-2.5"/>
			<object name="c_vault_entrance" collision_type="mesh_mopp"/>
			<object name="g_bathrooms" collision_type="mesh_mopp" />
			
			<object name="c_lootarea" collision_type="mesh_mopp"/>
			<object name="c_lootroom_001" collision_type="box" padding="-2.5"/>
			<object name="c_lootroom_002" collision_type="box" padding="-2.5"/>
			<object name="c_lootroom_003" collision_type="box" padding="-2.5"/>
			<object name="c_lootroom_004" collision_type="box" padding="-2.5"/>
			<object name="c_lootroom_005" collision_type="box" padding="-2.5"/>
			<object name="c_lootroom_006" collision_type="box" padding="-2.5"/>
			<object name="c_lootroom_007" collision_type="box" padding="-2.5"/>
			<object name="c_lootroom_008" collision_type="box" padding="-2.5"/>
			<object name="c_lootroom_009" collision_type="box" padding="-2.5"/>
			<object name="c_lootroom_010" collision_type="box" padding="-2.5"/>
			<object name="c_lootroom_011" collision_type="box" padding="-2.5"/>
			<object name="c_lootroom_012" collision_type="box" padding="-2.5"/>
		</body>
		<body name="body_mover" enabled="true" template="nav_walk">
			<object name="c_mover_ramp" collision_type="mesh_mopp"/>
		</body>
		<body name="body_vent_001" enabled="true" template="static">
			<object name="c_vent_001" collision_type="mesh_mopp" padding="-2.5"/>
		</body>
		<body name="body_vent_002" enabled="true" template="static">
			<object name="c_vent_002" collision_type="mesh_mopp" padding="-2.5"/>
		</body>
	</bodies>
	
	<decal_surfaces default_material="thin_layer">
		<decal_mesh name="dm_carpet" enabled="true" material="carpet"/>
		<decal_mesh name="dm_marble" enabled="true" material="marble"/>
		<decal_mesh name="dm_metal" enabled="true" material="metal"/>
		<decal_mesh name="g_vault" enabled="true" material="marble" />
		<decal_mesh name="g_lootarea" enabled="true" material="marble" />
		<decal_mesh name="g_bathrooms" enabled="true" material="stone" />
	</decal_surfaces>
	
	<graphics>
		<object name="g_clock"		enabled="true"/>
		<object name="g_gate"		enabled="true"/>
		<object name="g_g"			enabled="true"/>
		<object name="g_vtxc"		enabled="true"/>
		<object name="g_vault"		enabled="true" />
		<object name="g_lootarea"	enabled="true" />
		<object name="g_vent_001"	enabled="true" />
		<object name="g_bathrooms"	enabled="true" />
		<lod_object name="lod_winners">
			<object name="g_winners"		enabled="true"  max_distance="450"  max_draw_lod="0" />
			<object name="g_winners_lod" 	enabled="true"  lod="1" />
		</lod_object>
	</graphics>
	
</dynamic_object>
