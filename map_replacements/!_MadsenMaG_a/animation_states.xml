<?xml version="1.0"?>
<tweaks>
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		
	
		<target mode="append">
			<state name="fps/reload/madsen_mg" type="once" segment="base" speed="1.0">
				<anim name="madsen_mg_reload"/>
					<keys>			
						<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />

						<key at="trigger" trigger="wp_madsen_mg_enter_foley" callback="play_sound" class_name="base" 			param1="madsen_mg_enter_foley"/>
						<key at="trigger" trigger="wp_madsen_mg_magout" callback="play_sound" class_name="base" 				param1="madsen_mg_mag_out_empty"/>
						<key at="trigger" trigger="wp_madsen_mg_mag_hit_ground" callback="play_sound" class_name="base" 		param1="madsen_mg_mag_impact_ground"/>
						<key at="trigger" trigger="wp_madsen_mg_regrab" callback="play_sound" class_name="base" 				param1="madsen_mg_regrab"/>
						<key at="trigger" trigger="wp_madsen_mg_mag_new" callback="play_sound" class_name="base" 				param1="madsen_mg_mag_take_new"/>
						<key at="trigger" trigger="wp_madsen_mg_mag_contact" callback="play_sound" class_name="base" 			param1="madsen_mg_mag_contact"/>
						<key at="trigger" trigger="wp_madsen_mg_magin" callback="play_sound" class_name="base" 					param1="madsen_mg_mag_in"/>
						<key at="trigger" trigger="wp_madsen_mg_regrab_left" callback="play_sound" class_name="base" 			param1="madsen_mg_regrab_left"/>
						<key at="trigger" trigger="wp_madsen_mg_grab_lever" callback="play_sound" class_name="base" 			param1="madsen_mg_lever_grab"/>
						<key at="trigger" trigger="wp_madsen_mg_lever_pull" callback="play_sound" class_name="base" 			param1="madsen_mg_lever_pull"/>
						<key at="trigger" trigger="wp_madsen_mg_lever_push" callback="play_sound" class_name="base" 			param1="madsen_mg_lever_push"/>
						<key at="trigger" trigger="wp_madsen_mg_regrab_last" callback="play_sound" class_name="base" 			param1="madsen_mg_regrab_last"/>
						<key at="trigger" trigger="wp_madsen_mg_foley_end" callback="play_sound" class_name="base" 				param1="madsen_mg_end_foley"/>
					</keys>
				<exit name="fps/idle"/>
			</state>

			<state name="fps/reload_not_empty/madsen_mg" type="once" segment="base" speed="1.0">
				<anim name="madsen_mg_reload_not_empty"/>
					<keys>			
						<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />

						<key at="trigger" trigger="wp_madsen_mg_enter_foley" callback="play_sound" class_name="base" 			param1="madsen_mg_enter_foley"/>
						<key at="trigger" trigger="wp_madsen_mg_magout" callback="play_sound" class_name="base" 				param1="madsen_mg_mag_out"/>
						<key at="trigger" trigger="wp_madsen_mg_mag_hit_ground" callback="play_sound" class_name="base" 		param1="madsen_mg_mag_impact_ground"/>
						<key at="trigger" trigger="wp_madsen_mg_regrab" callback="play_sound" class_name="base" 				param1="madsen_mg_regrab"/>
						<key at="trigger" trigger="wp_madsen_mg_mag_new" callback="play_sound" class_name="base" 				param1="madsen_mg_mag_take_new"/>
						<key at="trigger" trigger="wp_madsen_mg_mag_contact" callback="play_sound" class_name="base" 			param1="madsen_mg_mag_contact"/>
						<key at="trigger" trigger="wp_madsen_mg_magin" callback="play_sound" class_name="base" 					param1="madsen_mg_mag_in"/>
						<key at="trigger" trigger="wp_madsen_mg_regrab_left" callback="play_sound" class_name="base" 			param1="madsen_mg_regrab_left"/>
						<key at="trigger" trigger="wp_madsen_mg_grab_lever" callback="play_sound" class_name="base" 			param1="madsen_mg_lever_grab"/>
						<key at="trigger" trigger="wp_madsen_mg_lever_pull" callback="play_sound" class_name="base" 			param1="madsen_mg_lever_pull"/>
						<key at="trigger" trigger="wp_madsen_mg_lever_push" callback="play_sound" class_name="base" 			param1="madsen_mg_lever_push"/>
						<key at="trigger" trigger="wp_madsen_mg_regrab_last" callback="play_sound" class_name="base" 			param1="madsen_mg_regrab_last"/>
						<key at="trigger" trigger="wp_madsen_mg_foley_end" callback="play_sound" class_name="base" 				param1="madsen_mg_end_foley"/>
					</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
		
		
	</tweak>
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps"/>
		</search>
		<target mode="attach">
			
			<to name="reload_madsen_mg" 						redirect="fps/reload/madsen_mg"/>
			<to name="reload_not_empty_madsen_mg" 				redirect="fps/reload_not_empty/madsen_mg"/>
			
		</target>
	</tweak>
	
