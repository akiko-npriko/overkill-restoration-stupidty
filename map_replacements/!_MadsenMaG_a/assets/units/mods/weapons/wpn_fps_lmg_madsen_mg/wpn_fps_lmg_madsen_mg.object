<dynamic_object>
	<diesel orientation_object="rp_wpn_fps_sho_boot" />
		
	<animations>
		<animation_group name="recoil">
			<object name="anim_recoil_barrel" enabled="true" />
		</animation_group>
		<animation_group name="reload">
			<object name="anim_reload_magazine" enabled="true" />
		</animation_group>
		<animation_group name="reload_not_empty">
			<object name="anim_reload_not_empty_magazine" enabled="true" />
		</animation_group>
    </animations>
	
</dynamic_object>
