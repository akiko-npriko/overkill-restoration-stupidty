<?xml version="1.0"?>
<tweaks>

	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		<target mode="append">
			<state name="fps/reload/mx63" type="once" segment="base" speed="1.0">
				<anim name="mx63_reload"/>
				<keys>
					<key at="enter" callback="anim_clbk_stop_weapon_magazine_empty" class_name="base" param1="reload"/>
					<key at="trigger" trigger="wp_m249_box_in" callback="play_sound" class_name="base" param1="wp_m249_box_in"/>
					<key at="trigger" trigger="wp_m249_box_take_new" callback="play_sound" class_name="base" param1="wp_m249_box_take_new"/>
					<key at="trigger" trigger="wp_m249_box_out" callback="play_sound" class_name="base" param1="wp_m249_box_out"/>
					<key at="trigger" trigger="wp_m249_tilt" callback="play_sound" class_name="base" param1="wp_m249_tilt"/>
					<key at="trigger" trigger="wp_m249_lever_release" callback="play_sound" class_name="base" param1="wp_m249_lever_release"/>
					<key at="trigger" trigger="wp_m249_clip_hit_ground" callback="play_sound" class_name="base" param1="wp_m249_clip_hit_ground"/>
					<key at="trigger" trigger="wp_m249_box_in_contact" callback="play_sound" class_name="base" param1="wp_m249_box_in_contact"/>
