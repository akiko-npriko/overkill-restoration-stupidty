<dynamic_object>
	<diesel materials="units/mods/weapons/wpn_fps_snp_sbeta_pts/wpn_fps_snp_sbeta_receiver" orientation_object="rp_receiver" />
		<animations>
		<animation_group name="reload_exit">
			<object name="a_reload_hammer_exit" enabled="true"/>
			<object name="a_reload_bolt_exit" enabled="true"/>
			<object name="a_reload_lever_exit" enabled="true"/>
		</animation_group>
		<animation_group name="recoil">
			<object name="a_recoil_hammer" enabled="true"/>
			<object name="a_recoil_bolt" enabled="true"/>
			<object name="a_recoil_lever" enabled="true"/>
		</animation_group>
	</animations>
	<graphics>
		<object name="g_sbeta_receiver" enabled="true" />
		<object name="g_sbeta_irons_rear" enabled="true" />
		<object name="g_sbeta_rails_long" enabled="true" />
		<object name="g_sbeta_trigger" enabled="true" />
		<object name="g_sbeta_hammer" enabled="true" />
		<object name="g_sbeta_bolt" enabled="true" />
	</graphics>
</dynamic_object>
