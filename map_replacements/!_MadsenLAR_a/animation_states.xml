<?xml version="1.0"?>
<tweaks>
	<!--
		I've put this tweak first because it is the most important.
		This section defines what should happen when particular animation triggers are reached in your reload animations. Generally, this is used for sounds.
		Unlike the other files, simply replacing 'madsen_lar' with your animation ID will likely not work for you, since different animations use different triggers.
	-->
	
	<tweak version="2" name="anims/fps/fps_spawn" extension="animation_states">
		<search>
			<xml/>
			<state name="fps/reload"/>
		</search>
		
		
		<target mode="append">
			<state name="fps/reload/madsen_lar" type="once" segment="base" speed="1.0">
				<anim name="madsen_lar_reload"/>
					<keys>					
						<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
						
						<key at="trigger" trigger="wp_madsen_lar_mag_grab" callback="play_sound" class_name="base" param1="madsen_lar_mag_grab"/>
						<key at="trigger" trigger="wp_madsen_lar_magout" callback="play_sound" class_name="base" param1="madsen_lar_mag_out"/>
						<key at="trigger" trigger="wp_madsen_lar_mag_hit_ground" callback="play_sound" class_name="base" param1="madsen_lar_mag_impact_ground"/>
						<key at="trigger" trigger="wp_madsen_lar_new_mag" callback="play_sound" class_name="base" param1="madsen_lar_mag_take_new"/>
						<key at="trigger" trigger="wp_madsen_lar_mag_contact" callback="play_sound" class_name="base" param1="madsen_lar_mag_contact"/>
						<key at="trigger" trigger="wp_madsen_lar_magin" callback="play_sound" class_name="base" param1="madsen_lar_mag_in"/>
						<key at="trigger" trigger="wp_madsen_lar_bolt_pull" callback="play_sound" class_name="base" param1="madsen_lar_charging_handle_pull"/>
						<key at="trigger" trigger="wp_madsen_lar_bolt_release" callback="play_sound" class_name="base" param1="madsen_lar_charging_handle_release"/>
						<key at="trigger" trigger="wp_madsen_lar_foley_last" callback="play_sound" class_name="base" param1="madsen_lar_foley_last"/>

					</keys>
				<exit name="fps/idle"/>
			</state>

			<state name="fps/reload_not_empty/madsen_lar" type="once" segment="base" speed="1.0">
				<anim name="madsen_lar_reload_not_empty"/>
					<keys>		
						<key at="trigger" trigger="bullet_show" callback="anim_clbk_check_bullet_object" class_name="base" />
						
						<key at="trigger" trigger="wp_madsen_lar_mag_grab" callback="play_sound" class_name="base" param1="madsen_lar_mag_grab"/>
						<key at="trigger" trigger="wp_madsen_lar_magout" callback="play_sound" class_name="base" param1="madsen_lar_mag_out"/>
						<key at="trigger" trigger="wp_madsen_lar_mag_hit_ground" callback="play_sound" class_name="base" param1="madsen_lar_mag_impact_ground"/>
						<key at="trigger" trigger="wp_madsen_lar_new_mag" callback="play_sound" class_name="base" param1="madsen_lar_mag_take_new"/>
						<key at="trigger" trigger="wp_madsen_lar_mag_contact" callback="play_sound" class_name="base" param1="madsen_lar_mag_contact"/>
						<key at="trigger" trigger="wp_madsen_lar_magin" callback="play_sound" class_name="base" param1="madsen_lar_mag_in"/>
						<key at="trigger" trigger="wp_madsen_lar_bolt_pull" callback="play_sound" class_name="base" param1="madsen_lar_charging_handle_pull"/>
						<key at="trigger" trigger="wp_madsen_lar_bolt_release" callback="play_sound" class_name="base" param1="madsen_lar_charging_handle_release"/>
						<key at="trigger" trigger="wp_madsen_lar_foley_last" callback="play_sound" class_name="base" param1="madsen_lar_foley_last"/>

					</keys>
				<exit name="fps/idle"/>
			</state>
		</target>
		
	</tweak>
	
