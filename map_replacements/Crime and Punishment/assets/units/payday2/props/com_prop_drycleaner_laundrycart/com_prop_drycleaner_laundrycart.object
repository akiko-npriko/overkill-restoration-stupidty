<dynamic_object>
    <diesel orientation_object="rp_laundrycart" materials="units/payday2/props/com_prop_drycleaner_laundrycart/com_prop_drycleaner_laundrycart" />
    <bodies>
        <body enabled="true" template="static" name="static_body" >
			<object name="c_box" collision_type="box" padding="-2.5"/>
        </body>
    </bodies>
    <decal_surfaces>
		<decal_mesh name="dm_cloth" enabled="true" material="cloth"/>
		<decal_mesh name="dm_metal" enabled="true" material="metal"/>
		<decal_mesh name="dm_rubber" enabled="true" material="rubber"/>
		<decal_mesh name="dm_wood" enabled="true" material="wood"/>
    </decal_surfaces>
    <graphics>
		<object name="g_g" enabled="true"/>
    </graphics>
</dynamic_object>
