<dynamic_object>
	<diesel materials="units/payday2/architecture/ind/ind_ext_level/ind_ext_level_locker" orientation_object="rp_bph_ext_level_table" />
	<bodies>
		<body name="body_static" enabled="true" template="static">
			<object name="rp_bph_ext_level_table" />
			<object name="c_box_01" collision_type="box" padding="-2.5" />
			<object name="c_box_02" collision_type="box" padding="-2.5" />
			<object name="c_box_03" collision_type="box" padding="-2.5" />
			<object name="c_capsule_01" collision_type="capsule" padding="-2.5" />
			<object name="c_capsule_02" collision_type="capsule" padding="-2.5" />
		</body>
	</bodies>
	<decal_surfaces default_material="wood">
		<decal_mesh name="dm_wood" enabled="true" material="wood" />
	</decal_surfaces>
	<graphics>
		<object name="g_g" enabled="true" />
		<object name="s_s" enabled="true" shadow_caster="true" />
	</graphics>
</dynamic_object>
