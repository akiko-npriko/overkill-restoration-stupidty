		<effect_spawner name="es_thermite_7" enabled="false" object="e_thermite_7" effect="effects/payday2/environment/small_thermal_burner_60s" />
		<effect_spawner name="es_thermite_8" enabled="false" object="e_thermite_8" effect="effects/payday2/environment/small_thermal_burner_60s" />
		<effect_spawner name="es_thermite_9" enabled="false" object="e_thermite_9" effect="effects/payday2/environment/small_thermal_burner_60s" />
