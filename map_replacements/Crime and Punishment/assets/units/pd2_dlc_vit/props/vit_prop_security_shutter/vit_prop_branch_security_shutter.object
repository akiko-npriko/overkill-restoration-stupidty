<dynamic_object>
	<diesel materials="units/pd2_dlc_vit/props/vit_prop_security_shutter/vit_prop_branch_security_shutter" orientation_object="rp_vit_prop_branch_security_shutter" />
	<sequence_manager file="units/pd2_dlc_vit/props/vit_prop_security_shutter/vit_prop_branch_security_shutter" />
	<animations>
		<animation_group name="shutter" enabled="false">
			<object name="a_shutter" />
		</animation_group>
		<animation_group name="debris" enabled="false">
			<object name="anim_debris" />
		</animation_group>
	</animations>
	
	<bodies>
		<body name="static_body" enabled="true" template="static">
			<object name="rp_vit_prop_branch_security_shutter" />
			<object name="c_box_unit" collision_type="box" padding="-2.5" />
		</body>
		<body name="shutter_body_1" enabled="true" template="animated">
			<object name="a_shutter" />
			<object name="c_box_shutter_01" collision_type="box" padding="-2.5" />
		</body>
		<body name="shutter_body_2" enabled="true" template="animated">
			<object name="a_shutter" />
			<object name="c_box_shutter_02" collision_type="box" padding="-2.5" />
		</body>

		<body name="body_debris" enabled="false" template="animated" collides_with_mover="false">
			<object name="anim_debris" />
			<object name="c_box_door" collision_type="box" padding="-2.5" />
		</body>
		<body name="body_hole" enabled="false" template="static">
			<object name="a_shutter" />
			<object name="c_mesh_mopp" collision_type="mesh_mopp" padding="-2.5" />
		</body>
	</bodies>
	<decal_surfaces default_material="metal">
		<decal_mesh name="dm_metal_shutter" enabled="true" material="metal" />
		<decal_mesh name="dm_metal_shutter_hole" enabled="false" material="metal" />
		<decal_mesh name="dm_metal_debris" enabled="false" material="metal" />
		<decal_mesh name="dm_metal_unit" enabled="true" material="metal" />
	</decal_surfaces>
	<effects>
		<effect_spawner name="es_light" enabled="false" object="e_light" effect="effects/payday2/environment/parts/flashing_light_60s" />
		<effect_spawner name="es_thermite_1" enabled="false" object="e_thermite_1" effect="effects/payday2/environment/small_thermal_burner_60s" />
		<effect_spawner name="es_thermite_2" enabled="false" object="e_thermite_2" effect="effects/payday2/environment/small_thermal_burner_60s" />
		<effect_spawner name="es_thermite_3" enabled="false" object="e_thermite_3" effect="effects/payday2/environment/small_thermal_burner_60s" />
