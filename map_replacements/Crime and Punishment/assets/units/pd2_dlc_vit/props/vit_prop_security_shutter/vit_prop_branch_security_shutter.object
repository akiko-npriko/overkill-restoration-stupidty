	<graphics>
		<object name="g_unit" enabled="true" />

		<object name="g_thermite" 			enabled="false" />
		<object name="g_shutter_hole" 		enabled="false" />
		<object name="g_debris" 			enabled="false" />
		<object name="g_glow_01" 			enabled="false" />
		<object name="g_debris_glow" 		enabled="false" />
		<object name="g_sot" 				enabled="false" />
		<object name="g_debris_sot" 		enabled="false" />
