<dynamic_object>
    <diesel orientation_object="rp_lockpick_interactable" materials="units/pd2_dlc_des/props/des_interactable_thermite/des_interactable_thermite" />
	<sequence_manager file="units/pd2_dlc_des/props/des_interactable_thermite/des_interactable_thermite" />
    <bodies>
        <body enabled="true" template="editor"  collides_with_mover="false" name="static_body">
            <object name="rp_lockpick_interactable" />
            <object name="c_box" collision_type="box" />
        </body>
    </bodies>
    <decal_surfaces />
    <effects>
        <effect_spawner name="thermite" enabled="false" object="interact" effect="effects/payday2/particles/fire/thermite_long_30sec_burn" />
    </effects>
    <graphics>
        <object name="g_thermite" enabled="false" />
        <lod_object name="lockpick_icon">
			<object name="g_icon"   enabled="true"  max_distance="450"  max_draw_lod="0" />
			<object name="g_icon_lod01"  enabled="true"  lod="1" />
		</lod_object> 
    </graphics>
</dynamic_object>



