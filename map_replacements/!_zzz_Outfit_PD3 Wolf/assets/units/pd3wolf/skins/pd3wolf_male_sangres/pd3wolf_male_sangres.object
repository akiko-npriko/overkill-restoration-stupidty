	<bodies>
		<!-- Collision Bodies -->
		<body name="Hips_Col" enabled="true" template="dynamic" collision_class="hair" collision_group="7" collides_with="5" collides_with_mover="false" friction="0.15" keyframed="true" collision_script_quiet_time="0.5" collision_script_tag="small" ray="ignore" lin_damping="0" ang_damping="1" restitution="0">
