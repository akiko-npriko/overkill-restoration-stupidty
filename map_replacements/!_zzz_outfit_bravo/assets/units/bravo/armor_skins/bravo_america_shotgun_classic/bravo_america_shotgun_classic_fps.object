<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/bravo/armor_skins/bravo_america_shotgun_classic/bravo_america_shotgun_classic_fps" orientation_object="root_point" />
	

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="co_culling">
			<object name="g_body" enabled="true"/>
			<object name="g_arms" enabled="true"/>
			
		</graphic_group>
	</graphics>

	<lights>
		<light multiplier="identity" far_range="400" name="ls_light" enabled="false" type="spot|specular" />
	</lights>

</dynamic_object>