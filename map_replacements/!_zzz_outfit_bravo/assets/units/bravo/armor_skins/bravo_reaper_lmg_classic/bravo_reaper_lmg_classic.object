<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/bravo/armor_skins/bravo_reaper_lmg_classic/bravo_reaper_lmg_classic" orientation_object="root_point" />

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="g_body">
			<object name="g_body" enabled="true"/>
			<object name="g_head" enabled="true"/>
			<object name="g_helmet_lod1" enabled="true"/>

		</graphic_group>
	</graphics>

	<lights>
		<light multiplier="identity" far_range="400" name="ls_light" enabled="false" type="spot|specular" />
	</lights>

</dynamic_object>