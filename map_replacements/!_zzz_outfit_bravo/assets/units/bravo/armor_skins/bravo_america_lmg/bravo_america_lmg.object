<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/bravo/armor_skins/bravo_america_lmg/bravo_america_lmg" orientation_object="root_point" />

	<graphics>
		<graphic_group name="character" enabled="true" culling_object="co_culling">
			<object name="g_body_lmg" enabled="true"/>
			<object name="g_swat_lmg" enabled="true"/>
			<object name="g_helmet_lod1" enabled="true"/>

		<!--Balaclavas; Only one should be used at a time-->
			<object name="g_balaclava_a" enabled="false"/> <!--Brown balaclava-->
			<object name="g_balaclava_b" enabled="true"/> <!--Black balaclava-->

		<!--Heads; Only one should be used at a time and they should not be used alongside a balaclava-->
			<object name="g_head_a" enabled="false"/>
			<object name="g_head_b" enabled="false"/>
			<object name="g_head_c" enabled="false"/>
			<object name="g_head_d" enabled="false"/>
			<object name="g_head_e" enabled="false"/>
			<object name="g_head_f" enabled="false"/>
			<object name="g_head_g" enabled="false"/>
			<object name="g_head_recon" enabled="false"/>

		<!--Faces; Only one should be used at a time and they should only be used alongside a balaclava-->
			<object name="g_face_a" enabled="false"/>
			<object name="g_face_b" enabled="false"/>
			<object name="g_face_c" enabled="true"/>
			<object name="g_face_d" enabled="false"/>
			<object name="g_face_e" enabled="false"/>

		<!--Arms; Only one should be used at a time and they should only be used alongside the corresponding head or face-->
		<!--If changed, the first-person model should also be changed-->
			<object name="g_arms_a" enabled="false"/> <!--Use alongside g_head_a, g_head_recon, or g_face_a-->
			<object name="g_arms_b" enabled="false"/> <!--Use alongside g_head_b or g_face_b-->
			<object name="g_arms_c" enabled="true"/> <!--Use alongside g_head_c or g_face_c-->
			<object name="g_arms_d" enabled="false"/> <!--Use alongside g_head_d or g_face_d-->
			<object name="g_arms_e" enabled="false"/> <!--Use alongside g_head_e or g_face_e-->
			<object name="g_arms_f" enabled="false"/> <!--Use alongside g_head_f-->
			<object name="g_arms_g" enabled="false"/> <!--Use alongside g_head_g-->

		<!--Goggles; Frame and glass should be used together-->
			<object name="g_goggles_a" enabled="false"/> <!--Frame-->
			<object name="g_glass" enabled="false"/> <!--Glass-->

		<!--Headset-->
			<object name="g_headset" enabled="true"/>

		<!--Lifted-up goggles-->
			<object name="g_helmet_lod3" enabled="true"/>
		</graphic_group>
	</graphics>

</dynamic_object>